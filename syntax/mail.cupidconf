# Syntax: mail
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='mail'

# Detection: filename first, then header and content signature.
detect.filename='(.*/mutt-.*|\.eml)$'
detect.header='^From .* \d+:\d+:\d+ \d+'

# Pattern 0: type (root).
rule.0.parent=-1
rule.0.group='type'
rule.0.match='^From .*'

# Pattern 1: identifier (root).
rule.1.parent=-1
rule.1.group='identifier'
rule.1.match='^[^[:space:]]+:'

# Pattern 2: preproc (root).
rule.2.parent=-1
rule.2.group='preproc'
rule.2.match='^List-(Id|Archive|Subscribe|Unsubscribe|Post|Help):'

# Pattern 3: constant (root).
rule.3.parent=-1
rule.3.group='constant'
rule.3.match='^(To|From):'

# Region 4: constant.string (root).
rule.4.parent=-1
rule.4.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.4.start='^Subject:.*'
rule.4.end='$'

# Pattern 5: constant.specialChar (inside region 4).
rule.5.parent=4
rule.5.group='constant.specialChar'
rule.5.match='\\.'

# Pattern 6: statement (root).
rule.6.parent=-1
rule.6.group='statement'
rule.6.match='<?[^@[:space:]]+@[^[:space:]]+>?'

# Region 7: default (root).
rule.7.parent=-1
rule.7.group='default'
# Start/end delimiters carry state between physical lines.
rule.7.start='^\n\n'
rule.7.end='.*'

# Region 8: comment (root).
rule.8.parent=-1
rule.8.group='comment'
# Start/end delimiters carry state between physical lines.
rule.8.start='^>.*'
rule.8.end='$'

# Total flattened rules; update this when adding or removing rules.
rules=9
