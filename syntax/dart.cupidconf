# Syntax: dart
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='dart'

# Detection: filename first, then header and content signature.
detect.filename='\.dart$'

# Pattern 0: constant.number (root).
rule.0.parent=-1
rule.0.group='constant.number'
rule.0.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 1: constant.number (root).
rule.1.parent=-1
rule.1.group='constant.number'
rule.1.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 2: constant.number (root).
rule.2.parent=-1
rule.2.group='constant.number'
rule.2.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 3: identifier (root).
rule.3.parent=-1
rule.3.group='identifier'
rule.3.match='[A-Za-z_][A-Za-z0-9_]*[[:space:]]*[(]'

# Pattern 4: statement (root).
rule.4.parent=-1
rule.4.group='statement'
rule.4.match='\b(break|case|catch|continue|default|else|finally)\b'

# Pattern 5: statement (root).
rule.5.parent=-1
rule.5.group='statement'
rule.5.match='\b(for|function|get|if|in|as|is|new|return|set|switch|final|await|async|sync)\b'

# Pattern 6: statement (root).
rule.6.parent=-1
rule.6.group='statement'
rule.6.match='\b(switch|this|throw|try|var|void|while|with|import|library|part|const|export)\b'

# Pattern 7: constant (root).
rule.7.parent=-1
rule.7.group='constant'
rule.7.match='\b(true|false|null)\b'

# Pattern 8: type (root).
rule.8.parent=-1
rule.8.group='type'
rule.8.match='\b(List|String)\b'

# Pattern 9: type (root).
rule.9.parent=-1
rule.9.group='type'
rule.9.match='\b(int|num|double|bool)\b'

# Pattern 10: statement (root).
rule.10.parent=-1
rule.10.group='statement'
rule.10.match='[-+/*=<>!~%?:&|]'

# Pattern 11: constant (root).
rule.11.parent=-1
rule.11.group='constant'
rule.11.match='/[^*]([^/]|(\\/))*[^\\]/[gim]*'

# Pattern 12: constant (root).
rule.12.parent=-1
rule.12.group='constant'
rule.12.match='\\[0-7][0-7]?[0-7]?|\\x[0-9a-fA-F]+|\\[bfnrt''"\?\\]'

# Region 13: comment (root).
rule.13.parent=-1
rule.13.group='comment'
# Start/end delimiters carry state between physical lines.
rule.13.start='//'
rule.13.end='$'

# Pattern 14: todo (inside region 13).
rule.14.parent=13
rule.14.group='todo'
rule.14.match='TODO:?'

# Region 15: comment (root).
rule.15.parent=-1
rule.15.group='comment'
# Start/end delimiters carry state between physical lines.
rule.15.start='/\*'
rule.15.end='\*/'

# Pattern 16: todo (inside region 15).
rule.16.parent=15
rule.16.group='todo'
rule.16.match='TODO:?'

# Region 17: constant.string (root).
rule.17.parent=-1
rule.17.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.17.start='"'
rule.17.end='"'
# Mask escaped text before matching delimiters.
rule.17.skip='\\.'

# Pattern 18: constant.specialChar (inside region 17).
rule.18.parent=17
rule.18.group='constant.specialChar'
rule.18.match='\\.'

# Region 19: constant.string (root).
rule.19.parent=-1
rule.19.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.19.start=''''
rule.19.end=''''
# Mask escaped text before matching delimiters.
rule.19.skip='\\.'

# Pattern 20: constant.specialChar (inside region 19).
rule.20.parent=19
rule.20.group='constant.specialChar'
rule.20.match='\\.'

# Total flattened rules; update this when adding or removing rules.
rules=21
