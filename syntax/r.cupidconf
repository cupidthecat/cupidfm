# Syntax: r
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='r'

# Detection: filename first, then header and content signature.
detect.filename='\.(r|R)$'

# Pattern 0: statement (root).
rule.0.parent=-1
rule.0.group='statement'
rule.0.match='\b(library|require|break|else|for|function|if|ifelse|in|next|names|switch|repeat|print|try|tryCatch|isTRUE|return|while)\b'

# Pattern 1: constant (root).
rule.1.parent=-1
rule.1.group='constant'
rule.1.match='\b(T|TRUE|F|FALSE|NULL|Inf|NaN|NA|NA_integer_|NA_real_|NA_complex_|NA_character_)\b'

# Pattern 2: constant.number (root).
rule.2.parent=-1
rule.2.group='constant.number'
rule.2.match='(\b[0-9]+\b|\b0x[0-9A-Fa-f]+\b)'

# Pattern 3: symbol.operator (root).
rule.3.parent=-1
rule.3.group='symbol.operator'
rule.3.match='([.:;,+*|=!\%]|<|>|/|-|&|\^|\$)'

# Region 4: comment (root).
rule.4.parent=-1
rule.4.group='comment'
# Start/end delimiters carry state between physical lines.
rule.4.start='#'
rule.4.end='$'

# Pattern 5: todo (inside region 4).
rule.5.parent=4
rule.5.group='todo'
rule.5.match='(TODO|XXX|FIXME):?'

# Region 6: constant.string (root).
rule.6.parent=-1
rule.6.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.6.start='"'
rule.6.end='"'
# Mask escaped text before matching delimiters.
rule.6.skip='\\.'

# Pattern 7: constant.specialChar (inside region 6).
rule.7.parent=6
rule.7.group='constant.specialChar'
rule.7.match='\\.'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start=''''
rule.8.end=''''
# Mask escaped text before matching delimiters.
rule.8.skip='\\.'

# Pattern 9: constant.specialChar (inside region 8).
rule.9.parent=8
rule.9.group='constant.specialChar'
rule.9.match='\\.'

# Total flattened rules; update this when adding or removing rules.
rules=10
