# Syntax: sed
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='sed'

# Detection: filename first, then header and content signature.
detect.filename='\.sed$'
detect.header='^#!.*bin/(env +)?sed( |$)'

# Pattern 0: symbol.operator (root).
rule.0.parent=-1
rule.0.group='symbol.operator'
rule.0.match='[|^$.*+]'

# Pattern 1: constant.number (root).
rule.1.parent=-1
rule.1.group='constant.number'
rule.1.match='\{[0-9]+,?[0-9]*\}'

# Pattern 2: constant.specialChar (root).
rule.2.parent=-1
rule.2.group='constant.specialChar'
rule.2.match='\\.'

# Pattern 3: comment (root).
rule.3.parent=-1
rule.3.group='comment'
rule.3.match='(^|[[:space:]])#([^{].*)?$'

# Pattern 4: indent-char.whitespace (root).
rule.4.parent=-1
rule.4.group='indent-char.whitespace'
rule.4.match='[[:space:]]+$'

# Pattern 5: indent-char (root).
rule.5.parent=-1
rule.5.group='indent-char'
rule.5.match='	+ +| +	+'

# Total flattened rules; update this when adding or removing rules.
rules=6
