# Syntax: ini
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='ini'

# Detection: filename first, then header and content signature.
detect.filename='\.(ini|desktop|lfl|override|tscn|tres)$|(mimeapps\.list|pinforc|setup\.cfg|project\.godot)$|weechat/.+\.conf$'

# Pattern 0: constant.bool.true (root).
rule.0.parent=-1
rule.0.group='constant.bool.true'
rule.0.match='\btrue\b'

# Pattern 1: constant.bool.false (root).
rule.1.parent=-1
rule.1.group='constant.bool.false'
rule.1.match='\bfalse\b'

# Pattern 2: identifier (root).
rule.2.parent=-1
rule.2.group='identifier'
rule.2.match='^[[:space:]]*[^=]*='

# Pattern 3: special (root).
rule.3.parent=-1
rule.3.group='special'
rule.3.match='^[[:space:]]*\[.*\]$'

# Pattern 4: statement (root).
rule.4.parent=-1
rule.4.group='statement'
rule.4.match='[=;]'

# Pattern 5: constant.string (root).
rule.5.parent=-1
rule.5.group='constant.string'
rule.5.match='"(\\.|[^"])*"|''(\\.|[^''])*'''

# Region 6: comment (root).
rule.6.parent=-1
rule.6.group='comment'
# Start/end delimiters carry state between physical lines.
rule.6.start='#'
rule.6.end='$'

# Pattern 7: todo (inside region 6).
rule.7.parent=6
rule.7.group='todo'
rule.7.match='(TODO|XXX|FIXME):?'

# Region 8: comment (root).
rule.8.parent=-1
rule.8.group='comment'
# Start/end delimiters carry state between physical lines.
rule.8.start=';'
rule.8.end='$'

# Pattern 9: todo (inside region 8).
rule.9.parent=8
rule.9.group='todo'
rule.9.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=10
