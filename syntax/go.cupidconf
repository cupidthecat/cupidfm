# Syntax: go
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='go'

# Detection: filename first, then header and content signature.
detect.filename='\.go$'

# Pattern 0: special (root).
rule.0.parent=-1
rule.0.group='special'
rule.0.match='\b(break|case|continue|default|go|goto|range|return|println|fallthrough)\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(else|for|if|switch|select)\b'

# Pattern 2: preproc (root).
rule.2.parent=-1
rule.2.group='preproc'
rule.2.match='\b(package|import|const|var|type|struct|func|defer|iota|make|new|copy|len|cap|panic|append|close|delete|print|recover)\b'

# Pattern 3: symbol.operator (root).
rule.3.parent=-1
rule.3.group='symbol.operator'
rule.3.match='[-+/*=<>!~%&|^]|:='

# Pattern 4: symbol (root).
rule.4.parent=-1
rule.4.group='symbol'
rule.4.match='(,|\.)'

# Pattern 5: type (root).
rule.5.parent=-1
rule.5.group='type'
rule.5.match='\b(u?int(8|16|32|64)?|float(32|64)|complex(64|128))\b'

# Pattern 6: type (root).
rule.6.parent=-1
rule.6.group='type'
rule.6.match='\b(uintptr|byte|rune|string|interface|bool|map|chan|error)\b'

# Pattern 7: type.keyword (root).
rule.7.parent=-1
rule.7.group='type.keyword'
rule.7.match='\b(struct)\b'

# Pattern 8: constant.bool (root).
rule.8.parent=-1
rule.8.group='constant.bool'
rule.8.match='\b(true|false|nil)\b'

# Pattern 9: symbol.brackets (root).
rule.9.parent=-1
rule.9.group='symbol.brackets'
rule.9.match='(\{|\})'

# Pattern 10: symbol.brackets (root).
rule.10.parent=-1
rule.10.group='symbol.brackets'
rule.10.match='(\(|\))'

# Pattern 11: symbol.brackets (root).
rule.11.parent=-1
rule.11.group='symbol.brackets'
rule.11.match='(\[|\])'

# Pattern 12: constant.number (root).
rule.12.parent=-1
rule.12.group='constant.number'
rule.12.match='\b([0-9]+|0x[0-9a-fA-F]*)\b|''.'''

# Region 13: constant.string (root).
rule.13.parent=-1
rule.13.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.13.start='"'
rule.13.end='"'
# Mask escaped text before matching delimiters.
rule.13.skip='\\.'

# Pattern 14: constant.specialChar (inside region 13).
rule.14.parent=13
rule.14.group='constant.specialChar'
rule.14.match='%.'

# Pattern 15: constant.specialChar (inside region 13).
rule.15.parent=13
rule.15.group='constant.specialChar'
rule.15.match='\\[abfnrtv''\"\\]'

# Pattern 16: constant.specialChar (inside region 13).
rule.16.parent=13
rule.16.group='constant.specialChar'
rule.16.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 17: constant.string (root).
rule.17.parent=-1
rule.17.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.17.start=''''
rule.17.end=''''
# Mask escaped text before matching delimiters.
rule.17.skip='\\.'

# Pattern 18: error (inside region 17).
rule.18.parent=17
rule.18.group='error'
rule.18.match='..+'

# Pattern 19: constant.specialChar (inside region 17).
rule.19.parent=17
rule.19.group='constant.specialChar'
rule.19.match='%.'

# Pattern 20: constant.specialChar (inside region 17).
rule.20.parent=17
rule.20.group='constant.specialChar'
rule.20.match='\\[abfnrtv''\"\\]'

# Pattern 21: constant.specialChar (inside region 17).
rule.21.parent=17
rule.21.group='constant.specialChar'
rule.21.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 22: constant.string (root).
rule.22.parent=-1
rule.22.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.22.start='`'
rule.22.end='`'

# Region 23: comment (root).
rule.23.parent=-1
rule.23.group='comment'
# Start/end delimiters carry state between physical lines.
rule.23.start='//'
rule.23.end='$'

# Pattern 24: todo (inside region 23).
rule.24.parent=23
rule.24.group='todo'
rule.24.match='(TODO|XXX|FIXME):?'

# Region 25: comment (root).
rule.25.parent=-1
rule.25.group='comment'
# Start/end delimiters carry state between physical lines.
rule.25.start='/\*'
rule.25.end='\*/'

# Pattern 26: todo (inside region 25).
rule.26.parent=25
rule.26.group='todo'
rule.26.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=27
