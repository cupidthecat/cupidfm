rule.44.parent=-1
rule.44.group='statement'
rule.44.match='\b(?i)(aesenc|aesenclast|aesdec|aesdeclast|aeskeygenassist|aesimc)(?-i)\b'

# Pattern 45: statement (root).
rule.45.parent=-1
