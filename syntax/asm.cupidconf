# Pattern 54: identifier (root).
rule.54.parent=-1
rule.54.group='identifier'
rule.54.match='\b(?i)(zmm0|zmm1|zmm2|zmm3|zmm4|zmm5|zmm6|zmm7|zmm8|zmm9|zmm10|zmm11|zmm12|zmm13|zmm14|zmm15|zmm16|zmm17|zmm18|zmm19|zmm20|zmm21|zmm22|zmm23|zmm24|zmm25|zmm26|zmm27|zmm28|zmm29|zmm30|zmm31)(?-i)\b'

# Pattern 55: constant.number (root).
rule.55.parent=-1
rule.55.group='constant.number'
rule.55.match='\b(|h|A|0x)+[0-9]+(|h|A)+\b'

# Pattern 56: constant.number (root).
rule.56.parent=-1
rule.56.group='constant.number'
rule.56.match='\b0x[0-9 a-f A-F]+\b'

# Pattern 57: preproc (root).
rule.57.parent=-1
rule.57.group='preproc'
rule.57.match='%+(\+|\?|\?\?|)[a-z A-Z 0-9]+'

# Pattern 58: preproc (root).
rule.58.parent=-1
rule.58.group='preproc'
rule.58.match='%\[[. a-z A-Z 0-9]*\]'

# Pattern 59: statement (root).
rule.59.parent=-1
rule.59.group='statement'
rule.59.match='\b(?i)(extern|global|section|segment|_start|\.text|\.data|\.bss)(?-i)\b'

# Pattern 60: statement (root).
rule.60.parent=-1
rule.60.group='statement'
rule.60.match='\b(?i)(db|dw|dd|dq|dt|ddq|do)(?-i)\b'

# Pattern 61: identifier (root).
rule.61.parent=-1
rule.61.group='identifier'
rule.61.match='[a-z A-Z 0-9 _]+:'

# Region 62: constant.string (root).
rule.62.parent=-1
rule.62.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.62.start='"'
rule.62.end='"'
# Mask escaped text before matching delimiters.
rule.62.skip='\\.'

# Pattern 63: constant.specialChar (inside region 62).
rule.63.parent=62
rule.63.group='constant.specialChar'
rule.63.match='\\.'

# Region 64: constant.string (root).
rule.64.parent=-1
rule.64.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.64.start=''''
rule.64.end=''''
# Mask escaped text before matching delimiters.
rule.64.skip='\\.'

# Pattern 65: constant.specialChar (inside region 64).
rule.65.parent=64
rule.65.group='constant.specialChar'
rule.65.match='\\.'

# Region 66: comment (root).
rule.66.parent=-1
rule.66.group='comment'
# Start/end delimiters carry state between physical lines.
rule.66.start=';'
rule.66.end='$'

# Pattern 67: todo (inside region 66).
rule.67.parent=66
rule.67.group='todo'
rule.67.match='(TODO|XXX|FIXME):?'

# Region 68: comment (root).
rule.68.parent=-1
rule.68.group='comment'
# Start/end delimiters carry state between physical lines.
rule.68.start='//'
rule.68.end='$'

# Pattern 69: todo (inside region 68).
rule.69.parent=68
rule.69.group='todo'
rule.69.match='(TODO|XXX|FIXME):?'

# Region 70: comment (root).
rule.70.parent=-1
rule.70.group='comment'
# Start/end delimiters carry state between physical lines.
rule.70.start='/\*'
rule.70.end='\*/'

# Pattern 71: todo (inside region 70).
rule.71.parent=70
rule.71.group='todo'
rule.71.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=72
