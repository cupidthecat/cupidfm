# Pattern 20: statement (root).
rule.20.parent=-1
rule.20.group='statement'
rule.20.match='\b(?i)(fcmovb|fcmovbe|fcmove|fcmove|fcmovnb|fcmovnbe|fcmovne|fcmovnu|fcmovu)(?-i)\b'

# Pattern 21: statement (root).
rule.21.parent=-1
rule.21.group='statement'
rule.21.match='\b(?i)(fcomi|fcomip|fucomi|fucomip)(?-i)\b'

# Pattern 22: statement (root).
rule.22.parent=-1
rule.22.group='statement'
rule.22.match='\b(?i)(fxrstor|fxsave)(?-i)\b'

# Pattern 23: statement (root).
rule.23.parent=-1
rule.23.group='statement'
rule.23.match='\b(?i)(fisttp)(?-i)\b'

# Pattern 24: statement (root).
rule.24.parent=-1
