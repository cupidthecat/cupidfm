# Syntax: haskell
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='haskell'

# Detection: filename first, then header and content signature.
detect.filename='\.hs$'

# Pattern 0: symbol.operator (root).
rule.0.parent=-1
rule.0.group='symbol.operator'
rule.0.match='[!#$%&:*+/<=>?@.\\^\|~\p{Sm}\-]+'

# Pattern 1: type (root).
rule.1.parent=-1
rule.1.group='type'
rule.1.match='\b([A-Z][A-Za-z0-9_]*\.)*[A-Z]+[A-Za-z0-9_'']*\b'

# Pattern 2: default (root).
rule.2.parent=-1
rule.2.group='default'
rule.2.match='\b([A-Z][A-Za-z0-9_]*\.)*[a-z][A-Za-z0-9_'']*\b'

# Pattern 3: statement (root).
rule.3.parent=-1
rule.3.group='statement'
rule.3.match=';'

# Pattern 4: symbol.bracket (root).
rule.4.parent=-1
rule.4.group='symbol.bracket'
rule.4.match='[\(\)\[\]\{\}]'

# Pattern 5: special (root).
rule.5.parent=-1
rule.5.group='special'
rule.5.match='`[A-Za-z0-9'']+`'

# Pattern 6: statement (root).
rule.6.parent=-1
rule.6.group='statement'
rule.6.match='\b(case|of|class|data|default|deriving|do|forall|foreign|hiding|if|then|else|import|infix|infixl|infixr|instance|let|in|mdo|module|newtype|qualified|type|where)\b'

# Pattern 7: constant.bool (root).
rule.7.parent=-1
rule.7.group='constant.bool'
rule.7.match='\b(True|False)\b'

# Pattern 8: constant (root).
rule.8.parent=-1
rule.8.group='constant'
rule.8.match='\b(Nothing|Just|Left|Right|LT|EQ|GT)\b'

# Pattern 9: constant (root).
rule.9.parent=-1
rule.9.group='constant'
rule.9.match='\(\)'

# Pattern 10: constant.number (root).
rule.10.parent=-1
rule.10.group='constant.number'
rule.10.match='\b(0[xX][0-9A-Fa-f]+|0[oO][0-7]+|0[bB][01]+|[-]?[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?)\b'

# Pattern 11: identifier.class (root).
rule.11.parent=-1
rule.11.group='identifier.class'
rule.11.match='\b(Additive|Applicative|Bounded|Data|Enum|Eq|Floating|Foldable|Fractional|Functor|Integral|Monad|MonadPlus|Monoid|Num|Ord|Read|Real|RealFloat|RealFrac|Semigroup|Show|Traversable|Typeable|Zip)[ ]'

# Region 12: constant.string (root).
rule.12.parent=-1
rule.12.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.12.start='"'
rule.12.end='"'
# Mask escaped text before matching delimiters.
rule.12.skip='\\.'

# Pattern 13: special (inside region 12).
rule.13.parent=12
rule.13.group='special'
rule.13.match='\\&'

# Pattern 14: constant.specialChar (inside region 12).
rule.14.parent=12
rule.14.group='constant.specialChar'
rule.14.match='\\([abfnrtv"''\\]|[0-9]+|x[0-9a-fA-F]+|o[0-7]+|NUL|SOH|STX|ETX|EOT|ENQ|ACK|BEL|BS|HT|LF|VT|FF|CR|SO|SI|DLE|DC[1-4]|NAK|SYN|ETB|CAN|EM|SUB|ESC|FS|GS|RS|US|SP|DEL)'

# Region 15: comment (root).
rule.15.parent=-1
rule.15.group='comment'
# Start/end delimiters carry state between physical lines.
rule.15.start='--'
rule.15.end='$'

# Pattern 16: todo (inside region 15).
rule.16.parent=15
rule.16.group='todo'
rule.16.match='(TODO|XXX|FIXME):?'

# Region 17: comment (root).
rule.17.parent=-1
rule.17.group='comment'
# Start/end delimiters carry state between physical lines.
rule.17.start='\{-'
rule.17.end='-\}'

# Pattern 18: todo (inside region 17).
rule.18.parent=17
rule.18.group='todo'
rule.18.match='(TODO|XXX|FIXME):?'

# Pattern 19: identifier.macro (root).
rule.19.parent=-1
rule.19.group='identifier.macro'
rule.19.match='undefined'

# Total flattened rules; update this when adding or removing rules.
rules=20
