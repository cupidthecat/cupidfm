# Syntax: log
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='log'

# Detection: filename first, then header and content signature.
detect.filename='(\.log|log\.txt)$'

# Pattern 0: diff-modified (root).
rule.0.parent=-1
rule.0.group='diff-modified'
rule.0.match='\b(WARN(ING)?|[Ww]arn(ing)?|w(r)?n|w|W/)\b'

# Pattern 1: diff-modified (root).
rule.1.parent=-1
rule.1.group='diff-modified'
rule.1.match='\b(CRITICAL|[Cc]ritical)\b'

# Pattern 2: constant (root).
rule.2.parent=-1
rule.2.group='constant'
rule.2.match='\b(INFO(RMATION)?|[Ii]nfo(rmation)?|[Ii]n(f)?|i|I/)\b'

# Pattern 3: constant (root).
rule.3.parent=-1
rule.3.group='constant'
rule.3.match='\b(DEBUG|[Dd]ebug|dbug|dbg|de|d|D/)\b'

# Pattern 4: constant (root).
rule.4.parent=-1
rule.4.group='constant'
rule.4.match='\b(VERBOSE|[Vv]erbose|V/)\b'

# Pattern 5: constant (root).
rule.5.parent=-1
rule.5.group='constant'
rule.5.match='\b(ALERT|[Aa]lert)\b'

# Pattern 6: preproc (root).
rule.6.parent=-1
rule.6.group='preproc'
rule.6.match='\b(TRACE|Trace|NOTICE|VERBOSE|verb|vrb|vb|v)\b'

# Pattern 7: gutter-error (root).
rule.7.parent=-1
rule.7.group='gutter-error'
rule.7.match='\b(ERROR|[Ee]rr(or)?|[Ee]r(or)?|e|E\x2F)\b'

# Pattern 8: gutter-error (root).
rule.8.parent=-1
rule.8.group='gutter-error'
rule.8.match='\b(FATAL|[Ff]atal)\b'

# Pattern 9: gutter-error (root).
rule.9.parent=-1
rule.9.group='gutter-error'
rule.9.match='\b(EMERGENCY|[Ee]mergency)\b'

# Pattern 10: gutter-error (root).
rule.10.parent=-1
rule.10.group='gutter-error'
rule.10.match='\b(FAIL(URE)?|[Ff]ail(ure)?)\b'

# Pattern 11: constant.bool.true (root).
rule.11.parent=-1
rule.11.group='constant.bool.true'
rule.11.match='\b(YES|yes|Y|y|ON|on|TRUE|True|true)\b'

# Pattern 12: constant.bool.false (root).
rule.12.parent=-1
rule.12.group='constant.bool.false'
rule.12.match='\b(NO|no|N|n|OFF|off|FALSE|False|false)\b'

# Pattern 13: constant.bool.false (root).
rule.13.parent=-1
rule.13.group='constant.bool.false'
rule.13.match='\b(None|null|nil)\b'

# Pattern 14: constant.number (root).
rule.14.parent=-1
rule.14.group='constant.number'
rule.14.match='\b[0-9](_?[0-9])*(\.([0-9](_?[0-9])*)?)?(e[0-9](_?[0-9])*)?\b'

# Pattern 15: constant.number (root).
rule.15.parent=-1
rule.15.group='constant.number'
rule.15.match='\b0b(_?[01])+\b'

# Pattern 16: constant.number (root).
rule.16.parent=-1
rule.16.group='constant.number'
rule.16.match='\b0o(_?[0-7])+\b'

# Pattern 17: constant.number (root).
rule.17.parent=-1
rule.17.group='constant.number'
rule.17.match='\b0x(_?[0-9a-f])+\b'

# Pattern 18: symbol.operator (root).
rule.18.parent=-1
rule.18.group='symbol.operator'
rule.18.match='([~^.:;,+*|=!\%]|<|>|/|-|&)'

# Pattern 19: symbol.brackets (root).
rule.19.parent=-1
rule.19.group='symbol.brackets'
rule.19.match='([(){}]|\[|\])'

# Region 20: constant.string (root).
rule.20.parent=-1
rule.20.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.20.start='"'
rule.20.end='("|$)'
# Mask escaped text before matching delimiters.
rule.20.skip='\\.'

# Pattern 21: constant.specialChar (inside region 20).
rule.21.parent=20
rule.21.group='constant.specialChar'
rule.21.match='\\.'

# Region 22: constant.string (root).
rule.22.parent=-1
rule.22.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.22.start=''''
rule.22.end='(''|$)'
# Mask escaped text before matching delimiters.
rule.22.skip='\\.'

# Pattern 23: constant.specialChar (inside region 22).
rule.23.parent=22
rule.23.group='constant.specialChar'
rule.23.match='\\.'

# Pattern 24: preproc (root).
rule.24.parent=-1
rule.24.group='preproc'
rule.24.match='\b(FILE|File|file)\b'

# Pattern 25: identifier (root).
rule.25.parent=-1
rule.25.group='identifier'
rule.25.match='\b((([Mm]on|[Tt]ues|[Ww]ed(nes)?|[Tt]hur(s)?|[Ff]ri|[Ss]at(ur)?|[Ss]un)(day)?\s)?([Jj]an(uary)?|[Ff]eb(ruary)?|[Mm]ar(ch)?|[Aa]pr(il)?|[Mm]ay|[Jj]un(e)?|[Jj]ul(y)?|[Aa]ug(ust)?|[Aa]go|[Ss]ep(tember)?|[Oo]ct(ober)?|[Nn]ov(ember)?|[Dd]ec(ember)?)\s\d{1,2},?(\s\d{4})?)\b'

# Pattern 26: identifier (root).
rule.26.parent=-1
rule.26.group='identifier'
rule.26.match='\b(\d{2,4}[-/\.]?\d{2,3}[-/\.]?\d{2,4})\b'

# Pattern 27: identifier (root).
rule.27.parent=-1
rule.27.group='identifier'
rule.27.match='\b(\d{2}:\d{2}(:\d{2})?([\.,]?\d{1,8}[\.\+,]?\d{1,8}?)?([\.\+,]?\d{1,8}[\.\+,]?\d{1,8}?)?([\.\+,]?\d{1,8}?)?(\s-\d{0,4})?)\b'

# Pattern 28: identifier (root).
rule.28.parent=-1
rule.28.group='identifier'
rule.28.match='^([0-2][0-9][0-2][0-9][-/]?[0-9][0-9][-/]?[0-9][0-9])'

# Pattern 29: identifier (root).
rule.29.parent=-1
rule.29.group='identifier'
rule.29.match='^(\d{4}[-/]?\d{2}[-/]?\d{2}\s\d{2}:\d{2}(:\d{2})?(\.?\d{2,8})?)'

# Pattern 30: identifier (root).
rule.30.parent=-1
rule.30.group='identifier'
rule.30.match='^([0-2][0-9]|[0-2]-?[0-9][0-9]-?[0-9][0-9])\-([0-1][0-9])\-([0-3][0-9]) ([0-2][0-9])\:([0-5][0-9])\:([0-5][0-9]),([0-9][0-9][0-9])'

# Pattern 31: identifier (root).
rule.31.parent=-1
rule.31.group='identifier'
rule.31.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+([+-][0-2]\d:[0-5]\d|Z))'

# Pattern 32: identifier (root).
rule.32.parent=-1
rule.32.group='identifier'
rule.32.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))'

# Pattern 33: identifier (root).
rule.33.parent=-1
rule.33.group='identifier'
rule.33.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))'

# Pattern 34: identifier (root).
rule.34.parent=-1
rule.34.group='identifier'
rule.34.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+([+-][0-2]\d:[0-5]\d|Z))|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))'

# Pattern 35: identifier (root).
rule.35.parent=-1
rule.35.group='identifier'
rule.35.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+)'

# Pattern 36: identifier (root).
rule.36.parent=-1
rule.36.group='identifier'
rule.36.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d)'

# Pattern 37: identifier (root).
rule.37.parent=-1
rule.37.group='identifier'
rule.37.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d)'

# Pattern 38: identifier (root).
rule.38.parent=-1
rule.38.group='identifier'
rule.38.match='^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+)|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d)|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d)'

# Region 39: constant.string.url (root).
rule.39.parent=-1
rule.39.group='constant.string.url'
# Start/end delimiters carry state between physical lines.
rule.39.start='https?://'
rule.39.end='\s'

# Pattern 40: diff-modified (root).
rule.40.parent=-1
rule.40.group='diff-modified'
rule.40.match='([Cc]ommit:)\s\w+\[\w+]'

# Total flattened rules; update this when adding or removing rules.
rules=41
