rule.91.parent=88
rule.91.group='special'
rule.91.match='!important'

# Pattern 92: identifier (inside region 88).
rule.92.parent=88
rule.92.group='identifier'
rule.92.match=':active|:focus|:hover|:link|:visited|:link|:after|:before|$'

# Pattern 93: special (inside region 88).
rule.93.parent=88
rule.93.group='special'
rule.93.match='(\{|\}|\(|\)|\;|:|\]|~|<|>|,)'

# Pattern 94: statement (inside region 88).
