# Syntax: vue
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='vue'

# Detection: filename first, then header and content signature.
detect.filename='\.vue$'

# Region 0: default (root).
rule.0.parent=-1
rule.0.group='default'
# Start/end delimiters carry state between physical lines.
rule.0.start='<template.*?>'
rule.0.end='</template.*?>'
# Delimiters use this group instead of the region body.
rule.0.limit-group='symbol.tag'

# Pattern 1: error (inside region 0).
rule.1.parent=0
rule.1.group='error'
rule.1.match='<[^!].*?>'

# Pattern 2: symbol.tag (inside region 0).
rule.2.parent=0
rule.2.group='symbol.tag'
rule.2.match='(?i)<[/]?(a|a(bbr|ddress|rea|rticle|side|udio)|b|b(ase|d(i|o)|lockquote|r|utton)|ca(nvas|ption)|center|cite|co(de|l|lgroup)|d(ata|atalist|d|el|etails|fn|ialog|l|t)|em|embed|fieldset|fig(caption|ure)|form|iframe|h[1-6]|hr|i|img|in(put|s)|kbd|keygen|label|legend|li|link|ma(in|p|rk)|menu|menuitem|met(a|er)|nav|noscript|o(bject|l|pt(group|ion)|utput)|p|param|picture|pre|progress|q|r(p|t|uby)|s|samp|se(ction|lect)|svg|small|source|span|strong|su(b|p|mmary)|textarea|time|track|u|ul|var|video|wbr)( .*)*?>'

# Pattern 3: symbol.tag.extended (inside region 0).
rule.3.parent=0
rule.3.group='symbol.tag.extended'
rule.3.match='(?i)<[/]?(body|div|html|head(er)?|footer|title|table|t(body|d|h(ead)?|r|foot))( .*)*?>'

# Pattern 4: preproc (inside region 0).
rule.4.parent=0
rule.4.group='preproc'
rule.4.match='(?i)<[/]?(script|style)( .*)*?>'

# Pattern 5: special (inside region 0).
rule.5.parent=0
rule.5.group='special'
rule.5.match='&[^;[[:space:]]]*;'

# Pattern 6: identifier (inside region 0).
rule.6.parent=0
rule.6.group='identifier'
rule.6.match='(alt|bgcolor|class|height|href|id|label|longdesc|name|on(click|focus|load|mouseover)|placeholder|size|span|src|style|target|type|value|width)='

# Pattern 7: symbol (inside region 0).
rule.7.parent=0
rule.7.group='symbol'
rule.7.match='[:=]'

# Pattern 8: constant.string (inside region 0).
rule.8.parent=0
rule.8.group='constant.string'
rule.8.match='"[^"]*"'

# Pattern 9: constant.number (inside region 0).
rule.9.parent=0
rule.9.group='constant.number'
rule.9.match='(?i)#[0-9a-fA-F]{6,6}'

# Pattern 10: symbol.tag (inside region 0).
rule.10.parent=0
rule.10.group='symbol.tag'
rule.10.match='<|>'

# Pattern 11: constant.string.url (inside region 0).
rule.11.parent=0
rule.11.group='constant.string.url'
rule.11.match='(ftp(s)?|http(s)?|git|chrome)://[^ 	]+'

# Pattern 12: comment (inside region 0).
rule.12.parent=0
rule.12.group='comment'
rule.12.match='<!--.+?-->'

# Region 13: comment.block (inside region 0).
rule.13.parent=0
rule.13.group='comment.block'
# Start/end delimiters carry state between physical lines.
rule.13.start='<!\-\-'
rule.13.end='\-\->'

# Pattern 14: symbol.tag.extended (inside region 0).
rule.14.parent=0
rule.14.group='symbol.tag.extended'
rule.14.match='(?i)<[/]?(b-alert|b-aspect|b-avatar|b-badge|b-icon|b-breadcrumb|b-button-group|b-button-toolbar|b-button|b-calendar|b-card-text|b-card-input|b-card|b-carousel-slide|b-carousel|b-collapse|b-dropdown|b-dropdown-item|b-dropdown-divider|b-embed|b-form-checkbox-group|b-form-checkbox|b-form-datepicker|b-form-file|b-form-group|b-form-input|b-form-radio|b-form-rating|b-form-select|b-form-spinbutton|b-form-tags|b-form-textarea|b-form|b-form-timepicker|b-img-lazy|b-img|b-input-group|b-jumbotron|b-input|b-container|b-row|b-col|b-link|b-list-group|b-list-group-item|b-media|b-modal|b-nav|b-nav-item|b-nav-item-dropdown|b-nav-text|b-nav-form|b-navbar|b-navbar-brand|b-navbar-toggle|b-navbar-nav|b-overlay|b-pagination|b-pagination-nav|b-popover|b-progress|b-progress-bar|b-sidebar|b-skeleton-wrapper|b-skeleton|b-spinner|b-table|b-table-lite|b-table-simple|b-tabs|b-tab|b-time|b-toast|b-tooltip)\b'

# Pattern 15: identifier (inside region 0).
rule.15.parent=0
rule.15.group='identifier'
rule.15.match='(variant|title|show|shadow|icon|align-h|align-v|label-for|@submit|tag|img-alt|img-src|data-toggle|data-target|aria-controls|aria-expanded|aria-label|aria-disabled|tabindex|:interval|background|img-width|img-height|@sliding-start|@sliding-end|cols|header|@reset)='

# Pattern 16: symbol (inside region 0).
rule.16.parent=0
rule.16.group='symbol'
rule.16.match='[:=]'

# Pattern 17: symbol.tag.extended (inside region 0).
rule.17.parent=0
rule.17.group='symbol.tag.extended'
rule.17.match='(?i)<[/]?(component|transition|transition-group|keep-alive|slot)\b'

# Pattern 18: identifier (inside region 0).
rule.18.parent=0
rule.18.group='identifier'
rule.18.match='(v-text|v-html|v-show|v-if|v-else|v-else-if|v-for|v-on|v-bind|v-model|v-slot|v-pre|v-cloak|v-once|key|ref|is|@click)='

# Pattern 19: symbol (inside region 0).
rule.19.parent=0
rule.19.group='symbol'
rule.19.match='[:=]'

# Pattern 20: symbol.tag.extended (inside region 0).
rule.20.parent=0
rule.20.group='symbol.tag.extended'
rule.20.match='(?i)<[/]?(router-link|router-view)\b'

# Pattern 21: identifier (inside region 0).
rule.21.parent=0
rule.21.group='identifier'
rule.21.match='(to|v-slot)='

# Pattern 22: symbol (inside region 0).
rule.22.parent=0
rule.22.group='symbol'
rule.22.match='[:=]'

# Region 23: default (root).
rule.23.parent=-1
rule.23.group='default'
# Start/end delimiters carry state between physical lines.
rule.23.start='<script>'
rule.23.end='</script>'
# Delimiters use this group instead of the region body.
rule.23.limit-group='symbol.tag'

# Included language: javascript. Local rules come first.

# Pattern 24: constant.number (inside region 23).
rule.24.parent=23
rule.24.group='constant.number'
rule.24.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 25: constant.number (inside region 23).
rule.25.parent=23
rule.25.group='constant.number'
rule.25.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 26: constant.number (inside region 23).
rule.26.parent=23
rule.26.group='constant.number'
rule.26.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 27: symbol.brackets (inside region 23).
rule.27.parent=23
rule.27.group='symbol.brackets'
rule.27.match='[(){}]|\[|\]'

# Pattern 28: symbol.operator (inside region 23).
rule.28.parent=23
rule.28.group='symbol.operator'
rule.28.match='([-+/*=<>!~%?:&|]|[.]{3})'

# Pattern 29: statement (inside region 23).
rule.29.parent=23
rule.29.group='statement'
rule.29.match='\b(async|await|break|case|catch|const|continue|debugger|default)\b'

# Pattern 30: statement (inside region 23).
rule.30.parent=23
rule.30.group='statement'
rule.30.match='\b(delete|do|else|export|finally|for|function\*?|class|extends)\b'

# Pattern 31: statement (inside region 23).
rule.31.parent=23
rule.31.group='statement'
rule.31.match='\b(get|if|import|from|in|of|instanceof|let|new|reject|resolve|return)\b'

# Pattern 32: statement (inside region 23).
rule.32.parent=23
rule.32.group='statement'
rule.32.match='\b(set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield)\b'

# Pattern 33: error (inside region 23).
rule.33.parent=23
rule.33.group='error'
rule.33.match='\b(enum|implements|interface|package|private|protected|public)\b'

# Pattern 34: constant (inside region 23).
rule.34.parent=23
rule.34.group='constant'
rule.34.match='\b(globalThis|Infinity|null|undefined|NaN)\b'

# Pattern 35: constant (inside region 23).
rule.35.parent=23
rule.35.group='constant'
rule.35.match='\b(null|undefined|NaN)\b'

# Pattern 36: constant (inside region 23).
rule.36.parent=23
rule.36.group='constant'
rule.36.match='\b(true|false)\b'

# Pattern 37: type (inside region 23).
rule.37.parent=23
rule.37.group='type'
rule.37.match='\b(Array|Boolean|Date|Enumerator|Error|Function|Generator|Map|Math)\b'

# Pattern 38: type (inside region 23).
rule.38.parent=23
rule.38.group='type'
rule.38.match='\b(Number|Object|Promise|Proxy|Reflect|RegExp|Set|String|Symbol|WeakMap|WeakSet)\b'

# Pattern 39: type (inside region 23).
rule.39.parent=23
rule.39.group='type'
rule.39.match='\b(BigInt64Array|BigUint64Array|Float32Array|Float64Array|Int16Array)\b'

# Pattern 40: constant (inside region 23).
rule.40.parent=23
rule.40.group='constant'
rule.40.match='\\[0-7][0-7]?[0-7]?|\\x[0-9a-fA-F]+|\\[bfnrt''"\?\\]'

# Pattern 41: comment (inside region 23).
rule.41.parent=23
rule.41.group='comment'
rule.41.match='^#!.*/(env +)?node( |$)'

# Pattern 42: identifier (inside region 23).
rule.42.parent=23
rule.42.group='identifier'
rule.42.match='\b(alert|decodeURI|decodeURIComponent|document|encodeURI|encodeURIComponent|escape|eval|isFinite|isNaN|parseFloat|parseInt|unescape|uneval|window)\b'

# Pattern 43: identifier (inside region 23).
rule.43.parent=23
rule.43.group='identifier'
rule.43.match='\b(Intl|WebAssembly)\b'

# Pattern 44: identifier (inside region 23).
rule.44.parent=23
rule.44.group='identifier'
rule.44.match='\b(Arguments)\b'

# Region 45: constant.string (inside region 23).
rule.45.parent=23
rule.45.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.45.start='"'
rule.45.end='"'
# Mask escaped text before matching delimiters.
rule.45.skip='\\.'

# Pattern 46: constant.specialChar (inside region 45).
rule.46.parent=45
rule.46.group='constant.specialChar'
rule.46.match='\\.'

# Region 47: constant.string (inside region 23).
rule.47.parent=23
rule.47.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.47.start=''''
rule.47.end=''''
# Mask escaped text before matching delimiters.
rule.47.skip='\\.'

# Pattern 48: constant.specialChar (inside region 47).
rule.48.parent=47
rule.48.group='constant.specialChar'
rule.48.match='\\.'

# Region 49: constant.string (inside region 23).
rule.49.parent=23
rule.49.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.49.start='`'
rule.49.end='`'

# Pattern 50: constant.specialChar (inside region 49).
rule.50.parent=49
rule.50.group='constant.specialChar'
rule.50.match='\\.'

# Pattern 51: identifier (inside region 49).
rule.51.parent=49
rule.51.group='identifier'
rule.51.match='\x24\{.*?\}'

# Pattern 52: constant.bool (inside region 23).
rule.52.parent=23
rule.52.group='constant.bool'
rule.52.match='\b(true|false)\b'

# Pattern 53: constant.bool.false (inside region 23).
rule.53.parent=23
rule.53.group='constant.bool.false'
rule.53.match='\b(false)\b'

# Pattern 54: constant.bool.true (inside region 23).
rule.54.parent=23
rule.54.group='constant.bool.true'
rule.54.match='\b(true)\b'

# Region 55: comment (inside region 23).
rule.55.parent=23
rule.55.group='comment'
# Start/end delimiters carry state between physical lines.
rule.55.start='//'
rule.55.end='$'

# Pattern 56: todo (inside region 55).
rule.56.parent=55
rule.56.group='todo'
rule.56.match='(TODO|XXX|FIXME)'

# Region 57: comment (inside region 23).
rule.57.parent=23
rule.57.group='comment'
# Start/end delimiters carry state between physical lines.
rule.57.start='/\*'
rule.57.end='\*/'
# Mask escaped text before matching delimiters.
rule.57.skip='\\.'

# Pattern 58: constant.specialChar (inside region 57).
rule.58.parent=57
rule.58.group='constant.specialChar'
rule.58.match='\\.'

# Pattern 59: identifier (inside region 57).
rule.59.parent=57
rule.59.group='identifier'
rule.59.match='\s\*\s.*'

# Pattern 60: todo (inside region 57).
rule.60.parent=57
rule.60.group='todo'
rule.60.match='(TODO|XXX|FIXME)'

# Region 61: default (root).
rule.61.parent=-1
rule.61.group='default'
# Start/end delimiters carry state between physical lines.
rule.61.start='<script[ ]+lang=("ts"|''ts'')>'
rule.61.end='</script>'

# Included language: typescript. Local rules come first.

# Pattern 62: constant.number (inside region 61).
rule.62.parent=61
rule.62.group='constant.number'
rule.62.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 63: constant.number (inside region 61).
rule.63.parent=61
rule.63.group='constant.number'
rule.63.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 64: constant.number (inside region 61).
rule.64.parent=61
rule.64.group='constant.number'
rule.64.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 65: identifier (inside region 61).
rule.65.parent=61
rule.65.group='identifier'
rule.65.match='[A-Za-z_][A-Za-z0-9_]*[[:space:]]*[(]'

# Pattern 66: statement (inside region 61).
rule.66.parent=61
rule.66.group='statement'
rule.66.match='\b(abstract|as|async|await|break|case|catch|class|const|constructor|continue)\b'

# Pattern 67: statement (inside region 61).
rule.67.parent=61
rule.67.group='statement'
rule.67.match='\b(debugger|declare|default|delete|do|else|enum|export|extends|finally|for|from)\b'

# Pattern 68: statement (inside region 61).
rule.68.parent=61
rule.68.group='statement'
rule.68.match='\b(function|get|if|implements|import|in|instanceof|interface|is|let|module|namespace)\b'

# Pattern 69: statement (inside region 61).
rule.69.parent=61
rule.69.group='statement'
rule.69.match='\b(new|of|package|private|protected|public|require|return|set|static|super|switch)\b'

# Pattern 70: statement (inside region 61).
rule.70.parent=61
rule.70.group='statement'
rule.70.match='\b(this|throw|try|type|typeof|var|void|while|with|yield)\b'

# Pattern 71: constant (inside region 61).
rule.71.parent=61
rule.71.group='constant'
rule.71.match='\b(false|true|null|undefined|NaN)\b'

# Pattern 72: type (inside region 61).
rule.72.parent=61
rule.72.group='type'
rule.72.match='\b(Array|Boolean|Date|Enumerator|Error|Function|Math)\b'

# Pattern 73: type (inside region 61).
rule.73.parent=61
rule.73.group='type'
rule.73.match='\b(Number|Object|RegExp|String|Symbol)\b'

# Pattern 74: type (inside region 61).
rule.74.parent=61
rule.74.group='type'
