rule.94.group='statement'
rule.94.match='@import|@mixin|@extend'

# Region 95: constant.string (inside region 88).
rule.95.parent=88
rule.95.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.95.start='"'
rule.95.end='"'
# Mask escaped text before matching delimiters.
rule.95.skip='\\.'

# Pattern 96: constant.specialChar (inside region 95).
rule.96.parent=95
rule.96.group='constant.specialChar'
rule.96.match='\\.'

# Region 97: constant.string (inside region 88).
rule.97.parent=88
rule.97.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.97.start=''''
