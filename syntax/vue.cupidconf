# Pattern 99: special (inside region 88).
rule.99.parent=88
rule.99.group='special'
rule.99.match='"|'''

# Region 100: comment (inside region 88).
rule.100.parent=88
rule.100.group='comment'
# Start/end delimiters carry state between physical lines.
rule.100.start='\/\*'
rule.100.end='\*\/'

