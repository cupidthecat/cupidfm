# Syntax: php
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='php'

# Detection: filename first, then header and content signature.
detect.filename='\.php[2345s~]?$'

# Pattern 0: symbol.operator (root).
rule.0.parent=-1
rule.0.group='symbol.operator'
rule.0.match='<|>'

# Pattern 1: error (root).
rule.1.parent=-1
rule.1.group='error'
rule.1.match='<[^!].*?>'

# Pattern 2: symbol.tag (root).
rule.2.parent=-1
rule.2.group='symbol.tag'
rule.2.match='(?i)<[/]?(a(bbr|cronym|ddress|pplet|rea|rticle|side|udio)?|b(ase(font)?|d(i|o)|ig|lockquote|r)?|ca(nvas|ption)|center|cite|co(de|l|lgroup)|d(ata(list)?|d|el|etails|fn|ialog|ir|l|t)|em(bed)?|fieldset|fig(caption|ure)|font|form|(i)?frame|frameset|h[1-6]|hr|i|img|in(put|s)|kbd|keygen|label|legend|li(nk)?|ma(in|p|rk)|menu(item)?|met(a|er)|nav|no(frames|script)|o(l|pt(group|ion)|utput)|p(aram|icture|re|rogress)?|q|r(p|t|uby)|s(trike)?|samp|se(ction|lect)|small|source|span|strong|su(b|p|mmary)|textarea|time|track|u(l)?|var|video|wbr)( .*|>)*?>'

# Pattern 3: symbol.tag.extended (root).
rule.3.parent=-1
rule.3.group='symbol.tag.extended'
rule.3.match='(?i)<[/]?(body|div|html|head(er)?|footer|title|table|t(body|d|h(ead)?|r|foot))( .*|>)*?>'

# Pattern 4: preproc (root).
rule.4.parent=-1
rule.4.group='preproc'
rule.4.match='(?i)<[/]?(script|style)( .*|>)*?>'

# Pattern 5: preproc (root).
rule.5.parent=-1
rule.5.group='preproc'
rule.5.match='<\?(php|=)?'

# Pattern 6: preproc (root).
rule.6.parent=-1
rule.6.group='preproc'
rule.6.match='\?>'

# Pattern 7: preproc (root).
rule.7.parent=-1
rule.7.group='preproc'
rule.7.match='<!DOCTYPE.+?>'

# Pattern 8: special (root).
rule.8.parent=-1
rule.8.group='special'
rule.8.match='&[^;[[:space:]]]*;'

# Pattern 9: symbol (root).
rule.9.parent=-1
rule.9.group='symbol'
rule.9.match='[:=]'

# Pattern 10: identifier (root).
rule.10.parent=-1
rule.10.group='identifier'
rule.10.match='(alt|bgcolor|height|href|label|longdesc|name|onclick|onfocus|onload|onmouseover|size|span|src|style|target|type|value|width)='

# Pattern 11: constant.number (root).
rule.11.parent=-1
rule.11.group='constant.number'
rule.11.match='(?i)#[0-9a-fA-F]{6,6}'

# Pattern 12: constant.string.url (root).
rule.12.parent=-1
rule.12.group='constant.string.url'
rule.12.match='(ftp(s)?|http(s)?|git|chrome)://[^ 	]+'

# Pattern 13: comment (root).
rule.13.parent=-1
rule.13.group='comment'
rule.13.match='<!--.+?-->'

# Pattern 14: default (root).
rule.14.parent=-1
rule.14.group='default'
rule.14.match='<\?(php|=)" end="\?>'

# Pattern 15: identifier.class (root).
rule.15.parent=-1
rule.15.group='identifier.class'
rule.15.match='([a-zA-Z0-9_-]+)\('

# Pattern 16: type (root).
rule.16.parent=-1
rule.16.group='type'
rule.16.match='\b(array|bool|callable|float|int|iterable|object|mixed|string|void)\b'

# Pattern 17: identifier.class (root).
rule.17.parent=-1
rule.17.group='identifier.class'
rule.17.match='[a-zA-Z\\]+::'

# Pattern 18: identifier (root).
rule.18.parent=-1
rule.18.group='identifier'
rule.18.match='\b([A-Z][a-zA-Z0-9_]+)\b'

# Pattern 19: identifier (root).
rule.19.parent=-1
rule.19.group='identifier'
rule.19.match='([A-Z0-9_]+)[;|\s|\)|,]'

# Pattern 20: type.keyword (root).
rule.20.parent=-1
rule.20.group='type.keyword'
rule.20.match='\b(global|final|public|private|protected|static|const|var)\b'

# Pattern 21: statement (root).
rule.21.parent=-1
rule.21.group='statement'
rule.21.match='\b(abstract|catch|class|declare|do|else(if)?|end(declare|for(each)?|if|switch|while)|enum|finally|for(each)|function|if|interface|namespace|switch|trait|try|while)\b'

# Pattern 22: identifier (root).
rule.22.parent=-1
rule.22.group='identifier'
rule.22.match='\bnew\s+([a-zA-Z0-9\\]+)'

# Pattern 23: special (root).
rule.23.parent=-1
rule.23.group='special'
rule.23.match='\b(as|and|break|case|clone|continue|default|die|fn|echo|empty|eval|exit|extends|goto|or|include(_once)?|implements|instanceof|insteadof|isset|list|match|new|print|return|require(_once)?|unset|use|throw|xor|yield(\s+from))\b'

# Pattern 24: constant.bool (root).
rule.24.parent=-1
rule.24.group='constant.bool'
rule.24.match='\b(true|false|null|TRUE|FALSE|NULL)\b'

# Pattern 25: constant (root).
rule.25.parent=-1
rule.25.group='constant'
rule.25.match='[\s|=|\s|\(|/|+|-|\*|\[]'

# Pattern 26: constant.number (root).
rule.26.parent=-1
rule.26.group='constant.number'
rule.26.match='[0-9]'

# Pattern 27: identifier (root).
rule.27.parent=-1
rule.27.group='identifier'
rule.27.match='(\$this|parent|self|\$this->)'

# Pattern 28: symbol.operator (root).
rule.28.parent=-1
rule.28.group='symbol.operator'
rule.28.match='(=>|===|!==|==|!=|&&|\|\||::|=|->|\!)'

# Pattern 29: identifier.var (root).
rule.29.parent=-1
rule.29.group='identifier.var'
rule.29.match='(\$[a-zA-Z0-9\-_]+)'

# Pattern 30: symbol.operator (root).
rule.30.parent=-1
rule.30.group='symbol.operator'
rule.30.match='[\(|\)|/|+|\-|\*|\[|.|,|;]'

# Pattern 31: symbol.brackets (root).
rule.31.parent=-1
rule.31.group='symbol.brackets'
rule.31.match='(\[|\]|\{|\}|[()])'

# Region 32: comment (root).
rule.32.parent=-1
rule.32.group='comment'
# Start/end delimiters carry state between physical lines.
rule.32.start='(^|[[:space:]])*(//|#)'
rule.32.end='$'

# Region 33: comment (root).
rule.33.parent=-1
rule.33.group='comment'
# Start/end delimiters carry state between physical lines.
rule.33.start='/\*'
rule.33.end='\*/'

# Region 34: constant.string (root).
rule.34.parent=-1
rule.34.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.34.start='"'
rule.34.end='"'
# Mask escaped text before matching delimiters.
rule.34.skip='\\.'

# Pattern 35: constant.specialChar (inside region 34).
rule.35.parent=34
rule.35.group='constant.specialChar'
rule.35.match='\\[abfnrtv''\"\\]'

# Region 36: constant.string (root).
rule.36.parent=-1
rule.36.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.36.start=''''
rule.36.end=''''
# Mask escaped text before matching delimiters.
rule.36.skip='\\.'

# Pattern 37: constant.specialChar (inside region 36).
rule.37.parent=36
rule.37.group='constant.specialChar'
rule.37.match='\\[abfnrtv''\"\\]'

# Total flattened rules; update this when adding or removing rules.
rules=38
