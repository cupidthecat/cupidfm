# Syntax: octave
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='octave'

# Detection: filename first, then header and content signature.
detect.filename='\.m$'

# Pattern 0: statement (root).
rule.0.parent=-1
rule.0.group='statement'
rule.0.match='\b(function|endfunction|return|end|global|persistent)\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(if|elseif|else|endif|switch|case|otherwise|endswitch)\b'

# Pattern 2: statement (root).
rule.2.parent=-1
rule.2.group='statement'
rule.2.match='\b(while|endwhile|do|until|for|endfor|parfor|endparfor|break|continue)\b'

# Pattern 3: statement (root).
rule.3.parent=-1
rule.3.group='statement'
rule.3.match='\b(unwind_protect|unwind_protect_cleanup|end_unwind_protect|try|catch|end_try_catch)\b'

# Pattern 4: symbol.operator (root).
rule.4.parent=-1
rule.4.group='symbol.operator'
rule.4.match='[-+/*=<>!~%&|^]|:='

# Pattern 5: symbol.brackets (root).
rule.5.parent=-1
rule.5.group='symbol.brackets'
rule.5.match='(\{|\})'

# Pattern 6: symbol.brackets (root).
rule.6.parent=-1
rule.6.group='symbol.brackets'
rule.6.match='(\(|\))'

# Pattern 7: symbol.brackets (root).
rule.7.parent=-1
rule.7.group='symbol.brackets'
rule.7.match='(\[|\])'

# Pattern 8: symbol (root).
rule.8.parent=-1
rule.8.group='symbol'
rule.8.match=','

# Pattern 9: constant.number (root).
rule.9.parent=-1
rule.9.group='constant.number'
rule.9.match='\b([0-9]+|0x[0-9a-fA-F]*)\b|''.'''

# Pattern 10: constant.number (root).
rule.10.parent=-1
rule.10.group='constant.number'
rule.10.match='\b(pi|e|I|Inf|NaN|eps|realmax|realmin)\b|'

# Pattern 11: constant.bool (root).
rule.11.parent=-1
rule.11.group='constant.bool'
rule.11.match='\b(true|false)\b'

# Region 12: constant.string (root).
rule.12.parent=-1
rule.12.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.12.start='"'
rule.12.end='"'
# Mask escaped text before matching delimiters.
rule.12.skip='\\.'

# Pattern 13: constant.specialChar (inside region 12).
rule.13.parent=12
rule.13.group='constant.specialChar'
rule.13.match='%'

# Pattern 14: constant.specialChar (inside region 12).
rule.14.parent=12
rule.14.group='constant.specialChar'
rule.14.match='\\[abfnrtv''\"\\]'

# Pattern 15: constant.specialChar (inside region 12).
rule.15.parent=12
rule.15.group='constant.specialChar'
rule.15.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 16: constant.string (root).
rule.16.parent=-1
rule.16.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.16.start=''''
rule.16.end=''''
# Mask escaped text before matching delimiters.
rule.16.skip='\\.'

# Pattern 17: error (inside region 16).
rule.17.parent=16
rule.17.group='error'
rule.17.match='..+'

# Pattern 18: constant.specialChar (inside region 16).
rule.18.parent=16
rule.18.group='constant.specialChar'
rule.18.match='%'

# Pattern 19: constant.specialChar (inside region 16).
rule.19.parent=16
rule.19.group='constant.specialChar'
rule.19.match='\\[abfnrtv''\"\\]'

# Pattern 20: constant.specialChar (inside region 16).
rule.20.parent=16
rule.20.group='constant.specialChar'
rule.20.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 21: comment (root).
rule.21.parent=-1
rule.21.group='comment'
# Start/end delimiters carry state between physical lines.
rule.21.start='%'
rule.21.end='$'

# Pattern 22: todo (inside region 21).
rule.22.parent=21
rule.22.group='todo'
rule.22.match='(TODO|XXX|FIXME):?'

# Region 23: comment (root).
rule.23.parent=-1
rule.23.group='comment'
# Start/end delimiters carry state between physical lines.
rule.23.start='#'
rule.23.end='$'

# Pattern 24: todo (inside region 23).
rule.24.parent=23
rule.24.group='todo'
rule.24.match='(TODO|XXX|FIXME):?'

# Region 25: comment (root).
rule.25.parent=-1
rule.25.group='comment'
# Start/end delimiters carry state between physical lines.
rule.25.start='%{'
rule.25.end='%}'

# Pattern 26: todo (inside region 25).
rule.26.parent=25
rule.26.group='todo'
rule.26.match='(TODO|XXX|FIXME):?'

# Region 27: comment (root).
rule.27.parent=-1
rule.27.group='comment'
# Start/end delimiters carry state between physical lines.
rule.27.start='#{'
rule.27.end='#}'

# Pattern 28: todo (inside region 27).
rule.28.parent=27
rule.28.group='todo'
rule.28.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=29
