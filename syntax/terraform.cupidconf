# Syntax: terraform
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='terraform'

# Detection: filename first, then header and content signature.
detect.filename='\.tf$|\.hcl$'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='\b(var|local|module|data|path|terraform)\b'

# Pattern 1: special (root).
rule.1.parent=-1
rule.1.group='special'
rule.1.match='\b(resource|provider|variable|output|locals|module|terraform)\b'

# Pattern 2: type.keyword (root).
rule.2.parent=-1
rule.2.group='type.keyword'
rule.2.match='\b(any|string|number|bool)\b'

# Pattern 3: statement (root).
rule.3.parent=-1
rule.3.group='statement'
rule.3.match='\b(abs|ceil|floor|log|max|min|parseint|pow|signum|chomp|format|formatlist|indent|join|lower|regex|regexall|replace|split|strrev|substr|title|trim|trimprefix|trimsuffix|trimspace|upper|alltrue|anytrue|chunklist|coalesce|coalescelist|compact|concat|contains|distinct|element|flatten|index|keys|length|list|lookup|map|matchkeys|merge|one|range|reverse|setintersection|setproduct|setsubtract|setunion|slice|sort|sum|transpose|values|zipmap|base64decode|base64encode|base64gzip|csvdecode|jsondecode|jsonencode|textdecodebase64|textencodebase64|urlencode|yamldecode|yamlencode|abspath|dirname|pathexpand|basename|file|fileexists|fileset|filebase64|templatefile|formatdate|timeadd|timestamp|base64sha256|base64sha512|bcrypt|filebase64sha256|filebase64sha512|filemd5|filesha1|filesha256|filesha512|md5|rsadecrypt|sha1|sha256|sha512|uuid|uuidv5|cidrhost|cidrnetmask|cidrsubnet|cidrsubnets|can|defaults|nonsensitive|sensitive|tobool|tolist|tomap|tonumber|toset|tostring|try)\b'

# Pattern 4: symbol.operator (root).
rule.4.parent=-1
rule.4.group='symbol.operator'
rule.4.match='([~^.:;,+*|=!\%@]|<|>|/|-|&)'

# Pattern 5: symbol.brackets (root).
rule.5.parent=-1
rule.5.group='symbol.brackets'
rule.5.match='([(){}]|\[|\])'

# Pattern 6: constant.number (root).
rule.6.parent=-1
rule.6.group='constant.number'
rule.6.match='\b([0-9]+|0x[0-9a-fA-F]*)\b|''.'''

# Pattern 7: constant.bool (root).
rule.7.parent=-1
rule.7.group='constant.bool'
rule.7.match='\b(true|false|null)\b'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start='"'
rule.8.end='"'
# Mask escaped text before matching delimiters.
rule.8.skip='\\.'

# Pattern 9: constant.specialChar (inside region 8).
rule.9.parent=8
rule.9.group='constant.specialChar'
rule.9.match='%.'

# Pattern 10: constant.specialChar (inside region 8).
rule.10.parent=8
rule.10.group='constant.specialChar'
rule.10.match='\\[abfnrtv''\"\\]'

# Pattern 11: constant.specialChar (inside region 8).
rule.11.parent=8
rule.11.group='constant.specialChar'
rule.11.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 12: constant.string (root).
rule.12.parent=-1
rule.12.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.12.start=''''''
rule.12.end=''''''
# Mask escaped text before matching delimiters.
rule.12.skip='\\.'

# Pattern 13: constant.specialChar (inside region 12).
rule.13.parent=12
rule.13.group='constant.specialChar'
rule.13.match='%.'

# Pattern 14: constant.specialChar (inside region 12).
rule.14.parent=12
rule.14.group='constant.specialChar'
rule.14.match='\\[abfnrtv''\"\\]'

# Pattern 15: constant.specialChar (inside region 12).
rule.15.parent=12
rule.15.group='constant.specialChar'
rule.15.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 16: comment (root).
rule.16.parent=-1
rule.16.group='comment'
# Start/end delimiters carry state between physical lines.
rule.16.start='#|//'
rule.16.end='$\n?'

# Pattern 17: todo (inside region 16).
rule.17.parent=16
rule.17.group='todo'
rule.17.match='(TODO|XXX|FIXME):?'

# Region 18: comment (root).
rule.18.parent=-1
rule.18.group='comment'
# Start/end delimiters carry state between physical lines.
rule.18.start='/\*'
rule.18.end='\*/'

# Pattern 19: todo (inside region 18).
rule.19.parent=18
rule.19.group='todo'
rule.19.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=20
