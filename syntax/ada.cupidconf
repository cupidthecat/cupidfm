# Syntax: ada
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='ada'

# Detection: filename first, then header and content signature.
detect.filename='(\.ads$|\.adb$|\.ada$)'

# Pattern 0: symbol.operator (root).
rule.0.parent=-1
rule.0.group='symbol.operator'
rule.0.match='([.:;,+*|=!?\\%]|<|>|/|-|&)'

# Pattern 1: symbol.brackets (root).
rule.1.parent=-1
rule.1.group='symbol.brackets'
rule.1.match='[(){}]|\[|\]'

# Pattern 2: statement.reserved (root).
rule.2.parent=-1
rule.2.group='statement.reserved'
rule.2.match='\b(abort|abs|abstract|accept|access|aliased|all|and|array|at|begin|body|case)\b'

# Pattern 3: statement.reserved (root).
rule.3.parent=-1
rule.3.group='statement.reserved'
rule.3.match='\b(constant|declare|delay|delta|digits|do|else|elsif|end|entry|exception|exit|for|function)\b'

# Pattern 4: statement.reserved (root).
rule.4.parent=-1
rule.4.group='statement.reserved'
rule.4.match='\b(generic|goto|if|in|interface|is|limited|loop|mod|new|not|null|of|or|others|out|overriding)\b'

# Pattern 5: statement.reserved (root).
rule.5.parent=-1
rule.5.group='statement.reserved'
rule.5.match='\b(package|pragma|private|procedure|protected|raise|range|record|rem|renames|return|requeue)\b'

# Pattern 6: statement.reserved (root).
rule.6.parent=-1
rule.6.group='statement.reserved'
rule.6.match='\b(reverse|select|separate|some|subtype|synchronized|tagged|task|terminate|then|type|until)\b'

# Pattern 7: statement.reserved (root).
rule.7.parent=-1
rule.7.group='statement.reserved'
rule.7.match='\b(use|when|while|with|xor)\b'

# Pattern 8: constant.bool (root).
rule.8.parent=-1
rule.8.group='constant.bool'
rule.8.match='\b(TRUE|FALSE)'

# Pattern 9: constant.number (root).
rule.9.parent=-1
rule.9.group='constant.number'
rule.9.match='([0-9]+)'

# Pattern 10: type.storage (root).
rule.10.parent=-1
rule.10.group='type.storage'
rule.10.match='\b(INTEGER|NATURAL|POSITIVE|FLOAT|CHARACTER|STRING)\b'

# Pattern 11: type.storage (root).
rule.11.parent=-1
rule.11.group='type.storage'
rule.11.match='\b(LONG_INTEGER|SHORT_INTEGER|LONG_FLOAT|SHORT_FLOAT)\b'

# Pattern 12: constant.string.char (root).
rule.12.parent=-1
rule.12.group='constant.string.char'
rule.12.match='\''.\'''

# Region 13: constant.string (root).
rule.13.parent=-1
rule.13.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.13.start='\"'
rule.13.end='\"'
# Mask escaped text before matching delimiters.
rule.13.skip='\\.'

# Pattern 14: constant.specialChar (inside region 13).
rule.14.parent=13
rule.14.group='constant.specialChar'
rule.14.match='(\\0|\\\\|\\t|\\n|\\r|\\"|\\'')'

# Pattern 15: constant.interpolation (inside region 13).
rule.15.parent=13
rule.15.group='constant.interpolation'
rule.15.match='\\\([[:graph:]]*\)'

# Pattern 16: constant.unicode (inside region 13).
rule.16.parent=13
rule.16.group='constant.unicode'
rule.16.match='\\u\{[[:xdigit:]]+}'

# Pattern 17: comment.line (root).
rule.17.parent=-1
rule.17.group='comment.line'
rule.17.match='--.*'

# Pattern 18: todo (root).
rule.18.parent=-1
rule.18.group='todo'
rule.18.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=19
