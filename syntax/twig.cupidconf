# Syntax: twig
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='twig'

# Detection: filename first, then header and content signature.
detect.filename='\.twig$'

# Region 0: symbol.tag (root).
rule.0.parent=-1
rule.0.group='symbol.tag'
# Start/end delimiters carry state between physical lines.
rule.0.start='\{\{[[:space:]]'
rule.0.end='[[:space:]]\}\}'

# Pattern 1: identifier (inside region 0).
rule.1.parent=0
rule.1.group='identifier'
rule.1.match='\b(abs|batch|capitalize|convert|encoding|date(_modify)?|default|escape|first|format|join|json_encode|keys|last|length|lower|merge|nl2br|number_format|raw|replace|reverse|round|slice|sort|split|striptags|title|trim|upper|url_encode)\b'

# Pattern 2: identifier.class (inside region 0).
rule.2.parent=0
rule.2.group='identifier.class'
rule.2.match='\b(attribute|block|constant|cycle|date|dump|include|max|min|parent|random|range|source|template_from_string)\b'

# Pattern 3: type.keyword (inside region 0).
rule.3.parent=0
rule.3.group='type.keyword'
rule.3.match='\b(and|as|constant|defined|divisibleby|empty|even|false|in|is|iterable|not|null|odd|or|same(as)?|true|with)\b'

# Pattern 4: symbol.operator (inside region 0).
rule.4.parent=0
rule.4.group='symbol.operator'
rule.4.match='[.:;,+*?|=!\%]|<|>|/|-|&'

# Pattern 5: symbol.brackets (inside region 0).
rule.5.parent=0
rule.5.group='symbol.brackets'
rule.5.match='[(){}]|\[|\]'

# Pattern 6: constant.number (inside region 0).
rule.6.parent=0
rule.6.group='constant.number'
rule.6.match='\b[0-9]+\b|\b0x[0-9A-Fa-f]+\b'

# Region 7: constant.string (inside region 0).
rule.7.parent=0
rule.7.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.7.start='"'
rule.7.end='"'
# Mask escaped text before matching delimiters.
rule.7.skip='\\'

# Pattern 8: constant.specialChar (inside region 7).
rule.8.parent=7
rule.8.group='constant.specialChar'
rule.8.match='\\.'

# Region 9: constant.string (inside region 0).
rule.9.parent=0
rule.9.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.9.start=''''
rule.9.end=''''
# Mask escaped text before matching delimiters.
rule.9.skip='\\'

# Pattern 10: constant.specialChar (inside region 9).
rule.10.parent=9
rule.10.group='constant.specialChar'
rule.10.match='\\.'

# Region 11: symbol.tag (root).
rule.11.parent=-1
rule.11.group='symbol.tag'
# Start/end delimiters carry state between physical lines.
rule.11.start='\{%[[:space:]]'
rule.11.end='[[:space:]]%\}'

# Pattern 12: identifier (inside region 11).
rule.12.parent=11
rule.12.group='identifier'
rule.12.match='\b(abs|batch|capitalize|convert|encoding|date(_modify)?|default|escape|first|format|join|json_encode|keys|last|length|lower|merge|nl2br|number_format|raw|replace|reverse|round|slice|sort|split|striptags|title|trim|upper|url_encode)\b'

# Pattern 13: identifier.class (inside region 11).
rule.13.parent=11
rule.13.group='identifier.class'
rule.13.match='\b(attribute|block|constant|cycle|date|dump|include|max|min|parent|random|range|source|template_from_string)\b'

# Pattern 14: type.keyword (inside region 11).
rule.14.parent=11
rule.14.group='type.keyword'
rule.14.match='\b(and|as|constant|defined|divisibleby|empty|even|false|in|is|iterable|not|null|odd|or|same(as)?|true|with)\b'

# Pattern 15: symbol.operator (inside region 11).
rule.15.parent=11
rule.15.group='symbol.operator'
rule.15.match='[.:;,+*?|=!\%]|<|>|/|-|&'

# Pattern 16: symbol.brackets (inside region 11).
rule.16.parent=11
rule.16.group='symbol.brackets'
rule.16.match='[(){}]|\[|\]'

# Pattern 17: constant.number (inside region 11).
rule.17.parent=11
rule.17.group='constant.number'
rule.17.match='\b[0-9]+\b|\b0x[0-9A-Fa-f]+\b'

# Region 18: constant.string (inside region 11).
rule.18.parent=11
rule.18.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.18.start='"'
rule.18.end='"'
# Mask escaped text before matching delimiters.
rule.18.skip='\\'

# Pattern 19: constant.specialChar (inside region 18).
rule.19.parent=18
rule.19.group='constant.specialChar'
rule.19.match='\\.'

# Region 20: constant.string (inside region 11).
rule.20.parent=11
rule.20.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.20.start=''''
rule.20.end=''''
# Mask escaped text before matching delimiters.
rule.20.skip='\\'

# Pattern 21: constant.specialChar (inside region 20).
rule.21.parent=20
rule.21.group='constant.specialChar'
rule.21.match='\\.'

# Region 22: comment (root).
rule.22.parent=-1
rule.22.group='comment'
# Start/end delimiters carry state between physical lines.
rule.22.start='\{#'
rule.22.end='#\}'

# Included language: html. Local rules come first.

# Pattern 23: preproc (root).
rule.23.parent=-1
rule.23.group='preproc'
rule.23.match='<!(?i)(DOCTYPE html.*)>'

# Region 24: symbol.tag (root).
rule.24.parent=-1
rule.24.group='symbol.tag'
# Start/end delimiters carry state between physical lines.
rule.24.start='<(a|abbr|acronym|address|applet|area|article|aside|audio|b|base|bdi|bdo|big|blockquote|body|br|button|canvas|caption|center|cite|code|col|colgroup|command|datalist|dd|del|details|dfn|dialog|dir|div|dl|dt|em|embed|fieldset|figcaption|figure|font|footer|form|frame|frameset|h[1-6]|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|keygen|label|legend|li|link|map|main|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|pre|progress|q|rp|rt|ruby|s|samp|section|select|small|source|span|strike|strong|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|track|tt|u|ul|var|video|wbr)\b'
rule.24.end='>'

# Pattern 25: identifier (inside region 24).
rule.25.parent=24
rule.25.group='identifier'
rule.25.match='\b(placeholder|style|alt|bgcolor|height|href|id|(aria|data)\-.+|label|longdesc|name|on(click|focus|load|mouseover)|size|span|src|target|type|value|width|class|charset|content|rel|integrity|crossorigin|for|onsubmit|lang|role)\b'

# Pattern 26: special (inside region 24).
rule.26.parent=24
rule.26.group='special'
rule.26.match='\b(required)\b'

# Region 27: constant.string (inside region 24).
rule.27.parent=24
rule.27.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.27.start='"'
rule.27.end='"'
# Mask escaped text before matching delimiters.
rule.27.skip='\\.'

# Pattern 28: constant.specialChar (inside region 27).
rule.28.parent=27
rule.28.group='constant.specialChar'
rule.28.match='\\.'

# Pattern 29: constant.string.url (inside region 27).
rule.29.parent=27
rule.29.group='constant.string.url'
rule.29.match='((ftp(s)?|http(s)?|git|chrome)://[^\s]+)'

# Region 30: constant.string (inside region 24).
rule.30.parent=24
rule.30.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.30.start=''''
rule.30.end=''''
# Mask escaped text before matching delimiters.
rule.30.skip='\\.'

# Pattern 31: constant.specialChar (inside region 30).
rule.31.parent=30
rule.31.group='constant.specialChar'
rule.31.match='\\.'

# Pattern 32: constant.string.url (inside region 30).
rule.32.parent=30
rule.32.group='constant.string.url'
rule.32.match='((ftp(s)?|http(s)?|git|chrome)://[^\s]+)'

# Pattern 33: symbol (inside region 24).
rule.33.parent=24
rule.33.group='symbol'
rule.33.match='\b(=|:\b)'

# Region 34: symbol.tag (root).
rule.34.parent=-1
rule.34.group='symbol.tag'
# Start/end delimiters carry state between physical lines.
rule.34.start='</(a|abbr|acronym|address|applet|area|article|aside|audio|b|base|bdi|bdo|big|blockquote|body|br|button|canvas|caption|center|cite|code|col|colgroup|command|datalist|dd|del|details|dfn|dialog|dir|div|dl|dt|em|embed|fieldset|figcaption|figure|font|footer|form|frame|frameset|h[1-6]|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|keygen|label|legend|li|link|map|main|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|pre|progress|q|rp|rt|ruby|s|samp|section|select|small|source|span|strike|strong|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|track|tt|u|ul|var|video|wbr)\b'
rule.34.end='>'

# Pattern 35: error (inside region 34).
rule.35.parent=34
rule.35.group='error'
rule.35.match='.'

# Pattern 36: special (root).
rule.36.parent=-1
rule.36.group='special'
rule.36.match='(([a-zA-Z]&#[0-9]+|&[a-zA-Z]+|&#[a-zA-Z0-9]+);)'

# Region 37: default (root).
rule.37.parent=-1
rule.37.group='default'
# Start/end delimiters carry state between physical lines.
rule.37.start='<script.*?>'
rule.37.end='</script.*?>'
# Delimiters use this group instead of the region body.
rule.37.limit-group='symbol.tag'

# Included language: javascript. Local rules come first.

# Pattern 38: constant.number (inside region 37).
rule.38.parent=37
rule.38.group='constant.number'
rule.38.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 39: constant.number (inside region 37).
rule.39.parent=37
rule.39.group='constant.number'
rule.39.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 40: constant.number (inside region 37).
rule.40.parent=37
rule.40.group='constant.number'
rule.40.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 41: symbol.brackets (inside region 37).
rule.41.parent=37
rule.41.group='symbol.brackets'
rule.41.match='[(){}]|\[|\]'

# Pattern 42: symbol.operator (inside region 37).
rule.42.parent=37
rule.42.group='symbol.operator'
rule.42.match='([-+/*=<>!~%?:&|]|[.]{3})'

# Pattern 43: statement (inside region 37).
rule.43.parent=37
rule.43.group='statement'
rule.43.match='\b(async|await|break|case|catch|const|continue|debugger|default)\b'

# Pattern 44: statement (inside region 37).
rule.44.parent=37
rule.44.group='statement'
rule.44.match='\b(delete|do|else|export|finally|for|function\*?|class|extends)\b'

# Pattern 45: statement (inside region 37).
rule.45.parent=37
rule.45.group='statement'
rule.45.match='\b(get|if|import|from|in|of|instanceof|let|new|reject|resolve|return)\b'

# Pattern 46: statement (inside region 37).
rule.46.parent=37
rule.46.group='statement'
rule.46.match='\b(set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield)\b'

# Pattern 47: error (inside region 37).
rule.47.parent=37
rule.47.group='error'
rule.47.match='\b(enum|implements|interface|package|private|protected|public)\b'

# Pattern 48: constant (inside region 37).
rule.48.parent=37
rule.48.group='constant'
rule.48.match='\b(globalThis|Infinity|null|undefined|NaN)\b'

# Pattern 49: constant (inside region 37).
rule.49.parent=37
rule.49.group='constant'
rule.49.match='\b(null|undefined|NaN)\b'

# Pattern 50: constant (inside region 37).
rule.50.parent=37
rule.50.group='constant'
rule.50.match='\b(true|false)\b'

# Pattern 51: type (inside region 37).
rule.51.parent=37
rule.51.group='type'
rule.51.match='\b(Array|Boolean|Date|Enumerator|Error|Function|Generator|Map|Math)\b'

# Pattern 52: type (inside region 37).
rule.52.parent=37
rule.52.group='type'
rule.52.match='\b(Number|Object|Promise|Proxy|Reflect|RegExp|Set|String|Symbol|WeakMap|WeakSet)\b'

# Pattern 53: type (inside region 37).
rule.53.parent=37
rule.53.group='type'
rule.53.match='\b(BigInt64Array|BigUint64Array|Float32Array|Float64Array|Int16Array)\b'

# Pattern 54: constant (inside region 37).
rule.54.parent=37
rule.54.group='constant'
rule.54.match='\\[0-7][0-7]?[0-7]?|\\x[0-9a-fA-F]+|\\[bfnrt''"\?\\]'

# Pattern 55: comment (inside region 37).
rule.55.parent=37
rule.55.group='comment'
rule.55.match='^#!.*/(env +)?node( |$)'

# Pattern 56: identifier (inside region 37).
rule.56.parent=37
rule.56.group='identifier'
rule.56.match='\b(alert|decodeURI|decodeURIComponent|document|encodeURI|encodeURIComponent|escape|eval|isFinite|isNaN|parseFloat|parseInt|unescape|uneval|window)\b'

# Pattern 57: identifier (inside region 37).
rule.57.parent=37
rule.57.group='identifier'
rule.57.match='\b(Intl|WebAssembly)\b'

# Pattern 58: identifier (inside region 37).
rule.58.parent=37
rule.58.group='identifier'
rule.58.match='\b(Arguments)\b'

# Region 59: constant.string (inside region 37).
rule.59.parent=37
rule.59.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.59.start='"'
rule.59.end='"'
# Mask escaped text before matching delimiters.
rule.59.skip='\\.'

# Pattern 60: constant.specialChar (inside region 59).
rule.60.parent=59
rule.60.group='constant.specialChar'
rule.60.match='\\.'

