rule.61.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.61.start=''''
rule.61.end=''''
# Mask escaped text before matching delimiters.
rule.61.skip='\\.'

# Pattern 62: constant.specialChar (inside region 61).
rule.62.parent=61
rule.62.group='constant.specialChar'
rule.62.match='\\.'

# Region 63: constant.string (inside region 37).
rule.63.parent=37
rule.63.group='constant.string'
