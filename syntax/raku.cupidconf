# Syntax: raku
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='raku'

# Detection: filename first, then header and content signature.
detect.filename='\.(p(l|m|od)?6|raku(mod|doc|test)?|nqp)$'

# Pattern 0: type (root).
rule.0.parent=-1
rule.0.group='type'
rule.0.match='\b(accept|alarm|atan2|bin(d|mode)|c(aller|h(dir|mod|op|own|root)|lose(dir)?|onnect|os|rypt)|d(bm(close|open)|efined|elete|ie|o|ump)|e(ach|of|val|x(ec|ists|it|p))|f(cntl|ileno|lock|ork)|get(c|login|peername|pgrp|ppid|priority|pwnam|(host|net|proto|serv)byname|pwuid|grgid|(host|net)byaddr|protobynumber|servbyport)|([gs]et|end)(pw|gr|host|net|proto|serv)ent|getsock(name|opt)|gmtime|goto|grep|hex|index|int|ioctl|join|keys|kill|last|length|link|listen|local(time)?|log|lstat|m|mkdir|msg(ctl|get|snd|rcv)|next|oct|open(dir)?|ord|pack|pipe|pop|printf?|push|q|qq|qx|rand|re(ad(dir|link)?|cv|do|name|quire|set|turn|verse|winddir)|rindex|rmdir|s|scalar|seek|seekdir|se(lect|mctl|mget|mop|nd|tpgrp|tpriority|tsockopt)|shift|shm(ctl|get|read|write)|shutdown|sin|sleep|socket(pair)?|sort|spli(ce|t)|sprintf|sqrt|srand|stat|study|substr|symlink|sys(call|read|tem|write)|tell(dir)?|time|tr|y|truncate|umask|un(def|link|pack|shift)|utime|values|vec|wait(pid)?|wantarray|warn|write)\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(continue|else|elsif|do|for|foreach|if|unless|until|while|eq|ne|lt|gt|le|ge|cmp|x|my|sub|use|package|can|isa)\b'

# Pattern 2: special (root).
rule.2.parent=-1
rule.2.group='special'
rule.2.match='\b(has|is|class|role|given|when|BUILD|multi|returns|method|submethod|slurp|say|sub)\b'

# Pattern 3: identifier (root).
rule.3.parent=-1
rule.3.group='identifier'
rule.3.match='[$@%&](\.|!|\^)?([[:alpha:]]|_)'

# Pattern 4: identifier (root).
rule.4.parent=-1
rule.4.group='identifier'
rule.4.match='[$@%&](\.|!|^)?([[:alpha:]]|_)([[:alnum:]]|-|_)*([[:alnum:]]|_)'

# Pattern 5: identifier (root).
rule.5.parent=-1
rule.5.group='identifier'
rule.5.match='[$@%&](\?|\*)([A-Z])([A-Z]|-)*([A-Z])'

# Region 6: constant.string (root).
rule.6.parent=-1
rule.6.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.6.start='"'
rule.6.end='"'
# Mask escaped text before matching delimiters.
rule.6.skip='\\.'

# Pattern 7: constant.specialChar (inside region 6).
rule.7.parent=6
rule.7.group='constant.specialChar'
rule.7.match='\\.'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start=''''
rule.8.end=''''
# Mask escaped text before matching delimiters.
rule.8.skip='\\.'

# Pattern 9: constant.specialChar (inside region 8).
rule.9.parent=8
rule.9.group='constant.specialChar'
rule.9.match='\\.'

# Region 10: preproc (root).
rule.10.parent=-1
rule.10.group='preproc'
# Start/end delimiters carry state between physical lines.
rule.10.start='(^use| = new)'
rule.10.end=';'

# Region 11: identifier.macro (root).
rule.11.parent=-1
rule.11.group='identifier.macro'
# Start/end delimiters carry state between physical lines.
rule.11.start='<<EOSQL'
rule.11.end='EOSQL'

# Region 12: comment (root).
rule.12.parent=-1
rule.12.group='comment'
# Start/end delimiters carry state between physical lines.
rule.12.start='#'
rule.12.end='$'

# Total flattened rules; update this when adding or removing rules.
rules=13
