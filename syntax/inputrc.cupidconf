# Syntax: inputrc
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='inputrc'

# Detection: filename first, then header and content signature.
detect.filename='inputrc$'

# Pattern 0: constant.bool.false (root).
rule.0.parent=-1
rule.0.group='constant.bool.false'
rule.0.match='\b(off|none)\b'

# Pattern 1: constant.bool.true (root).
rule.1.parent=-1
rule.1.group='constant.bool.true'
rule.1.match='\bon\b'

# Pattern 2: preproc (root).
rule.2.parent=-1
rule.2.group='preproc'
rule.2.match='\bset|\$include\b'

# Pattern 3: constant.string (root).
rule.3.parent=-1
rule.3.group='constant.string'
rule.3.match='"(\\.|[^"])*"|''(\\.|[^''])*'''

# Pattern 4: constant.specialChar (root).
rule.4.parent=-1
rule.4.group='constant.specialChar'
rule.4.match='\\.?'

# Pattern 5: comment (root).
rule.5.parent=-1
rule.5.group='comment'
rule.5.match='(^|[[:space:]])#([^{].*)?$'

# Pattern 6: indent-char.whitespace (root).
rule.6.parent=-1
rule.6.group='indent-char.whitespace'
rule.6.match='[[:space:]]+$'

# Pattern 7: indent-char (root).
rule.7.parent=-1
rule.7.group='indent-char'
rule.7.match='	+ +| +	+'

# Total flattened rules; update this when adding or removing rules.
rules=8
