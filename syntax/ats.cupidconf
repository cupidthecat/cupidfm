# Syntax: ATS
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='ATS'

# Detection: filename first, then header and content signature.
detect.filename='\.(d|h|s)ats$'

# Pattern 0: default (root).
rule.0.parent=-1
rule.0.group='default'
rule.0.match='\b[[:alnum:]]+[^0-9A-Za-z]'

# Pattern 1: symbol.operator (root).
rule.1.parent=-1
rule.1.group='symbol.operator'
rule.1.match='[.:;+`|~<>?=''\&]|/|%|-|,|!|\*|@|\#'

# Pattern 2: symbol.operator (root).
rule.2.parent=-1
rule.2.group='symbol.operator'
rule.2.match='\^'

# Pattern 3: type (root).
rule.3.parent=-1
rule.3.group='type'
rule.3.match='\b(addr|age?z|bool|char|cls|schar|uchar|double|ldouble|eff|exn|float|int(ptr)?|lincloptr|uint)\b'

# Pattern 4: type (root).
rule.4.parent=-1
rule.4.group='type'
rule.4.match='\b(lint|ulint|llint|ullint|nat|ptr|real|ref|size_t|ssize_t|sint|usint|string|tkind|viewt|v?t0p|vt|void)\b'

# Pattern 5: type (root).
rule.5.parent=-1
rule.5.group='type'
rule.5.match='\b(prop|t[@0]ype|type|viewt[@0]ype|viewtype|vt[@0]ype|vtype|view)\b'

# Pattern 6: type (root).
rule.6.parent=-1
rule.6.group='type'
rule.6.match='\b(prop[+-]|t[@0]ype[+-]|type[+-]|viewt[@0]ype[+-]|viewtype[+-]|vt[@0]ype[+-]|vtype[+-]|view[+-])'

# Pattern 7: statement (root).
rule.7.parent=-1
rule.7.group='statement'
rule.7.match='\b(abstype|abst|absprop|absviewt|absvt(ype)?|absview|and|andalso|as|(re)?assume|begin|(pr)?case|s?case)\b'

# Pattern 8: statement (root).
rule.8.parent=-1
rule.8.group='statement'
rule.8.match='\b(classdec|dataprop|data(v|view)?type|dataview|datasort|do|dynload|else|end|exception|extype|extva(r|l)|s?if)\b'

# Pattern 9: statement (root).
rule.9.parent=-1
rule.9.group='statement'
rule.9.match='\b(ifcase|import|for|in|infix(l|r)?|let|local|macrodef|macdef|not|of|op|or|orelse|overload|(pre|post|non)fix)\b'

# Pattern 10: statement (root).
rule.10.parent=-1
rule.10.group='statement'
rule.10.match='\b(propdef|rec|sortdef|stacst|stadef|staload|stavar|sta(tic)?|symelim|symintr|tkindef|then|try|viewdef|v?typedef)\b'

# Pattern 11: statement (root).
rule.11.parent=-1
rule.11.group='statement'
rule.11.match='\b(viewtypedef|(pr)?va(l|r)|when|where|while|with|withtype|withprop|withv(iew)?type|withview)\b'

# Pattern 12: statement (root).
rule.12.parent=-1
rule.12.group='statement'
rule.12.match='\b(abst[@0]ype|absviewt[@0]?ype|absvt[@0]ype|abstbox|abstflat|absvtbox|absvtflat|absimpl|absreimpl|abs)\b'

# Pattern 13: statement (root).
rule.13.parent=-1
rule.13.group='statement'
rule.13.match='\b(case[+-]|(pr)?va(l|r)[+-]|for\*|while\*)'

# Pattern 14: constant.number (root).
rule.14.parent=-1
rule.14.group='constant.number'
rule.14.match='\b[0-9.]+([eE][+-]?[0-9]+)?[fFlL]?\b'

# Pattern 15: constant.number (root).
rule.15.parent=-1
rule.15.group='constant.number'
rule.15.match='\b0[xX][0-9A-Fa-f]*(\.[0-9A-Fa-f]*)?[pP][+-]?[0-9]+[fFlL]?\b'

# Pattern 16: constant.number (root).
rule.16.parent=-1
rule.16.group='constant.number'
rule.16.match='\b([0-9]+|0[xX][0-9A-Fa-f]+)[lLuU]*\b'

# Pattern 17: identifier (root).
rule.17.parent=-1
rule.17.group='identifier'
rule.17.match='\b(fix|(pr)?fu?n|fnx|castfn|praxi|extern|lam|llam|(pr)?implement|(pr)?implmnt)\b'

# Pattern 18: identifier (root).
rule.18.parent=-1
rule.18.group='identifier'
rule.18.match='\b(fix@|fold@|free@|lam@|llam@|addr@|view@|ref@|fn\*)'

# Pattern 19: identifier (root).
rule.19.parent=-1
rule.19.group='identifier'
rule.19.match='\$\w*\b'

# Pattern 20: special (root).
rule.20.parent=-1
rule.20.group='special'
rule.20.match='(\$(arrpsz|arrptrsize|break|continue|d2ctype|delay|effmask_(ntm|exn|ref|wrt|all)))\b'

# Pattern 21: special (root).
rule.21.parent=-1
rule.21.group='special'
rule.21.match='(\$(effmask|extern|extype_struct|extype|extkind|extval|extfcall|extmcall|ldelay|literal))\b'

# Pattern 22: special (root).
rule.22.parent=-1
rule.22.group='special'
rule.22.match='(\$(li?st_vt|li?st_t|li?st|myfilename|myfunction|mylocation|raise|rec(ord)?_vt))\b'

# Pattern 23: special (root).
rule.23.parent=-1
rule.23.group='special'
rule.23.match='(\$(rec(ord)?_t|rec(ord)?|showtype|solver_assert|solver_verify|tempenver))\b'

# Pattern 24: special (root).
rule.24.parent=-1
rule.24.group='special'
rule.24.match='(\$(tup(le)?_vt|tup(le)?_t|tup(le)?|tyrep|vararg|vcopyenv_vt|vcopyenv_v))\b'

# Pattern 25: special (root).
rule.25.parent=-1
rule.25.group='special'
rule.25.match='\!(wrt|exnref|exnwrt|exn|refwrt|ref|all|ntm|laz)\b'

# Pattern 26: special (root).
rule.26.parent=-1
rule.26.group='special'
rule.26.match='\b(fun(0|1)|(lin)?cloptr(0|1)?|cloref(0|1)?|clo(0|1)?|lin|prf)\b'

# Pattern 27: special (root).
rule.27.parent=-1
rule.27.group='special'
rule.27.match='\b(f?print(ln)?!|prerr(ln)?!|tupz!)'

# Pattern 28: preproc (root).
rule.28.parent=-1
rule.28.group='preproc'
rule.28.match='^[[:space:]]*#[[:space:]]*(define|pragma|include|(un|ifn?)def|endif|el(if|se)|if|warning|error|assert)\b'

# Pattern 29: preproc (root).
rule.29.parent=-1
rule.29.group='preproc'
rule.29.match='^[[:space:]]*#[[:space:]]*(codegen2|codegen3|elifdef|elifndef|prerr|print|require|then|staload|dynload)\b'

# Pattern 30: constant.bool (root).
rule.30.parent=-1
rule.30.group='constant.bool'
rule.30.match='\b(true|false|null)\b'

# Region 31: default (root).
rule.31.parent=-1
rule.31.group='default'
# Start/end delimiters carry state between physical lines.
rule.31.start='%{[#^$]?'
rule.31.end='%}'
# Mask escaped text before matching delimiters.
rule.31.skip='\.'
# Delimiters use this group instead of the region body.
rule.31.limit-group='symbol.operator'

# Included language: c. Local rules come first.

# Pattern 32: identifier (inside region 31).
rule.32.parent=31
rule.32.group='identifier'
rule.32.match='\b[A-Z_][0-9A-Z_]+\b'

# Pattern 33: type (inside region 31).
rule.33.parent=31
rule.33.group='type'
rule.33.match='\b(_Atomic|_BitInt|float|double|_Decimal32|_Decimal64|_Decimal128|_Complex|complex|_Imaginary|imaginary|_Bool|bool|char|int|short|long|enum|void|struct|union|typedef|typeof|typeof_unqual|(un)?signed|inline|_Noreturn)\b'

# Pattern 34: type (inside region 31).
rule.34.parent=31
rule.34.group='type'
rule.34.match='\b((s?size)|((u_?)?int(8|16|32|64|ptr))|char(8|16|32)|wchar)_t\b'

# Pattern 35: type (inside region 31).
rule.35.parent=31
rule.35.group='type'
rule.35.match='\b(_Float16|__fp16|_Float32|_Float32x|_Float64|_Float64x|__float80|_Float128|_Float128x|__float128|__ibm128|__int128|_Fract|_Sat|_Accum)\b'

# Pattern 36: type (inside region 31).
rule.36.parent=31
rule.36.group='type'
rule.36.match='\b[a-z_][0-9a-z_]+(_t|_T)\b'

# Pattern 37: statement (inside region 31).
rule.37.parent=31
rule.37.group='statement'
rule.37.match='\b(auto|volatile|register|restrict|_Alignas|alignas|_Alignof|alignof|static|const|constexpr|extern|_Thread_local|thread_local)\b'

# Pattern 38: statement (inside region 31).
rule.38.parent=31
rule.38.group='statement'
rule.38.match='\b(for|if|while|do|else|case|default|switch|_Generic|_Static_assert|static_assert)\b'

# Pattern 39: statement (inside region 31).
rule.39.parent=31
rule.39.group='statement'
rule.39.match='\b(goto|continue|break|return)\b'

# Pattern 40: statement (inside region 31).
rule.40.parent=31
rule.40.group='statement'
rule.40.match='\b(asm|fortran)\b'

# Pattern 41: preproc (inside region 31).
rule.41.parent=31
rule.41.group='preproc'
rule.41.match='^[[:space:]]*#[[:space:]]*(define|embed|pragma|include|(un|ifn?)def|endif|el(if|ifdef|ifndef|se)|if|line|warning|error|__has_include|__has_embed|__has_c_attribute)'

# Pattern 42: preproc (inside region 31).
rule.42.parent=31
rule.42.group='preproc'
rule.42.match='^[[:space:]]*_Pragma\b'

# Pattern 43: statement (inside region 31).
rule.43.parent=31
rule.43.group='statement'
rule.43.match='__attribute__[[:space:]]*\(\([^)]*\)\)'

# Pattern 44: statement (inside region 31).
rule.44.parent=31
rule.44.group='statement'
rule.44.match='__(aligned|asm|builtin|extension|hidden|inline|packed|restrict|section|typeof|weak)__'

# Pattern 45: symbol.operator (inside region 31).
rule.45.parent=31
rule.45.group='symbol.operator'
rule.45.match='[-+*/%=<>.:;,~&|^!?]|\b(offsetof|sizeof)\b'

# Pattern 46: symbol.brackets (inside region 31).
rule.46.parent=31
rule.46.group='symbol.brackets'
rule.46.match='[(){}]|\[|\]'

# Pattern 47: constant.number (inside region 31).
rule.47.parent=31
rule.47.group='constant.number'
rule.47.match='(\b([1-9][0-9]*|0[0-7]*|0[Xx][0-9A-Fa-f]+|0[Bb][01]+)([Uu][Ll]?[Ll]?|[Ll][Ll]?[Uu]?)?\b)'

# Pattern 48: constant.number (inside region 31).
rule.48.parent=31
rule.48.group='constant.number'
rule.48.match='(\b(([0-9]*[.][0-9]+|[0-9]+[.][0-9]*)([Ee][+-]?[0-9]+)?|[0-9]+[Ee][+-]?[0-9]+)[FfLl]?\b)'

# Pattern 49: constant.number (inside region 31).
rule.49.parent=31
rule.49.group='constant.number'
rule.49.match='(\b0[Xx]([0-9A-Za-z]*[.][0-9A-Za-z]+|[0-9A-Za-z]+[.][0-9A-Za-z]*)[Pp][+-]?[0-9]+[FfLl]?\b)'

# Pattern 50: constant.bool (inside region 31).
rule.50.parent=31
rule.50.group='constant.bool'
rule.50.match='(\b(true|false|NULL|nullptr|TRUE|FALSE)\b)'

# Region 51: constant.string (inside region 31).
rule.51.parent=31
rule.51.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.51.start='"'
rule.51.end='"'
# Mask escaped text before matching delimiters.
rule.51.skip='\\.'

# Pattern 52: constant.specialChar (inside region 51).
rule.52.parent=51
rule.52.group='constant.specialChar'
rule.52.match='\\(["''abfnrtv\\]|[0-3]?[0-7]{1,2}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'

# Region 53: constant.string (inside region 31).
rule.53.parent=31
rule.53.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.53.start=''''
rule.53.end=''''
# Mask escaped text before matching delimiters.
rule.53.skip='\\.'

# Pattern 54: error (inside region 53).
rule.54.parent=53
rule.54.group='error'
rule.54.match='[[:graph:]]{2,}'''

# Pattern 55: constant.specialChar (inside region 53).
rule.55.parent=53
rule.55.group='constant.specialChar'
rule.55.match='\\(["''abfnrtv\\]|[0-3]?[0-7]{1,2}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'

# Region 56: comment (inside region 31).
rule.56.parent=31
rule.56.group='comment'
# Start/end delimiters carry state between physical lines.
rule.56.start='//'
rule.56.end='$'

# Pattern 57: todo (inside region 56).
rule.57.parent=56
rule.57.group='todo'
rule.57.match='(TODO|XXX|FIXME):?'

# Region 58: comment (inside region 31).
rule.58.parent=31
rule.58.group='comment'
# Start/end delimiters carry state between physical lines.
rule.58.start='/\*'
rule.58.end='\*/'

# Pattern 59: todo (inside region 58).
rule.59.parent=58
rule.59.group='todo'
rule.59.match='(TODO|XXX|FIXME):?'

# Included language: javascript. Local rules come first.

# Pattern 60: constant.number (inside region 31).
rule.60.parent=31
rule.60.group='constant.number'
rule.60.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 61: constant.number (inside region 31).
rule.61.parent=31
rule.61.group='constant.number'
rule.61.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 62: constant.number (inside region 31).
rule.62.parent=31
rule.62.group='constant.number'
rule.62.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 63: symbol.brackets (inside region 31).
rule.63.parent=31
rule.63.group='symbol.brackets'
rule.63.match='[(){}]|\[|\]'

# Pattern 64: symbol.operator (inside region 31).
rule.64.parent=31
rule.64.group='symbol.operator'
rule.64.match='([-+/*=<>!~%?:&|]|[.]{3})'

# Pattern 65: statement (inside region 31).
rule.65.parent=31
rule.65.group='statement'
rule.65.match='\b(async|await|break|case|catch|const|continue|debugger|default)\b'

# Pattern 66: statement (inside region 31).
rule.66.parent=31
rule.66.group='statement'
rule.66.match='\b(delete|do|else|export|finally|for|function\*?|class|extends)\b'

# Pattern 67: statement (inside region 31).
rule.67.parent=31
rule.67.group='statement'
rule.67.match='\b(get|if|import|from|in|of|instanceof|let|new|reject|resolve|return)\b'

# Pattern 68: statement (inside region 31).
rule.68.parent=31
rule.68.group='statement'
rule.68.match='\b(set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield)\b'

# Pattern 69: error (inside region 31).
rule.69.parent=31
rule.69.group='error'
rule.69.match='\b(enum|implements|interface|package|private|protected|public)\b'

# Pattern 70: constant (inside region 31).
rule.70.parent=31
rule.70.group='constant'
rule.70.match='\b(globalThis|Infinity|null|undefined|NaN)\b'

# Pattern 71: constant (inside region 31).
rule.71.parent=31
rule.71.group='constant'
rule.71.match='\b(null|undefined|NaN)\b'

# Pattern 72: constant (inside region 31).
rule.72.parent=31
rule.72.group='constant'
rule.72.match='\b(true|false)\b'

# Pattern 73: type (inside region 31).
rule.73.parent=31
rule.73.group='type'
rule.73.match='\b(Array|Boolean|Date|Enumerator|Error|Function|Generator|Map|Math)\b'

# Pattern 74: type (inside region 31).
rule.74.parent=31
rule.74.group='type'
rule.74.match='\b(Number|Object|Promise|Proxy|Reflect|RegExp|Set|String|Symbol|WeakMap|WeakSet)\b'

# Pattern 75: type (inside region 31).
rule.75.parent=31
rule.75.group='type'
rule.75.match='\b(BigInt64Array|BigUint64Array|Float32Array|Float64Array|Int16Array)\b'

# Pattern 76: constant (inside region 31).
rule.76.parent=31
rule.76.group='constant'
rule.76.match='\\[0-7][0-7]?[0-7]?|\\x[0-9a-fA-F]+|\\[bfnrt''"\?\\]'

# Pattern 77: comment (inside region 31).
rule.77.parent=31
rule.77.group='comment'
rule.77.match='^#!.*/(env +)?node( |$)'

# Pattern 78: identifier (inside region 31).
rule.78.parent=31
rule.78.group='identifier'
rule.78.match='\b(alert|decodeURI|decodeURIComponent|document|encodeURI|encodeURIComponent|escape|eval|isFinite|isNaN|parseFloat|parseInt|unescape|uneval|window)\b'

# Pattern 79: identifier (inside region 31).
rule.79.parent=31
rule.79.group='identifier'
rule.79.match='\b(Intl|WebAssembly)\b'

# Pattern 80: identifier (inside region 31).
rule.80.parent=31
rule.80.group='identifier'
rule.80.match='\b(Arguments)\b'

# Region 81: constant.string (inside region 31).
rule.81.parent=31
rule.81.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.81.start='"'
rule.81.end='"'
# Mask escaped text before matching delimiters.
rule.81.skip='\\.'

# Pattern 82: constant.specialChar (inside region 81).
rule.82.parent=81
rule.82.group='constant.specialChar'
rule.82.match='\\.'

# Region 83: constant.string (inside region 31).
rule.83.parent=31
rule.83.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.83.start=''''
rule.83.end=''''
# Mask escaped text before matching delimiters.
rule.83.skip='\\.'

# Pattern 84: constant.specialChar (inside region 83).
rule.84.parent=83
rule.84.group='constant.specialChar'
rule.84.match='\\.'

# Region 85: constant.string (inside region 31).
rule.85.parent=31
rule.85.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.85.start='`'
rule.85.end='`'

# Pattern 86: constant.specialChar (inside region 85).
rule.86.parent=85
rule.86.group='constant.specialChar'
rule.86.match='\\.'

# Pattern 87: identifier (inside region 85).
rule.87.parent=85
rule.87.group='identifier'
rule.87.match='\x24\{.*?\}'

# Pattern 88: constant.bool (inside region 31).
rule.88.parent=31
rule.88.group='constant.bool'
rule.88.match='\b(true|false)\b'

# Pattern 89: constant.bool.false (inside region 31).
rule.89.parent=31
rule.89.group='constant.bool.false'
rule.89.match='\b(false)\b'

# Pattern 90: constant.bool.true (inside region 31).
rule.90.parent=31
rule.90.group='constant.bool.true'
rule.90.match='\b(true)\b'

# Region 91: comment (inside region 31).
rule.91.parent=31
rule.91.group='comment'
# Start/end delimiters carry state between physical lines.
rule.91.start='//'
rule.91.end='$'

# Pattern 92: todo (inside region 91).
rule.92.parent=91
rule.92.group='todo'
rule.92.match='(TODO|XXX|FIXME)'

# Region 93: comment (inside region 31).
rule.93.parent=31
rule.93.group='comment'
# Start/end delimiters carry state between physical lines.
rule.93.start='/\*'
rule.93.end='\*/'
# Mask escaped text before matching delimiters.
rule.93.skip='\\.'

# Pattern 94: constant.specialChar (inside region 93).
rule.94.parent=93
rule.94.group='constant.specialChar'
rule.94.match='\\.'

# Pattern 95: identifier (inside region 93).
rule.95.parent=93
rule.95.group='identifier'
rule.95.match='\s\*\s.*'

# Pattern 96: todo (inside region 93).
rule.96.parent=93
rule.96.group='todo'
rule.96.match='(TODO|XXX|FIXME)'

# Pattern 97: constant.string (root).
rule.97.parent=-1
rule.97.group='constant.string'
rule.97.match='\"[^"]*\"'

# Pattern 98: constant.string (root).
rule.98.parent=-1
rule.98.group='constant.string'
rule.98.match='\''[^'']*\'''

# Region 99: comment.block (root).
rule.99.parent=-1
rule.99.group='comment.block'
# Start/end delimiters carry state between physical lines.
rule.99.start='////'
rule.99.end='$a'

# Pattern 100: todo (inside region 99).
rule.100.parent=99
rule.100.group='todo'
rule.100.match='(TODO|XXX|FIXME)'

# Region 101: comment.line (root).
rule.101.parent=-1
rule.101.group='comment.line'
# Start/end delimiters carry state between physical lines.
rule.101.start='//'
rule.101.end='$'

# Pattern 102: todo (inside region 101).
rule.102.parent=101
rule.102.group='todo'
rule.102.match='(TODO|XXX|FIXME)'

# Region 103: comment.block (root).
rule.103.parent=-1
rule.103.group='comment.block'
# Start/end delimiters carry state between physical lines.
rule.103.start='\(\*'
rule.103.end='\*\)'

# Pattern 104: todo (inside region 103).
rule.104.parent=103
rule.104.group='todo'
rule.104.match='(TODO|XXX|FIXME)'

# Region 105: comment.block (root).
rule.105.parent=-1
rule.105.group='comment.block'
# Start/end delimiters carry state between physical lines.
rule.105.start='/\*'
rule.105.end='\*\/'

# Pattern 106: todo (inside region 105).
rule.106.parent=105
rule.106.group='todo'
rule.106.match='(TODO|XXX|FIXME)'

# Total flattened rules; update this when adding or removing rules.
rules=107
