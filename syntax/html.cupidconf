# Pattern 55: special (inside region 52).
rule.55.parent=52
rule.55.group='special'
rule.55.match='!important'

# Pattern 56: identifier (inside region 52).
rule.56.parent=52
rule.56.group='identifier'
rule.56.match=':active|:focus|:hover|:link|:visited|:link|:after|:before|$'

# Pattern 57: special (inside region 52).
rule.57.parent=52
rule.57.group='special'
rule.57.match='(\{|\}|\(|\)|\;|:|\]|~|<|>|,)'

# Pattern 58: statement (inside region 52).
rule.58.parent=52
rule.58.group='statement'
rule.58.match='@import|@mixin|@extend'

# Region 59: constant.string (inside region 52).
rule.59.parent=52
rule.59.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.59.start='"'
rule.59.end='"'
# Mask escaped text before matching delimiters.
rule.59.skip='\\.'

# Pattern 60: constant.specialChar (inside region 59).
rule.60.parent=59
rule.60.group='constant.specialChar'
rule.60.match='\\.'

# Region 61: constant.string (inside region 52).
rule.61.parent=52
rule.61.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.61.start=''''
rule.61.end=''''
# Mask escaped text before matching delimiters.
rule.61.skip='\\.'

# Pattern 62: constant.specialChar (inside region 61).
rule.62.parent=61
rule.62.group='constant.specialChar'
rule.62.match='\\.'

# Pattern 63: special (inside region 52).
rule.63.parent=52
rule.63.group='special'
rule.63.match='"|'''

# Region 64: comment (inside region 52).
rule.64.parent=52
rule.64.group='comment'
# Start/end delimiters carry state between physical lines.
rule.64.start='\/\*'
rule.64.end='\*\/'

# Pattern 65: todo (inside region 64).
rule.65.parent=64
rule.65.group='todo'
rule.65.match='(TODO|XXX|FIXME):?'

# Pattern 66: comment (root).
rule.66.parent=-1
rule.66.group='comment'
rule.66.match='<!>'

# Region 67: comment.block (root).
rule.67.parent=-1
rule.67.group='comment.block'
# Start/end delimiters carry state between physical lines.
rule.67.start='<!\-\-'
rule.67.end='\-\->'

# Pattern 68: todo (inside region 67).
rule.68.parent=67
rule.68.group='todo'
rule.68.match='(FIXME|NOTE|TODO):?'

# Pattern 69: error (inside region 67).
rule.69.parent=67
rule.69.group='error'
rule.69.match='(\-\-|>)'

# Total flattened rules; update this when adding or removing rules.
rules=70
