# Syntax: git-commit
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='git-commit'

# Detection: filename first, then header and content signature.
detect.filename='^(.*[\\/])?(COMMIT_EDITMSG|TAG_EDITMSG|MERGE_MSG)$'

# Pattern 0: type.keyword (root).
rule.0.parent=-1
rule.0.group='type.keyword'
rule.0.match='#[[:space:]](deleted|modified|new file|renamed):[[:space:]].*'

# Pattern 1: type.keyword (root).
rule.1.parent=-1
rule.1.group='type.keyword'
rule.1.match='#[[:space:]]deleted:'

# Pattern 2: type.keyword (root).
rule.2.parent=-1
rule.2.group='type.keyword'
rule.2.match='#[[:space:]]modified:'

# Pattern 3: type.keyword (root).
rule.3.parent=-1
rule.3.group='type.keyword'
rule.3.match='#[[:space:]]new file:'

# Pattern 4: type.keyword (root).
rule.4.parent=-1
rule.4.group='type.keyword'
rule.4.match='#[[:space:]]renamed:'

# Pattern 5: type.keyword (root).
rule.5.parent=-1
rule.5.group='type.keyword'
rule.5.match='^#[[:space:]]Changes.*[:]'

# Pattern 6: type.keyword (root).
rule.6.parent=-1
rule.6.group='type.keyword'
rule.6.match='^#[[:space:]]Your branch and ''[^'']+'

# Pattern 7: type.keyword (root).
rule.7.parent=-1
rule.7.group='type.keyword'
rule.7.match='^#[[:space:]]Your branch and '''

# Pattern 8: type.keyword (root).
rule.8.parent=-1
rule.8.group='type.keyword'
rule.8.match='^#[[:space:]]On branch [^ ]+'

# Pattern 9: type.keyword (root).
rule.9.parent=-1
rule.9.group='type.keyword'
rule.9.match='^#[[:space:]]On branch'

# Pattern 10: type.keyword (root).
rule.10.parent=-1
rule.10.group='type.keyword'
rule.10.match='\b(?i)((fix(es|ed)?|close(s|d)?) #[0-9]+)\b'

# Region 11: comment.line (root).
rule.11.parent=-1
rule.11.group='comment.line'
# Start/end delimiters carry state between physical lines.
rule.11.start='^#'
rule.11.end='$'

# Region 12: default (root).
rule.12.parent=-1
rule.12.group='default'
# Start/end delimiters carry state between physical lines.
rule.12.start='^diff --git'
rule.12.end='^ENDOFFILE'

# Included language: patch. Local rules come first.

# Pattern 13: brightgreen (inside region 12).
rule.13.parent=12
rule.13.group='brightgreen'
rule.13.match='^\+.*'

# Pattern 14: green (inside region 12).
rule.14.parent=12
rule.14.group='green'
rule.14.match='^\+\+\+.*'

# Pattern 15: brightblue (inside region 12).
rule.15.parent=12
rule.15.group='brightblue'
rule.15.match='^ .*'

# Pattern 16: brightred (inside region 12).
rule.16.parent=12
rule.16.group='brightred'
rule.16.match='^-.*'

# Pattern 17: red (inside region 12).
rule.17.parent=12
rule.17.group='red'
rule.17.match='^---.*'

# Pattern 18: brightyellow (inside region 12).
rule.18.parent=12
rule.18.group='brightyellow'
rule.18.match='^@@.*'

# Pattern 19: magenta (inside region 12).
rule.19.parent=12
rule.19.group='magenta'
rule.19.match='^diff.*'

# Total flattened rules; update this when adding or removing rules.
rules=20
