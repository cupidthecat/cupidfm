# Syntax: zig
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='zig'

# Detection: filename first, then header and content signature.
detect.filename='\.z(ig|on)$'

# Pattern 0: statement (root).
rule.0.parent=-1
rule.0.group='statement'
rule.0.match='\b(addrspace|align|allowzero|and|asm|async|await|break|callconv|catch|comptime|const|continue|defer|else|errdefer|error|export|extern|fn|for|if|inline|noalias|noinline|nosuspend|or|orelse|packed|pub|resume|return|linksection|suspend|switch|test|threadlocal|try|unreachable|usingnamespace|var|volatile|while)\b'

# Pattern 1: special (root).
rule.1.parent=-1
rule.1.group='special'
rule.1.match='@[a-zA-Z_]+'

# Pattern 2: type (root).
rule.2.parent=-1
rule.2.group='type'
rule.2.match='\b(anyframe|anytype|anyerror|anyopaque|bool|comptime_int|comptime_float|enum|f(16|32|64|80|128)|i(8|16|32|64|128)|isize|noreturn|opaque|struct|type|union|u(8|16|32|64|128)|usize|void)\b'

# Pattern 3: type (root).
rule.3.parent=-1
rule.3.group='type'
rule.3.match='\b(c_u?(short|int|long(long)?)|c_longdouble|c_void)\b'

# Pattern 4: symbol.operator (root).
rule.4.parent=-1
rule.4.group='symbol.operator'
rule.4.match='[-!|=;%.+^*:&?<>~]'

# Pattern 5: symbol.brackets (root).
rule.5.parent=-1
rule.5.group='symbol.brackets'
rule.5.match='[(){}]|\[|\]'

# Pattern 6: constant (root).
rule.6.parent=-1
rule.6.group='constant'
rule.6.match='\b(null|undefined)\b'

# Pattern 7: constant.number (root).
rule.7.parent=-1
rule.7.group='constant.number'
rule.7.match='\b(0b[01_]+|0o[0-7_]+|[0-9_]+|0x[a-fA-F0-9_]+)\b'

# Pattern 8: constant.bool (root).
rule.8.parent=-1
rule.8.group='constant.bool'
rule.8.match='\b(true|false)\b'

# Region 9: constant.string (root).
rule.9.parent=-1
rule.9.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.9.start='"'
rule.9.end='"'
# Mask escaped text before matching delimiters.
rule.9.skip='\\.'

# Pattern 10: constant.specialChar (inside region 9).
rule.10.parent=9
rule.10.group='constant.specialChar'
rule.10.match='\\([nrt\\''"]|x[a-fA-F0-9]{2}|u{[a-fA-F0-9]+})'

# Region 11: constant.string (root).
rule.11.parent=-1
rule.11.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.11.start=''''
rule.11.end=''''
# Mask escaped text before matching delimiters.
rule.11.skip='\\.'

# Pattern 12: error (inside region 11).
rule.12.parent=11
rule.12.group='error'
rule.12.match='..+'

# Pattern 13: constant.specialChar (inside region 11).
rule.13.parent=11
rule.13.group='constant.specialChar'
rule.13.match='\\([nrt\\''"]|x[a-fA-F0-9]{2}|u{[a-fA-F0-9]+})'

# Region 14: constant.string (root).
rule.14.parent=-1
rule.14.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.14.start='\\\\'
rule.14.end='$'
# Mask escaped text before matching delimiters.
rule.14.skip='\\.'

# Pattern 15: constant.specialChar (inside region 14).
rule.15.parent=14
rule.15.group='constant.specialChar'
rule.15.match='\\([nrt\\''"]|x[a-fA-F0-9]{2}|u{[a-fA-F0-9]+})'

# Region 16: comment (root).
rule.16.parent=-1
rule.16.group='comment'
# Start/end delimiters carry state between physical lines.
rule.16.start='//'
rule.16.end='$'

# Pattern 17: todo (inside region 16).
rule.17.parent=16
rule.17.group='todo'
rule.17.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=18
