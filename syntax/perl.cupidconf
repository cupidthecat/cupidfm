# Syntax: perl
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='perl'

# Detection: filename first, then header and content signature.
detect.filename='\.p[lmp]$'
detect.header='^#!.*/(env +)?perl( |$)'

# Pattern 0: type (root).
rule.0.parent=-1
rule.0.group='type'
rule.0.match='\b(accept|alarm|atan2|bin(d|mode)|c(aller|homp|h(dir|mod|op|own|root)|lose(dir)?|onnect|os|rypt)|d(bm(close|open)|efined|elete|ie|o|ump)|e(ach|of|val|x(ec|ists|it|p))|f(cntl|ileno|lock|ork))\b|\b(get(c|login|peername|pgrp|ppid|priority|pwnam|(host|net|proto|serv)byname|pwuid|grgid|(host|net)byaddr|protobynumber|servbyport)|([gs]et|end)(pw|gr|host|net|proto|serv)ent|getsock(name|opt)|gmtime|goto|grep|hex|index|int|ioctl|join)\b|\b(keys|kill|last|length|link|listen|local(time)?|log|lstat|m|mkdir|msg(ctl|get|snd|rcv)|next|oct|open(dir)?|ord|pack|pipe|pop|printf?|push|q|qq|qx|rand|re(ad(dir|link)?|cv|say|do|name|quire|set|turn|verse|winddir)|rindex|rmdir|s|scalar|seek(dir)?)\b|\b(se(lect|mctl|mget|mop|nd|tpgrp|tpriority|tsockopt)|shift|shm(ctl|get|read|write)|shutdown|sin|sleep|socket(pair)?|sort|spli(ce|t)|sprintf|sqrt|srand|stat|study|substr|symlink|sys(call|read|tem|write)|tell(dir)?|time|tr(y)?|truncate|umask)\b|\b(un(def|link|pack|shift)|utime|values|vec|wait(pid)?|wantarray|warn|write)\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(continue|else|elsif|do|for|foreach|if|unless|until|while|eq|ne|lt|gt|le|ge|cmp|x|my|sub|use|package|can|isa)\b'

# Pattern 2: special (root).
rule.2.parent=-1
rule.2.group='special'
rule.2.match='\-\>'

# Pattern 3: symbol (root).
rule.3.parent=-1
rule.3.group='symbol'
rule.3.match='(,|\.)'

# Pattern 4: identifier.macro (root).
rule.4.parent=-1
rule.4.group='identifier.macro'
rule.4.match='m?\/.*?\/[a-z]*'

# Pattern 5: identifier.macro (root).
rule.5.parent=-1
rule.5.group='identifier.macro'
rule.5.match='m?\|.*?\|[a-z]*'

# Pattern 6: identifier.macro (root).
rule.6.parent=-1
rule.6.group='identifier.macro'
rule.6.match='\bs/.*?/.*?/[a-z]*'

# Pattern 7: identifier.macro (root).
rule.7.parent=-1
rule.7.group='identifier.macro'
rule.7.match='\bs\|.*?\|.*?\|[a-z]*'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start='"'
rule.8.end='"'
# Mask escaped text before matching delimiters.
rule.8.skip='\\"'

# Pattern 9: identifier.var (inside region 8).
rule.9.parent=8
rule.9.group='identifier.var'
rule.9.match='[\\$@%].[a-zA-Z0-9_]*'

# Region 10: constant.string (root).
rule.10.parent=-1
rule.10.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.10.start=''''
rule.10.end=''''
# Mask escaped text before matching delimiters.
rule.10.skip='\\'''

# Region 11: comment (root).
rule.11.parent=-1
rule.11.group='comment'
# Start/end delimiters carry state between physical lines.
rule.11.start='#'
rule.11.end='$'

# Pattern 12: constant.string (root).
rule.12.parent=-1
rule.12.group='constant.string'
rule.12.match='"\(.*\)"|qq?\|.*\||qq?\{.*\}|qq?\/.*\/'

# Pattern 13: constant.number (root).
rule.13.parent=-1
rule.13.group='constant.number'
rule.13.match='\b([0-9]*[.])?[0-9]+'

# Pattern 14: constant.number (root).
rule.14.parent=-1
rule.14.group='constant.number'
rule.14.match='\b[0-9]+'

# Pattern 15: constant.number (root).
rule.15.parent=-1
rule.15.group='constant.number'
rule.15.match='\b0x[a-f0-9]+'

# Pattern 16: constant.string.url (root).
rule.16.parent=-1
rule.16.group='constant.string.url'
rule.16.match='`(.+?)`'

# Pattern 17: identifier.var (root).
rule.17.parent=-1
rule.17.group='identifier.var'
rule.17.match='[\\$@%].[a-zA-Z0-9_]*'

# Region 18: preproc (root).
rule.18.parent=-1
rule.18.group='preproc'
# Start/end delimiters carry state between physical lines.
rule.18.start='(^use| = new)'
rule.18.end=';'

# Region 19: comment (root).
rule.19.parent=-1
rule.19.group='comment'
# Start/end delimiters carry state between physical lines.
rule.19.start='^='
rule.19.end='^=cut'

# Region 20: identifier.macro (root).
rule.20.parent=-1
rule.20.group='identifier.macro'
# Start/end delimiters carry state between physical lines.
rule.20.start='<< ''STOP'''
rule.20.end='STOP'

# Total flattened rules; update this when adding or removing rules.
rules=21
