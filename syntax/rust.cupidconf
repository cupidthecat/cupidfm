# Syntax: rust
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='rust'

# Detection: filename first, then header and content signature.
detect.filename='\.rs$'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='fn [a-z0-9_]+'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(abstract|alignof|as|async|await|become|box|break|const|continue|crate|do|dyn|else|enum|extern|false|final|fn|for|gen|if|impl|in|let|loop|macro|match|mod|move|mut|offsetof|override|priv|pub|pure|ref|return|sizeof|static|self|struct|super|true|trait|type|typeof|try|union|unsafe|unsized|use|virtual|where|while|yield)\b'

# Pattern 2: special (root).
rule.2.parent=-1
rule.2.group='special'
rule.2.match='[a-z_]+!'

# Pattern 3: constant (root).
rule.3.parent=-1
rule.3.group='constant'
rule.3.match='\b[A-Z][A-Z_0-9]+\b'

# Pattern 4: constant.number (root).
rule.4.parent=-1
rule.4.group='constant.number'
rule.4.match='\b[0-9]+\b'

# Pattern 5: constant (root).
rule.5.parent=-1
rule.5.group='constant'
rule.5.match='\b(true|false)\b'

# Pattern 6: type (root).
rule.6.parent=-1
rule.6.group='type'
rule.6.match='\b[A-Z]+[a-zA-Z_0-9]*[a-z]+[a-zA-Z_0-9]*\b'

# Pattern 7: type (root).
rule.7.parent=-1
rule.7.group='type'
rule.7.match='\b(bool|str|char|((i|u)(8|16|32|64|128|size))|f(16|32|64|128))\b'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start='[bc]?"'
rule.8.end='"'
# Mask escaped text before matching delimiters.
rule.8.skip='\\.'

# Pattern 9: constant.specialChar (inside region 8).
rule.9.parent=8
rule.9.group='constant.specialChar'
rule.9.match='\\.'

# Region 10: constant.string (root).
rule.10.parent=-1
rule.10.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.10.start='[bc]?r#"'
rule.10.end='"#'

# Region 11: constant.string (root).
rule.11.parent=-1
rule.11.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.11.start='[bc]?r##"'
rule.11.end='"##'

# Region 12: constant.string (root).
rule.12.parent=-1
rule.12.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.12.start='[bc]?r###"'
rule.12.end='"###'

# Region 13: constant.string (root).
rule.13.parent=-1
rule.13.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.13.start='[bc]?r####+"'
rule.13.end='"####+'

# Pattern 14: constant.string (root).
rule.14.parent=-1
rule.14.group='constant.string'
rule.14.match='''(\\.|.)'''

# Region 15: constant.string (root).
rule.15.parent=-1
rule.15.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.15.start='''"'
rule.15.end=''''

# Region 16: comment (root).
rule.16.parent=-1
rule.16.group='comment'
# Start/end delimiters carry state between physical lines.
rule.16.start='//'
rule.16.end='$'

# Pattern 17: todo (inside region 16).
rule.17.parent=16
rule.17.group='todo'
rule.17.match='(TODO|XXX|FIXME):?'

# Region 18: comment (root).
rule.18.parent=-1
rule.18.group='comment'
# Start/end delimiters carry state between physical lines.
rule.18.start='/\*'
rule.18.end='\*/'

# Pattern 19: todo (inside region 18).
rule.19.parent=18
rule.19.group='todo'
rule.19.match='(TODO|XXX|FIXME):?'

# Region 20: special (root).
rule.20.parent=-1
rule.20.group='special'
# Start/end delimiters carry state between physical lines.
rule.20.start='#!\['
rule.20.end='\]'

# Total flattened rules; update this when adding or removing rules.
rules=21
