# Syntax: cmake
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='cmake'

# Detection: filename first, then header and content signature.
detect.filename='(CMakeLists\.txt|\.cmake)$'

# Pattern 0: identifier.var (root).
rule.0.parent=-1
rule.0.group='identifier.var'
rule.0.match='^[[:space:]]*[A-Z0-9_]+'

# Pattern 1: preproc (root).
rule.1.parent=-1
rule.1.group='preproc'
rule.1.match='^[[:space:]]*(include|include_directories|include_external_msproject)\b'

# Pattern 2: statement (root).
rule.2.parent=-1
rule.2.group='statement'
rule.2.match='^[[:space:]]*\b((else|end)?if|else|(end)?while|(end)?foreach|break)\b'

# Pattern 3: statement (root).
rule.3.parent=-1
rule.3.group='statement'
rule.3.match='\b(COPY|NOT|COMMAND|PROPERTY|POLICY|TARGET|EXISTS|IS_(DIRECTORY|ABSOLUTE)|DEFINED)\b[[:space:]]'

# Pattern 4: statement (root).
rule.4.parent=-1
rule.4.group='statement'
rule.4.match='[[:space:]]\b(OR|AND|IS_NEWER_THAN|MATCHES|(STR|VERSION_)?(LESS|GREATER|EQUAL))\b[[:space:]]'

# Pattern 5: special (root).
rule.5.parent=-1
rule.5.group='special'
rule.5.match='^[[:space:]]*\b((end)?(function|macro)|return)'

# Region 6: constant.string (root).
rule.6.parent=-1
rule.6.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.6.start='"'
rule.6.end='"'
# Mask escaped text before matching delimiters.
rule.6.skip='\\.'

# Pattern 7: constant.specialChar (inside region 6).
rule.7.parent=6
rule.7.group='constant.specialChar'
rule.7.match='\\.'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start=''''
rule.8.end=''''
# Mask escaped text before matching delimiters.
rule.8.skip='\\.'

# Pattern 9: constant.specialChar (inside region 8).
rule.9.parent=8
rule.9.group='constant.specialChar'
rule.9.match='\\.'

# Region 10: preproc (root).
rule.10.parent=-1
rule.10.group='preproc'
# Start/end delimiters carry state between physical lines.
rule.10.start='\$(\{|ENV\{)'
rule.10.end='\}'

# Pattern 11: identifier.macro (root).
rule.11.parent=-1
rule.11.group='identifier.macro'
rule.11.match='\b(APPLE|UNIX|WIN32|CYGWIN|BORLAND|MINGW|MSVC(_IDE|60|71|80|90)?)\b'

# Region 12: comment (root).
rule.12.parent=-1
rule.12.group='comment'
# Start/end delimiters carry state between physical lines.
rule.12.start='#'
rule.12.end='$'

# Pattern 13: todo (inside region 12).
rule.13.parent=12
rule.13.group='todo'
rule.13.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=14
