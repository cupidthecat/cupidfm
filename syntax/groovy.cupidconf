# Syntax: groovy
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='groovy'

# Detection: filename first, then header and content signature.
detect.filename='(\.(groovy|gy|gvy|gsh|gradle)$|^[Jj]enkinsfile$)'
detect.header='^#!.*/(env +)?groovy *$'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='\b[A-Z_$]+\b'

# Pattern 1: identifier.class (root).
rule.1.parent=-1
rule.1.group='identifier.class'
rule.1.match='\b[A-Z][a-zA-Z0-9$]+\b'

# Pattern 2: type (root).
rule.2.parent=-1
rule.2.group='type'
rule.2.match='\b(byte|short|int|long|float|double|char|boolean|void)\b'

# Pattern 3: type.keyword (root).
rule.3.parent=-1
rule.3.group='type.keyword'
rule.3.match='\b(private|public|protected|static|final|var|def)\b'

# Pattern 4: statement (root).
rule.4.parent=-1
rule.4.group='statement'
rule.4.match='\b(for|while|do|if|else|switch|case|default|try|catch|finally)\b'

# Pattern 5: statement (root).
rule.5.parent=-1
rule.5.group='statement'
rule.5.match='\b(break|continue|return|throw|assert)\b'

# Pattern 6: statement (root).
rule.6.parent=-1
rule.6.group='statement'
rule.6.match='\b(package|import|class|interface|trait|enum|extends|implements|throws)\b'

# Pattern 7: statement (root).
rule.7.parent=-1
rule.7.group='statement'
rule.7.match='\b(this|super)\b'

# Pattern 8: statement (root).
rule.8.parent=-1
rule.8.group='statement'
rule.8.match='\b(goto|const)\b'

# Pattern 9: symbol.operator (root).
rule.9.parent=-1
rule.9.group='symbol.operator'
rule.9.match='[-+*/%=<>^~&|!?:;,.@]|\b(in|is|as|instanceof|new)\b'

# Pattern 10: symbol.brackets (root).
rule.10.parent=-1
rule.10.group='symbol.brackets'
rule.10.match='[(){}]|\[|\]'

# Pattern 11: constant.number (root).
rule.11.parent=-1
rule.11.group='constant.number'
rule.11.match='(?i)\b[1-9]([_0-9]*[0-9])?[GLIDF]?\b'

# Pattern 12: constant.number (root).
rule.12.parent=-1
rule.12.group='constant.number'
rule.12.match='(?i)\b0b[01]([01_]*[01])?[GLIDF]?\b'

# Pattern 13: constant.number (root).
rule.13.parent=-1
rule.13.group='constant.number'
rule.13.match='(?i)\b0[0-7]([0-7_]*[0-7])?[GLIDF]?\b'

# Pattern 14: constant.number (root).
rule.14.parent=-1
rule.14.group='constant.number'
rule.14.match='(?i)\b0x[0-9a-fA-F]([0-9a-f_]*[0-9a-fA-F])?[GLIDF]?\b'

# Pattern 15: constant.number (root).
rule.15.parent=-1
rule.15.group='constant.number'
rule.15.match='(?i)\b[0-9]([0-9_]*[0-9])?([.][0-9]([0-9_]*[0-9])?)?(e[+-]?[0-9]([0-9_]*[0-9])?)?[DF]?\b'

# Pattern 16: constant.bool (root).
rule.16.parent=-1
rule.16.group='constant.bool'
rule.16.match='\b(true|false|null)\b'

# Pattern 17: identifier (root).
rule.17.parent=-1
rule.17.group='identifier'
rule.17.match='@[A-Za-z_$][A-Za-z0-9_$]*\b'

# Region 18: constant.string (root).
rule.18.parent=-1
rule.18.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.18.start='"""'
rule.18.end='"""'
# Mask escaped text before matching delimiters.
rule.18.skip='\\.'

# Pattern 19: constant.specialChar (inside region 18).
rule.19.parent=18
rule.19.group='constant.specialChar'
rule.19.match='\\(["''bfnrst\x24\\]|u[a-fA-F0-9]{4})'

# Pattern 20: identifier.var (inside region 18).
rule.20.parent=18
rule.20.group='identifier.var'
rule.20.match='\x24[\wÀ-ÖØ-öø-ÿĀ-￾]+([.][a-zA-Z0-9_À-ÖØ-öø-ÿĀ-￾]+)*'

# Region 21: identifier (inside region 18).
rule.21.parent=18
rule.21.group='identifier'
# Start/end delimiters carry state between physical lines.
rule.21.start='[$][{]'
rule.21.end='[}]'

# Region 22: constant.string (root).
rule.22.parent=-1
rule.22.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.22.start=''''''''
rule.22.end=''''''''
# Mask escaped text before matching delimiters.
rule.22.skip='\\.'

# Pattern 23: constant.specialChar (inside region 22).
rule.23.parent=22
rule.23.group='constant.specialChar'
rule.23.match='\\(["''bfnrst\x24\\]|u[a-fA-F0-9]{4})'

# Region 24: constant.string (root).
rule.24.parent=-1
rule.24.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.24.start='"'
rule.24.end='"'
# Mask escaped text before matching delimiters.
rule.24.skip='\\.'

# Pattern 25: constant.specialChar (inside region 24).
rule.25.parent=24
rule.25.group='constant.specialChar'
rule.25.match='\\(["''bfnrst\x24\\]|u[a-fA-F0-9]{4})'

# Pattern 26: identifier.var (inside region 24).
rule.26.parent=24
rule.26.group='identifier.var'
rule.26.match='\x24[\wÀ-ÖØ-öø-ÿĀ-￾]+([.][a-zA-Z0-9_À-ÖØ-öø-ÿĀ-￾]+)*'

# Pattern 27: identifier (inside region 24).
rule.27.parent=24
rule.27.group='identifier'
rule.27.match='\x24[{].*[}]'

# Region 28: constant.string (root).
rule.28.parent=-1
rule.28.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.28.start=''''
rule.28.end=''''
# Mask escaped text before matching delimiters.
rule.28.skip='\\.'

# Pattern 29: constant.specialChar (inside region 28).
rule.29.parent=28
rule.29.group='constant.specialChar'
rule.29.match='\\(["''bfnrst\x24\\]|u[a-fA-F0-9]{4})'

# Region 30: constant.string (root).
rule.30.parent=-1
rule.30.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.30.start='[$]/'
rule.30.end='/[$]'

# Region 31: comment (root).
rule.31.parent=-1
rule.31.group='comment'
# Start/end delimiters carry state between physical lines.
rule.31.start='//'
rule.31.end='$'

# Pattern 32: todo (inside region 31).
rule.32.parent=31
rule.32.group='todo'
rule.32.match='(TODO|XXX|FIXME):?'

# Region 33: comment (root).
rule.33.parent=-1
rule.33.group='comment'
# Start/end delimiters carry state between physical lines.
rule.33.start='/[*]'
rule.33.end='[*]/'

# Pattern 34: todo (inside region 33).
rule.34.parent=33
rule.34.group='todo'
rule.34.match='(TODO|XXX|FIXME):?'

# Region 35: comment (root).
rule.35.parent=-1
rule.35.group='comment'
# Start/end delimiters carry state between physical lines.
rule.35.start='/[*][*]@?'
rule.35.end='[*]/'

# Total flattened rules; update this when adding or removing rules.
rules=36
