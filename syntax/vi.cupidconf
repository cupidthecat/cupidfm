# Syntax: vi
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='vi'

# Detection: filename first, then header and content signature.
detect.filename='(^|/|\.)(ex|vim)rc$|\.vim'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='[A-Za-z_][A-Za-z0-9_]*[(]+[A-Za-z0-9_:.,\s]*[)]+'

# Pattern 1: special (root).
rule.1.parent=-1
rule.1.group='special'
rule.1.match='[()]+'

# Pattern 2: statement (root).
rule.2.parent=-1
rule.2.group='statement'
rule.2.match='\b([nvxsoilc]?(nore|un)?map|[nvlx]n|[ico]?no|[cilovx][um]|s?unm)\b'

# Pattern 3: statement (root).
rule.3.parent=-1
rule.3.group='statement'
rule.3.match='\b(is|isnot|fu(nc?|nction)?|if|while|for|try|return|throw|end(if|for|while|try|fu(nc?|nction)?|f)?|au(g|group)|else(if)?|do|in|catch|finally)\b'

# Pattern 4: statement (root).
rule.4.parent=-1
rule.4.group='statement'
rule.4.match='\b(snor|nun|nm|set(l|local|global)?|let|command|filetype|colorscheme|syn(tax)?|exe(c|cute)?|ec(ho)?|au(tocmd)?|source|call)\b'

# Pattern 5: statement (root).
rule.5.parent=-1
rule.5.group='statement'
rule.5.match='[!&=?]|[+<>]='

# Pattern 6: constant.number (root).
rule.6.parent=-1
rule.6.group='constant.number'
rule.6.match='\b[0-9]+\b'

# Region 7: identifier (root).
rule.7.parent=-1
rule.7.group='identifier'
# Start/end delimiters carry state between physical lines.
rule.7.start='@'
rule.7.end='.|$'

# Region 8: comment (root).
rule.8.parent=-1
rule.8.group='comment'
# Start/end delimiters carry state between physical lines.
rule.8.start='^[ 	]*"'
rule.8.end='$'

# Pattern 9: constant.string (root).
rule.9.parent=-1
rule.9.group='constant.string'
rule.9.match='"[^"]*"'

# Pattern 10: constant.string (root).
rule.10.parent=-1
rule.10.group='constant.string'
rule.10.match='''[^'']*'''

# Pattern 11: constant.specialChar (root).
rule.11.parent=-1
rule.11.group='constant.specialChar'
rule.11.match='\\.'

# Total flattened rules; update this when adding or removing rules.
rules=12
