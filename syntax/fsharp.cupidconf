# Syntax: fsharp
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='fsharp'

# Detection: filename first, then header and content signature.
detect.filename='\.fs?$'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='\b[A-Z][0-9a-z_]{2,}\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(let|val|method|in|and|rec|private|virtual|constraint)\b'

# Pattern 2: type (root).
rule.2.parent=-1
rule.2.group='type'
rule.2.match='\b(type|open|class|module|exception|external)\b'

# Pattern 3: statement (root).
rule.3.parent=-1
rule.3.group='statement'
rule.3.match='\b(fun|function|functor|match|try|with)\b'

# Pattern 4: statement (root).
rule.4.parent=-1
rule.4.group='statement'
rule.4.match='\b(as|when|of)\b'

# Pattern 5: statement (root).
rule.5.parent=-1
rule.5.group='statement'
rule.5.match='\b(if|then|else)\b'

# Pattern 6: type (root).
rule.6.parent=-1
rule.6.group='type'
rule.6.match='\b(begin|end|object|struct|sig|for|while|do|done|to|downto)\b'

# Pattern 7: constant.bool (root).
rule.7.parent=-1
rule.7.group='constant.bool'
rule.7.match='\b(true|false)\b'

# Pattern 8: special (root).
rule.8.parent=-1
rule.8.group='special'
rule.8.match='\b(include|inherit|initializer)\b'

# Pattern 9: special (root).
rule.9.parent=-1
rule.9.group='special'
rule.9.match='\b(new|ref|mutable|lazy|assert|raise)\b'

# Pattern 10: type (root).
rule.10.parent=-1
rule.10.group='type'
rule.10.match='\b(base|delegate|downcast|extern|finally|fixed|global|inline|interface|internal|let!|member|namespace|null|override|private|public)\b'

# Pattern 11: type (root).
rule.11.parent=-1
rule.11.group='type'
rule.11.match='\b(return|return!|select|static|upcast|use|use!|void|yield|yield!)\b'

# Region 12: constant.string (root).
rule.12.parent=-1
rule.12.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.12.start=''''
rule.12.end=''''
# Mask escaped text before matching delimiters.
rule.12.skip='\\.'

# Pattern 13: constant.specialChar (inside region 12).
rule.13.parent=12
rule.13.group='constant.specialChar'
rule.13.match='%.'

# Pattern 14: constant.specialChar (inside region 12).
rule.14.parent=12
rule.14.group='constant.specialChar'
rule.14.match='\\[abfnrtv''\"\\]'

# Pattern 15: constant.specialChar (inside region 12).
rule.15.parent=12
rule.15.group='constant.specialChar'
rule.15.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 16: constant.string (root).
rule.16.parent=-1
rule.16.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.16.start='"'
rule.16.end='"'
# Mask escaped text before matching delimiters.
rule.16.skip='\\.'

# Pattern 17: constant.specialChar (inside region 16).
rule.17.parent=16
rule.17.group='constant.specialChar'
rule.17.match='%.'

# Pattern 18: constant.specialChar (inside region 16).
rule.18.parent=16
rule.18.group='constant.specialChar'
rule.18.match='\\[abfnrtv''\"\\]'

# Pattern 19: constant.specialChar (inside region 16).
rule.19.parent=16
rule.19.group='constant.specialChar'
rule.19.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 20: comment (root).
rule.20.parent=-1
rule.20.group='comment'
# Start/end delimiters carry state between physical lines.
rule.20.start='\(\*'
rule.20.end='\*\)'

# Total flattened rules; update this when adding or removing rules.
rules=21
