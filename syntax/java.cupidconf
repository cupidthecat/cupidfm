# Syntax: java
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='java'

# Detection: filename first, then header and content signature.
detect.filename='\.java$'

# Pattern 0: type (root).
rule.0.parent=-1
rule.0.group='type'
rule.0.match='\b(boolean|byte|char|double|float|int|long|new|var|short|this|transient|void)\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(break|case|catch|continue|default|do|else|finally|for|if|return|switch|throw|try|while)\b'

# Pattern 2: type (root).
rule.2.parent=-1
rule.2.group='type'
rule.2.match='\b(abstract|class|extends|final|implements|import|instanceof|interface|native|package|private|protected|public|static|strictfp|super|synchronized|throws|volatile)\b'

# Pattern 3: constant (root).
rule.3.parent=-1
rule.3.group='constant'
rule.3.match='\b(true|false|null)\b'

# Pattern 4: constant.number (root).
rule.4.parent=-1
rule.4.group='constant.number'
rule.4.match='\b[0-9]+\b'

# Region 5: constant.string (root).
rule.5.parent=-1
rule.5.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.5.start='"'
rule.5.end='"'
# Mask escaped text before matching delimiters.
rule.5.skip='\\.'

# Pattern 6: constant.specialChar (inside region 5).
rule.6.parent=5
rule.6.group='constant.specialChar'
rule.6.match='\\.'

# Region 7: constant.string (root).
rule.7.parent=-1
rule.7.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.7.start=''''
rule.7.end=''''
# Mask escaped text before matching delimiters.
rule.7.skip='\\.'

# Pattern 8: preproc (inside region 7).
rule.8.parent=7
rule.8.group='preproc'
rule.8.match='..+'

# Pattern 9: constant.specialChar (inside region 7).
rule.9.parent=7
rule.9.group='constant.specialChar'
rule.9.match='\\.'

# Region 10: comment (root).
rule.10.parent=-1
rule.10.group='comment'
# Start/end delimiters carry state between physical lines.
rule.10.start='//'
rule.10.end='$'

# Region 11: comment (root).
rule.11.parent=-1
rule.11.group='comment'
# Start/end delimiters carry state between physical lines.
rule.11.start='/\*'
rule.11.end='\*/'

# Total flattened rules; update this when adding or removing rules.
rules=12
