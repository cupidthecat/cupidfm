# Syntax: batch
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='batch'

# Detection: filename first, then header and content signature.
detect.filename='(\.bat$|\.cmd$)'

# Pattern 0: constant.number (root).
rule.0.parent=-1
rule.0.group='constant.number'
rule.0.match='\b[0-9]+\b'

# Pattern 1: special (root).
rule.1.parent=-1
rule.1.group='special'
rule.1.match='(\{|\}|\(|\)|\;|\]|\[|`|\\|\$|<|>|!|=|&|\|)'

# Pattern 2: type (root).
rule.2.parent=-1
rule.2.group='type'
rule.2.match='\b(?i)(case|do|done|elif|else|esac|exit|fi|for|function|if|in|local|read|return|select|then|until|while)\b'

# Pattern 3: type (root).
rule.3.parent=-1
rule.3.group='type'
rule.3.match='\b(?i)(equ|neq|lss|leq|gtr|geq|on|off)\b'

# Pattern 4: type (root).
rule.4.parent=-1
rule.4.group='type'
rule.4.match='\b(?i)(goto|for|in|do|call|exit|not|exist|errorlevel|defined)\b'

# Pattern 5: type (root).
rule.5.parent=-1
rule.5.group='type'
rule.5.match='\b(?i)(prn|nul|lpt3|lpt2|lpt1|con|com4|com3|com2|com1|aux)\b'

# Pattern 6: statement (root).
rule.6.parent=-1
rule.6.group='statement'
rule.6.match='\b(?i)(adprep|append|arp|assoc|at|atmadm|attrib|auditpol|autochk|autoconv|autofmt|bcdboot|bcdedit|bdehdcfg|bitsadmin|bootcfg|break|brea)\b'

# Pattern 7: statement (root).
rule.7.parent=-1
rule.7.group='statement'
rule.7.match='\b(?i)(cacls|cd|certreq|certutil|chcp|change|choice|cipher|chdir|chkdsk|chkntfs|chglogon|chgport|chgusr|clip|cls|clscluadmin|cluster|cmd|cmdkey|cmstp|color)\b'

# Pattern 8: statement (root).
rule.8.parent=-1
rule.8.group='statement'
rule.8.match='\b(?i)(comp|compact|convert|copy|cprofile|cscript|csvde|date|dcdiag|dcgpofix|dcpromo|defra|del|dfscmd|dfsdiag|dfsrmig|diantz|dir|dirquota|diskcomp|diskcopy|diskpart|diskperf|diskraid|diskshadow|dispdiag|doin|dnscmd|doskey|driverquery|dsacls|dsadd|dsamain|dsdbutil|dsget|dsmgmt|dsmod|dsmove|dsquery|dsrm)\b'

# Pattern 9: statement (root).
rule.9.parent=-1
rule.9.group='statement'
rule.9.match='\b(?i)(echo|edit|endlocal|erase|esentutl|eventcreate|eventquery|eventtriggers|evntcmd|expand|extract)\b'

# Pattern 10: statement (root).
rule.10.parent=-1
rule.10.group='statement'
rule.10.match='\b(?i)(fc|filescrn|find|findstr|finger|flattemp|fonde|forfiles|format|freedisk|fs|fsutil|ftp|ftype|fveupdate|getmac|gettype|gpfixup|gpresult|gpupdate|graftabl)\b'

# Pattern 11: statement (root).
rule.11.parent=-1
rule.11.group='statement'
rule.11.match='\b(?i)(hashgen|hep|help|helpctr|hostname|icacls|iisreset|inuse|ipconfig|ipxroute|irftp|ismserv|jetpack|keyb|klist|ksetup|ktmutil|ktpass|label|ldifd|ldp|lodctr|logman|logoff|lpq|lpr|macfile)\b'

# Pattern 12: statement (root).
rule.12.parent=-1
rule.12.group='statement'
rule.12.match='\b(?i)(makecab|manage-bde|mapadmin|md|mkdir|mklink|mmc|mode|more|mount|mountvol|move|mqbup|mqsvc|mqtgsvc|msdt|msg|msiexec|msinfo32|mstsc|nbtstat|net computer|net group)\b'

# Pattern 13: statement (root).
rule.13.parent=-1
rule.13.group='statement'
rule.13.match='\b(?i)(net localgroup|net print|net session|net share|net start|net stop|net use|net user|net view|net|netcfg|netdiag|netdom|netsh|netstat|nfsadmin|nfsshare|nfsstat|nlb)\b'

# Pattern 14: statement (root).
rule.14.parent=-1
rule.14.group='statement'
rule.14.match='\b(?i)(nlbmgr|nltest|nslookup|ntackup|ntcmdprompt|ntdsutil|ntfrsutl|openfiles|pagefileconfig|path|pathping|pause|pbadmin|pentnt|perfmon|ping|pnpunatten|pnputil|popd)\b'

# Pattern 15: statement (root).
rule.15.parent=-1
rule.15.group='statement'
rule.15.match='\b(?i)(powercfg|powershell|powershell_ise|print|prncnfg|prndrvr|prnjobs|prnmngr|prnport|prnqctl|prompt|pubprn|pushd|pushprinterconnections|pwlauncher|qappsrv|qprocess)\b'

# Pattern 16: statement (root).
rule.16.parent=-1
rule.16.group='statement'
rule.16.match='\b(?i)(query|quser|qwinsta|rasdial|rcp|rd|rdpsign|regentc|recover|redircmp|redirusr|reg|regini|regsvr32|relog|ren|rename|rendom|repadmin|repair-bde|replace|reset|restore)\b'

# Pattern 17: statement (root).
rule.17.parent=-1
rule.17.group='statement'
rule.17.match='\b(?i)(rxec|risetup|rmdir|robocopy|route|rpcinfo|rpcping|rsh|runas|rundll32|rwinsta|scp|sc|setlocal|session|schtasks|scwcmd|secedit|serverceipoptin|servrmanagercmd|serverweroptin|set|setspn)\b'

# Pattern 18: statement (root).
rule.18.parent=-1
rule.18.group='statement'
rule.18.match='\b(?i)(setx|sfc|shadow|shift|showmount|shutdown|sort|ssh|start|storrept|subst|sxstrace|ysocmgr|systeminfo|takeown|tapicfg|taskkill|tasklist|tcmsetup|telnet|tftp|time)\b'

# Pattern 19: statement (root).
rule.19.parent=-1
rule.19.group='statement'
rule.19.match='\b(?i)(timeout|title|tlntadmn|tpmvscmgr|tpmvscmgr|tacerpt|tracert|tree|tscon|tsdiscon|tsecimp|tskill|tsprof|type|typeperf|tzutil|uddiconfig|umount|unlodctr|ver|verify)\b'

# Pattern 20: statement (root).
rule.20.parent=-1
rule.20.group='statement'
rule.20.match='\b(?i)(verifier|verif|vol|vssadmin|w32tm|waitfor|wbadmin|wdsutil|wecutil|wevtutil|where|whoami|winnt|winnt32|winpop|winrm|winrs|winsat|wlbs|mic|wscript|xcopy)\b'

# Pattern 21: constant (root).
rule.21.parent=-1
rule.21.group='constant'
rule.21.match='(/\w+)'

# Pattern 22: special (root).
rule.22.parent=-1
rule.22.group='special'
rule.22.match='(%%\w+)'

# Pattern 23: special (root).
rule.23.parent=-1
rule.23.group='special'
rule.23.match='(%\w+%)'

# Pattern 24: type (root).
rule.24.parent=-1
rule.24.group='type'
rule.24.match='--[a-z-]+'

# Pattern 25: type (root).
rule.25.parent=-1
rule.25.group='type'
rule.25.match='\ -[a-z]+'

# Pattern 26: identifier (root).
rule.26.parent=-1
rule.26.group='identifier'
rule.26.match='\$\{?[0-9A-Z_!@#$*?-]+\}?'

# Pattern 27: identifier (root).
rule.27.parent=-1
rule.27.group='identifier'
rule.27.match='\$\{?[0-9A-Z_!@#$*?-]+\}?'

# Region 28: constant.string (root).
rule.28.parent=-1
rule.28.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.28.start='\"'
rule.28.end='\"'
# Mask escaped text before matching delimiters.
rule.28.skip='\.'

# Pattern 29: constant.specialChar (inside region 28).
rule.29.parent=28
rule.29.group='constant.specialChar'
rule.29.match='(\\0|\\\\|\\t|\\n|\\r|\\"|\\'')'

# Pattern 30: constant.unicode (inside region 28).
rule.30.parent=28
rule.30.group='constant.unicode'
rule.30.match='\\u\{[[:xdigit:]]+}'

# Pattern 31: constant.string (root).
rule.31.parent=-1
rule.31.group='constant.string'
rule.31.match='(\''.+\'')'

# Pattern 32: comment.rem (root).
rule.32.parent=-1
rule.32.group='comment.rem'
rule.32.match='(?i)(rem\s.*)'

# Pattern 33: comment.rem (root).
rule.33.parent=-1
rule.33.group='comment.rem'
rule.33.match='(?i)(\:\:\s.*)'

# Total flattened rules; update this when adding or removing rules.
rules=34
