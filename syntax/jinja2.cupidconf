# Pattern 84: special (inside region 81).
rule.84.parent=81
rule.84.group='special'
rule.84.match='!important'

# Pattern 85: identifier (inside region 81).
rule.85.parent=81
rule.85.group='identifier'
rule.85.match=':active|:focus|:hover|:link|:visited|:link|:after|:before|$'

# Pattern 86: special (inside region 81).
rule.86.parent=81
rule.86.group='special'
rule.86.match='(\{|\}|\(|\)|\;|:|\]|~|<|>|,)'

# Pattern 87: statement (inside region 81).
rule.87.parent=81
rule.87.group='statement'
rule.87.match='@import|@mixin|@extend'

# Region 88: constant.string (inside region 81).
rule.88.parent=81
rule.88.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.88.start='"'
rule.88.end='"'
# Mask escaped text before matching delimiters.
rule.88.skip='\\.'

# Pattern 89: constant.specialChar (inside region 88).
rule.89.parent=88
rule.89.group='constant.specialChar'
rule.89.match='\\.'

# Region 90: constant.string (inside region 81).
rule.90.parent=81
rule.90.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.90.start=''''
rule.90.end=''''
# Mask escaped text before matching delimiters.
rule.90.skip='\\.'

# Pattern 91: constant.specialChar (inside region 90).
rule.91.parent=90
rule.91.group='constant.specialChar'
rule.91.match='\\.'

# Pattern 92: special (inside region 81).
rule.92.parent=81
rule.92.group='special'
rule.92.match='"|'''

# Region 93: comment (inside region 81).
rule.93.parent=81
rule.93.group='comment'
# Start/end delimiters carry state between physical lines.
rule.93.start='\/\*'
rule.93.end='\*\/'

# Pattern 94: todo (inside region 93).
rule.94.parent=93
rule.94.group='todo'
rule.94.match='(TODO|XXX|FIXME):?'

# Pattern 95: comment (root).
rule.95.parent=-1
rule.95.group='comment'
rule.95.match='<!>'

# Region 96: comment.block (root).
rule.96.parent=-1
rule.96.group='comment.block'
# Start/end delimiters carry state between physical lines.
rule.96.start='<!\-\-'
rule.96.end='\-\->'

# Pattern 97: todo (inside region 96).
rule.97.parent=96
rule.97.group='todo'
rule.97.match='(FIXME|NOTE|TODO):?'

# Pattern 98: error (inside region 96).
rule.98.parent=96
rule.98.group='error'
rule.98.match='(\-\-|>)'

