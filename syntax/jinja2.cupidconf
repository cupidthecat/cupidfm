# Syntax: jinja2
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='jinja2'

# Detection: filename first, then header and content signature.
detect.filename='\.(j2|jinja2?)$'

# Pattern 0: special (root).
rule.0.parent=-1
rule.0.group='special'
rule.0.match='({{|}}|{%-?|-?%})'

# Region 1: default (root).
rule.1.parent=-1
rule.1.group='default'
# Start/end delimiters carry state between physical lines.
rule.1.start='({%-?|{{)'
rule.1.end='(-?%}|}})'
# Delimiters use this group instead of the region body.
rule.1.limit-group='special'

# Pattern 2: statement (inside region 1).
rule.2.parent=1
rule.2.group='statement'
rule.2.match='\b(ignore missing|with(out)? context|block|call|endblock|endcall|endfilter|endfor|endmacro|endraw|endset|extends|filter|for|include|macro|raw|recursive|scoped|set)\b'

# Pattern 3: identifier.builtinfunc (inside region 1).
rule.3.parent=1
rule.3.group='identifier.builtinfunc'
rule.3.match='\b(attr|batch|capitalize|center|count|d|default|dictsort|e|escape|filesizeformat|first|forceescape|groupby|indent|join|last|length|lower|pprint|random|reject|rejectattr|replace|reverse|safe|select|selectattr|striptags|title|tojson|trim|truncate|unique|upper|urlencode|urlize|wordcount|wordwrap|xmlattr)\b'

# Pattern 4: identifier.builtintest (inside region 1).
rule.4.parent=1
rule.4.group='identifier.builtintest'
rule.4.match='\b(callable|defined|divisibleby|eq|equalto|escaped|even|ge|gt|iterable|le|lower|lt|mapping|ne|none|number|odd|sameas|sequence|string|undefined|upper)\b'

# Pattern 5: identifier.defaultglobal (inside region 1).
rule.5.parent=1
rule.5.group='identifier.defaultglobal'
rule.5.match='\b(lipsum|cycler|joiner|namespace)\b'

# Included language: python. Local rules come first.

# Pattern 6: constant (inside region 1).
rule.6.parent=1
rule.6.group='constant'
rule.6.match='\b(Ellipsis|None|self|cls|True|False)\b'

# Pattern 7: constant (inside region 1).
rule.7.parent=1
rule.7.group='constant'
rule.7.match='\b(__bases__|__builtin__|__class__|__debug__|__dict__|__doc__|__file__|__members__|__methods__|__name__|__self__)\b'

# Pattern 8: identifier (inside region 1).
rule.8.parent=1
rule.8.group='identifier'
rule.8.match='\b(abs|all|any|ascii|bin|bool|breakpoint|bytearray|bytes|callable|chr|classmethod|compile|complex|delattr|dir|divmod|eval|exec|format|getattr|globals|hasattr|hash|help|hex|id|input|isinstance|issubclass|iter|len|locals|max|min|next|nonlocal|oct|open|ord|pow|print|repr|round|setattr|sorted|sum|vars|__import__)\b'

# Pattern 9: identifier (inside region 1).
rule.9.parent=1
rule.9.group='identifier'
rule.9.match='\b__(abs|add|and|call|cmp|coerce|complex|concat|contains|delattr|delitem|delslice|del|dict|divmod|div|float|getattr|getitem|getslice|hash|hex|iadd|iand|iconcat|ifloordiv|ilshift|imatmul|imod|imul|init|int|invert|inv|ior|ipow|irshift|isub|iter|itruediv|ixor|len|long|lshift|mod|mul|neg|next|nonzero|oct|or|pos|pow|radd|rand|rcmp|rdivmod|rdiv|repeat|repr|rlshift|rmod|rmul|ror|rpow|rrshift|rshift|rsub|rxor|setattr|setitem|setslice|str|sub|xor)__\b'

# Pattern 10: type (inside region 1).
rule.10.parent=1
rule.10.group='type'
rule.10.match='\b(bool|bytearray|bytes|classmethod|complex|dict|enumerate|filter|float|frozenset|int|list|map|memoryview|object|property|range|reversed|set|slice|staticmethod|str|super|tuple|type|zip)\b'

# Pattern 11: identifier (inside region 1).
rule.11.parent=1
rule.11.group='identifier'
rule.11.match='def [a-zA-Z_0-9]+'

# Pattern 12: statement (inside region 1).
rule.12.parent=1
rule.12.group='statement'
rule.12.match='\b(and|as|assert|async|await|break|case|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|match|nonlocal|not|or|pass|raise|return|try|while|with|yield)\b'

# Pattern 13: preproc (inside region 1).
rule.13.parent=1
rule.13.group='preproc'
rule.13.match='^\s*@[^(]*'

# Pattern 14: symbol.operator (inside region 1).
rule.14.parent=1
rule.14.group='symbol.operator'
rule.14.match='([~^.:;,+*|=!\%@]|<|>|/|-|&)'

# Pattern 15: symbol.brackets (inside region 1).
rule.15.parent=1
rule.15.group='symbol.brackets'
rule.15.match='([(){}]|\[|\])'

# Pattern 16: constant.number (inside region 1).
rule.16.parent=1
rule.16.group='constant.number'
rule.16.match='\b[0-9](_?[0-9])*(\.([0-9](_?[0-9])*)?)?(e[0-9](_?[0-9])*)?\b'

# Pattern 17: constant.number (inside region 1).
rule.17.parent=1
rule.17.group='constant.number'
rule.17.match='\b0b(_?[01])+\b'

# Pattern 18: constant.number (inside region 1).
rule.18.parent=1
rule.18.group='constant.number'
rule.18.match='\b0o(_?[0-7])+\b'

# Pattern 19: constant.number (inside region 1).
rule.19.parent=1
rule.19.group='constant.number'
rule.19.match='\b0x(_?[0-9a-fA-F])+\b'

# Region 20: constant.string (inside region 1).
rule.20.parent=1
rule.20.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.20.start='"""'
rule.20.end='"""'

# Region 21: constant.string (inside region 1).
rule.21.parent=1
rule.21.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.21.start=''''''''
rule.21.end=''''''''

# Region 22: constant.string (inside region 1).
rule.22.parent=1
rule.22.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.22.start='"'
rule.22.end='("|$)'
# Mask escaped text before matching delimiters.
rule.22.skip='\\.'

# Pattern 23: constant.specialChar (inside region 22).
rule.23.parent=22
rule.23.group='constant.specialChar'
rule.23.match='\\.'

# Region 24: constant.string (inside region 1).
rule.24.parent=1
rule.24.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.24.start=''''
rule.24.end='(''|$)'
# Mask escaped text before matching delimiters.
rule.24.skip='\\.'

# Pattern 25: constant.specialChar (inside region 24).
rule.25.parent=24
rule.25.group='constant.specialChar'
rule.25.match='\\.'

# Region 26: comment (inside region 1).
rule.26.parent=1
rule.26.group='comment'
# Start/end delimiters carry state between physical lines.
rule.26.start='#'
rule.26.end='$'

# Pattern 27: todo (inside region 26).
rule.27.parent=26
rule.27.group='todo'
rule.27.match='(TODO|FIXME|HACK|BUG|NOTE|FAQ|MNEMONIC|REQ|RFE|IDEA|PORT|\?\?\?|!!!|GLOSS|SEE|TODOC|STAT|RVD|CRED):?'

# Region 28: comment (root).
rule.28.parent=-1
rule.28.group='comment'
# Start/end delimiters carry state between physical lines.
rule.28.start='{#'
rule.28.end='#}'

# Included language: html. Local rules come first.

# Pattern 29: preproc (root).
rule.29.parent=-1
rule.29.group='preproc'
rule.29.match='<!(?i)(DOCTYPE html.*)>'

# Region 30: symbol.tag (root).
rule.30.parent=-1
rule.30.group='symbol.tag'
# Start/end delimiters carry state between physical lines.
rule.30.start='<(a|abbr|acronym|address|applet|area|article|aside|audio|b|base|bdi|bdo|big|blockquote|body|br|button|canvas|caption|center|cite|code|col|colgroup|command|datalist|dd|del|details|dfn|dialog|dir|div|dl|dt|em|embed|fieldset|figcaption|figure|font|footer|form|frame|frameset|h[1-6]|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|keygen|label|legend|li|link|map|main|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|pre|progress|q|rp|rt|ruby|s|samp|section|select|small|source|span|strike|strong|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|track|tt|u|ul|var|video|wbr)\b'
rule.30.end='>'

# Pattern 31: identifier (inside region 30).
rule.31.parent=30
rule.31.group='identifier'
rule.31.match='\b(placeholder|style|alt|bgcolor|height|href|id|(aria|data)\-.+|label|longdesc|name|on(click|focus|load|mouseover)|size|span|src|target|type|value|width|class|charset|content|rel|integrity|crossorigin|for|onsubmit|lang|role)\b'

# Pattern 32: special (inside region 30).
rule.32.parent=30
rule.32.group='special'
rule.32.match='\b(required)\b'

# Region 33: constant.string (inside region 30).
rule.33.parent=30
rule.33.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.33.start='"'
rule.33.end='"'
# Mask escaped text before matching delimiters.
rule.33.skip='\\.'

# Pattern 34: constant.specialChar (inside region 33).
rule.34.parent=33
rule.34.group='constant.specialChar'
rule.34.match='\\.'

# Pattern 35: constant.string.url (inside region 33).
rule.35.parent=33
rule.35.group='constant.string.url'
rule.35.match='((ftp(s)?|http(s)?|git|chrome)://[^\s]+)'

# Region 36: constant.string (inside region 30).
rule.36.parent=30
rule.36.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.36.start=''''
rule.36.end=''''
# Mask escaped text before matching delimiters.
rule.36.skip='\\.'

# Pattern 37: constant.specialChar (inside region 36).
rule.37.parent=36
rule.37.group='constant.specialChar'
rule.37.match='\\.'

# Pattern 38: constant.string.url (inside region 36).
rule.38.parent=36
rule.38.group='constant.string.url'
rule.38.match='((ftp(s)?|http(s)?|git|chrome)://[^\s]+)'

# Pattern 39: symbol (inside region 30).
rule.39.parent=30
rule.39.group='symbol'
rule.39.match='\b(=|:\b)'

# Region 40: symbol.tag (root).
rule.40.parent=-1
rule.40.group='symbol.tag'
# Start/end delimiters carry state between physical lines.
rule.40.start='</(a|abbr|acronym|address|applet|area|article|aside|audio|b|base|bdi|bdo|big|blockquote|body|br|button|canvas|caption|center|cite|code|col|colgroup|command|datalist|dd|del|details|dfn|dialog|dir|div|dl|dt|em|embed|fieldset|figcaption|figure|font|footer|form|frame|frameset|h[1-6]|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|keygen|label|legend|li|link|map|main|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|pre|progress|q|rp|rt|ruby|s|samp|section|select|small|source|span|strike|strong|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|track|tt|u|ul|var|video|wbr)\b'
rule.40.end='>'

# Pattern 41: error (inside region 40).
rule.41.parent=40
rule.41.group='error'
rule.41.match='.'

# Pattern 42: special (root).
rule.42.parent=-1
rule.42.group='special'
rule.42.match='(([a-zA-Z]&#[0-9]+|&[a-zA-Z]+|&#[a-zA-Z0-9]+);)'

# Region 43: default (root).
rule.43.parent=-1
rule.43.group='default'
# Start/end delimiters carry state between physical lines.
rule.43.start='<script.*?>'
rule.43.end='</script.*?>'
# Delimiters use this group instead of the region body.
rule.43.limit-group='symbol.tag'

# Included language: javascript. Local rules come first.

# Pattern 44: constant.number (inside region 43).
rule.44.parent=43
rule.44.group='constant.number'
rule.44.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 45: constant.number (inside region 43).
rule.45.parent=43
rule.45.group='constant.number'
rule.45.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 46: constant.number (inside region 43).
rule.46.parent=43
rule.46.group='constant.number'
rule.46.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 47: symbol.brackets (inside region 43).
rule.47.parent=43
rule.47.group='symbol.brackets'
rule.47.match='[(){}]|\[|\]'

# Pattern 48: symbol.operator (inside region 43).
rule.48.parent=43
rule.48.group='symbol.operator'
rule.48.match='([-+/*=<>!~%?:&|]|[.]{3})'

# Pattern 49: statement (inside region 43).
rule.49.parent=43
rule.49.group='statement'
rule.49.match='\b(async|await|break|case|catch|const|continue|debugger|default)\b'

# Pattern 50: statement (inside region 43).
rule.50.parent=43
rule.50.group='statement'
rule.50.match='\b(delete|do|else|export|finally|for|function\*?|class|extends)\b'

# Pattern 51: statement (inside region 43).
rule.51.parent=43
rule.51.group='statement'
rule.51.match='\b(get|if|import|from|in|of|instanceof|let|new|reject|resolve|return)\b'

# Pattern 52: statement (inside region 43).
rule.52.parent=43
rule.52.group='statement'
rule.52.match='\b(set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield)\b'

# Pattern 53: error (inside region 43).
rule.53.parent=43
rule.53.group='error'
rule.53.match='\b(enum|implements|interface|package|private|protected|public)\b'

# Pattern 54: constant (inside region 43).
rule.54.parent=43
rule.54.group='constant'
rule.54.match='\b(globalThis|Infinity|null|undefined|NaN)\b'

# Pattern 55: constant (inside region 43).
rule.55.parent=43
rule.55.group='constant'
rule.55.match='\b(null|undefined|NaN)\b'

# Pattern 56: constant (inside region 43).
rule.56.parent=43
rule.56.group='constant'
rule.56.match='\b(true|false)\b'

# Pattern 57: type (inside region 43).
rule.57.parent=43
rule.57.group='type'
rule.57.match='\b(Array|Boolean|Date|Enumerator|Error|Function|Generator|Map|Math)\b'

# Pattern 58: type (inside region 43).
rule.58.parent=43
rule.58.group='type'
rule.58.match='\b(Number|Object|Promise|Proxy|Reflect|RegExp|Set|String|Symbol|WeakMap|WeakSet)\b'

# Pattern 59: type (inside region 43).
rule.59.parent=43
rule.59.group='type'
rule.59.match='\b(BigInt64Array|BigUint64Array|Float32Array|Float64Array|Int16Array)\b'

# Pattern 60: constant (inside region 43).
rule.60.parent=43
rule.60.group='constant'
rule.60.match='\\[0-7][0-7]?[0-7]?|\\x[0-9a-fA-F]+|\\[bfnrt''"\?\\]'

# Pattern 61: comment (inside region 43).
rule.61.parent=43
rule.61.group='comment'
rule.61.match='^#!.*/(env +)?node( |$)'

# Pattern 62: identifier (inside region 43).
rule.62.parent=43
rule.62.group='identifier'
rule.62.match='\b(alert|decodeURI|decodeURIComponent|document|encodeURI|encodeURIComponent|escape|eval|isFinite|isNaN|parseFloat|parseInt|unescape|uneval|window)\b'

# Pattern 63: identifier (inside region 43).
rule.63.parent=43
rule.63.group='identifier'
rule.63.match='\b(Intl|WebAssembly)\b'

# Pattern 64: identifier (inside region 43).
rule.64.parent=43
rule.64.group='identifier'
rule.64.match='\b(Arguments)\b'

# Region 65: constant.string (inside region 43).
rule.65.parent=43
rule.65.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.65.start='"'
rule.65.end='"'
# Mask escaped text before matching delimiters.
rule.65.skip='\\.'

# Pattern 66: constant.specialChar (inside region 65).
rule.66.parent=65
rule.66.group='constant.specialChar'
rule.66.match='\\.'

# Region 67: constant.string (inside region 43).
rule.67.parent=43
rule.67.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.67.start=''''
rule.67.end=''''
# Mask escaped text before matching delimiters.
rule.67.skip='\\.'

# Pattern 68: constant.specialChar (inside region 67).
rule.68.parent=67
rule.68.group='constant.specialChar'
rule.68.match='\\.'

# Region 69: constant.string (inside region 43).
rule.69.parent=43
rule.69.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.69.start='`'
rule.69.end='`'

# Pattern 70: constant.specialChar (inside region 69).
rule.70.parent=69
rule.70.group='constant.specialChar'
rule.70.match='\\.'

# Pattern 71: identifier (inside region 69).
rule.71.parent=69
rule.71.group='identifier'
rule.71.match='\x24\{.*?\}'

# Pattern 72: constant.bool (inside region 43).
rule.72.parent=43
rule.72.group='constant.bool'
rule.72.match='\b(true|false)\b'

# Pattern 73: constant.bool.false (inside region 43).
rule.73.parent=43
rule.73.group='constant.bool.false'
rule.73.match='\b(false)\b'

# Pattern 74: constant.bool.true (inside region 43).
rule.74.parent=43
rule.74.group='constant.bool.true'
rule.74.match='\b(true)\b'

# Region 75: comment (inside region 43).
rule.75.parent=43
rule.75.group='comment'
# Start/end delimiters carry state between physical lines.
rule.75.start='//'
rule.75.end='$'

# Pattern 76: todo (inside region 75).
rule.76.parent=75
rule.76.group='todo'
rule.76.match='(TODO|XXX|FIXME)'

# Region 77: comment (inside region 43).
rule.77.parent=43
rule.77.group='comment'
# Start/end delimiters carry state between physical lines.
rule.77.start='/\*'
rule.77.end='\*/'
# Mask escaped text before matching delimiters.
rule.77.skip='\\.'

# Pattern 78: constant.specialChar (inside region 77).
rule.78.parent=77
rule.78.group='constant.specialChar'
rule.78.match='\\.'

# Pattern 79: identifier (inside region 77).
rule.79.parent=77
rule.79.group='identifier'
rule.79.match='\s\*\s.*'

# Pattern 80: todo (inside region 77).
rule.80.parent=77
rule.80.group='todo'
rule.80.match='(TODO|XXX|FIXME)'

# Region 81: default (root).
rule.81.parent=-1
rule.81.group='default'
# Start/end delimiters carry state between physical lines.
rule.81.start='<style.*?>'
rule.81.end='</style.*?>'
# Delimiters use this group instead of the region body.
rule.81.limit-group='symbol.tag'

# Included language: css. Local rules come first.

# Pattern 82: statement (inside region 81).
rule.82.parent=81
rule.82.group='statement'
rule.82.match='(?i).'

# Pattern 83: type (inside region 81).
rule.83.parent=81
rule.83.group='type'
rule.83.match='(align-content|align-items|alignment-baseline|align-self|all|animation|animation-delay|animation-direction|animation-duration|animation-fill-mode|animation-iteration-count|animation-name|animation-play-state|animation-timing-function|appearance|azimuth|backdrop-filter|backface-visibility|background|background-attachment|background-blend-mode|background-clip|background-color|background-image|background-origin|background-position|background-repeat|background-size|baseline-shift|bookmark-label|bookmark-level|bookmark-state|border|border-bottom|border-bottom-color|border-bottom-left-radius|border-bottom-right-radius|border-bottom-style|border-bottom-width|border-boundary|border-collapse|border-color|border-image|border-image-outset|border-image-repeat|border-image-slice|border-image-source|border-image-width|border-left|border-left-color|border-left-style|border-left-width|border-radius|border-right|border-right-color|border-right-style|border-right-width|border-spacing|border-style|border-top|border-top-color|border-top-left-radius|border-top-right-radius|border-top-style|border-top-width|border-width|bottom|box-decoration-break|box-shadow|box-sizing|box-snap|box-suppress|break-after|break-before|break-inside|caption-side|caret|caret-animation|caret-color|caret-shape|chains|clear|clip|clip-path|clip-rule|color|color-interpolation-filters|column-count|column-fill|column-gap|column-rule|column-rule-color|column-rule-style|column-rule-width|columns|column-span|column-width|content|continue|counter-increment|counter-reset|counter-set|cue|cue-after|cue-before|cursor|direction|display|dominant-baseline|elevation|empty-cells|filter|flex|flex-basis|flex-direction|flex-flow|flex-grow|flex-shrink|flex-wrap|float|float-defer|float-offset|float-reference|flood-color|flood-opacity|flow|flow-from|flow-into|font|font-family|font-feature-settings|font-kerning|font-language-override|font-size|font-size-adjust|font-stretch|font-style|font-synthesis|font-variant|font-varia