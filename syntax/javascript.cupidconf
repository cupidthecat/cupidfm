# Syntax: javascript
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='javascript'

# Detection: filename first, then header and content signature.
detect.filename='(\.(m|c)?js$|\.es[5678]?$)'
detect.header='^#!.*/(env +)?node( |$)'

# Pattern 0: constant.number (root).
rule.0.parent=-1
rule.0.group='constant.number'
rule.0.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 1: constant.number (root).
rule.1.parent=-1
rule.1.group='constant.number'
rule.1.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 2: constant.number (root).
rule.2.parent=-1
rule.2.group='constant.number'
rule.2.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 3: symbol.brackets (root).
rule.3.parent=-1
rule.3.group='symbol.brackets'
rule.3.match='[(){}]|\[|\]'

# Pattern 4: symbol.operator (root).
rule.4.parent=-1
rule.4.group='symbol.operator'
rule.4.match='([-+/*=<>!~%?:&|]|[.]{3})'

# Pattern 5: statement (root).
rule.5.parent=-1
rule.5.group='statement'
rule.5.match='\b(async|await|break|case|catch|const|continue|debugger|default)\b'

# Pattern 6: statement (root).
rule.6.parent=-1
rule.6.group='statement'
rule.6.match='\b(delete|do|else|export|finally|for|function\*?|class|extends)\b'

# Pattern 7: statement (root).
rule.7.parent=-1
rule.7.group='statement'
rule.7.match='\b(get|if|import|from|in|of|instanceof|let|new|reject|resolve|return)\b'

# Pattern 8: statement (root).
rule.8.parent=-1
rule.8.group='statement'
rule.8.match='\b(set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield)\b'

# Pattern 9: error (root).
rule.9.parent=-1
rule.9.group='error'
rule.9.match='\b(enum|implements|interface|package|private|protected|public)\b'

# Pattern 10: constant (root).
rule.10.parent=-1
rule.10.group='constant'
rule.10.match='\b(globalThis|Infinity|null|undefined|NaN)\b'

# Pattern 11: constant (root).
rule.11.parent=-1
rule.11.group='constant'
rule.11.match='\b(null|undefined|NaN)\b'

# Pattern 12: constant (root).
rule.12.parent=-1
rule.12.group='constant'
rule.12.match='\b(true|false)\b'

# Pattern 13: type (root).
rule.13.parent=-1
rule.13.group='type'
rule.13.match='\b(Array|Boolean|Date|Enumerator|Error|Function|Generator|Map|Math)\b'

# Pattern 14: type (root).
rule.14.parent=-1
rule.14.group='type'
rule.14.match='\b(Number|Object|Promise|Proxy|Reflect|RegExp|Set|String|Symbol|WeakMap|WeakSet)\b'

# Pattern 15: type (root).
rule.15.parent=-1
rule.15.group='type'
rule.15.match='\b(BigInt64Array|BigUint64Array|Float32Array|Float64Array|Int16Array)\b'

# Pattern 16: constant (root).
rule.16.parent=-1
rule.16.group='constant'
rule.16.match='\\[0-7][0-7]?[0-7]?|\\x[0-9a-fA-F]+|\\[bfnrt''"\?\\]'

# Pattern 17: comment (root).
rule.17.parent=-1
rule.17.group='comment'
rule.17.match='^#!.*/(env +)?node( |$)'

# Pattern 18: identifier (root).
rule.18.parent=-1
rule.18.group='identifier'
rule.18.match='\b(alert|decodeURI|decodeURIComponent|document|encodeURI|encodeURIComponent|escape|eval|isFinite|isNaN|parseFloat|parseInt|unescape|uneval|window)\b'

# Pattern 19: identifier (root).
rule.19.parent=-1
rule.19.group='identifier'
rule.19.match='\b(Intl|WebAssembly)\b'

# Pattern 20: identifier (root).
rule.20.parent=-1
rule.20.group='identifier'
rule.20.match='\b(Arguments)\b'

# Region 21: constant.string (root).
rule.21.parent=-1
rule.21.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.21.start='"'
rule.21.end='"'
# Mask escaped text before matching delimiters.
rule.21.skip='\\.'

# Pattern 22: constant.specialChar (inside region 21).
rule.22.parent=21
rule.22.group='constant.specialChar'
rule.22.match='\\.'

# Region 23: constant.string (root).
rule.23.parent=-1
rule.23.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.23.start=''''
rule.23.end=''''
# Mask escaped text before matching delimiters.
rule.23.skip='\\.'

# Pattern 24: constant.specialChar (inside region 23).
rule.24.parent=23
rule.24.group='constant.specialChar'
rule.24.match='\\.'

# Region 25: constant.string (root).
rule.25.parent=-1
rule.25.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.25.start='`'
rule.25.end='`'

# Pattern 26: constant.specialChar (inside region 25).
rule.26.parent=25
rule.26.group='constant.specialChar'
rule.26.match='\\.'

# Pattern 27: identifier (inside region 25).
rule.27.parent=25
rule.27.group='identifier'
rule.27.match='\x24\{.*?\}'

# Pattern 28: constant.bool (root).
rule.28.parent=-1
rule.28.group='constant.bool'
rule.28.match='\b(true|false)\b'

# Pattern 29: constant.bool.false (root).
rule.29.parent=-1
rule.29.group='constant.bool.false'
rule.29.match='\b(false)\b'

# Pattern 30: constant.bool.true (root).
rule.30.parent=-1
rule.30.group='constant.bool.true'
rule.30.match='\b(true)\b'

# Region 31: comment (root).
rule.31.parent=-1
rule.31.group='comment'
# Start/end delimiters carry state between physical lines.
rule.31.start='//'
rule.31.end='$'

# Pattern 32: todo (inside region 31).
rule.32.parent=31
rule.32.group='todo'
rule.32.match='(TODO|XXX|FIXME)'

# Region 33: comment (root).
rule.33.parent=-1
rule.33.group='comment'
# Start/end delimiters carry state between physical lines.
rule.33.start='/\*'
rule.33.end='\*/'
# Mask escaped text before matching delimiters.
rule.33.skip='\\.'

# Pattern 34: constant.specialChar (inside region 33).
rule.34.parent=33
rule.34.group='constant.specialChar'
rule.34.match='\\.'

# Pattern 35: identifier (inside region 33).
rule.35.parent=33
rule.35.group='identifier'
rule.35.match='\s\*\s.*'

# Pattern 36: todo (inside region 33).
rule.36.parent=33
rule.36.group='todo'
rule.36.match='(TODO|XXX|FIXME)'

# Total flattened rules; update this when adding or removing rules.
rules=37
