# Syntax: groff
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='groff'

# Detection: filename first, then header and content signature.
detect.filename='\.m[ems]$|\.rof|\.tmac$|^tmac.'

# Pattern 0: statement (root).
rule.0.parent=-1
rule.0.group='statement'
rule.0.match='^\.(ds|nr) [^[[:space:]]]*'

# Pattern 1: constant.specialChar (root).
rule.1.parent=-1
rule.1.group='constant.specialChar'
rule.1.match='\\.'

# Pattern 2: constant.specialChar (root).
rule.2.parent=-1
rule.2.group='constant.specialChar'
rule.2.match='\\f.|\\f\(..|\\s(\+|\-)?[0-9]'

# Pattern 3: constant (root).
rule.3.parent=-1
rule.3.group='constant'
rule.3.match='(\\|\\\\)n(.|\(..)'

# Region 4: constant (root).
rule.4.parent=-1
rule.4.group='constant'
# Start/end delimiters carry state between physical lines.
rule.4.start='(\\|\\\\)n\['
rule.4.end=']'

# Pattern 5: type (root).
rule.5.parent=-1
rule.5.group='type'
rule.5.match='^\.[[:space:]]*[^[[:space:]]]*'

# Pattern 6: comment (root).
rule.6.parent=-1
rule.6.group='comment'
rule.6.match='^\.\\".*$'

# Pattern 7: constant.string (root).
rule.7.parent=-1
rule.7.group='constant.string'
rule.7.match='(\\|\\\\)\*(.|\(..)'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start='(\\|\\\\)\*\['
rule.8.end=']'

# Pattern 9: constant.specialChar (root).
rule.9.parent=-1
rule.9.group='constant.specialChar'
rule.9.match='\\\(..'

# Region 10: constant.specialChar (root).
rule.10.parent=-1
rule.10.group='constant.specialChar'
# Start/end delimiters carry state between physical lines.
rule.10.start='\\\['
rule.10.end=']'

# Pattern 11: identifier.macro (root).
rule.11.parent=-1
rule.11.group='identifier.macro'
rule.11.match='\\\\\$[1-9]'

# Total flattened rules; update this when adding or removing rules.
rules=12
