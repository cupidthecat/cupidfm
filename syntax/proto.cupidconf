# Syntax: proto
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='proto'

# Detection: filename first, then header and content signature.
detect.filename='(\.(proto)$$)'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='\b[A-Z_][0-9A-Z_]+\b'

# Pattern 1: type (root).
rule.1.parent=-1
rule.1.group='type'
rule.1.match='\b(int(8|16|32|64))|string|bytes|repeated|bool|required|map|optional|oneof|union\b'

# Pattern 2: statement (root).
rule.2.parent=-1
rule.2.group='statement'
rule.2.match='\b(import|service|enum|syntax|package|option|message|rpc|returns|extensions|to)\b'

# Pattern 3: constant (root).
rule.3.parent=-1
rule.3.group='constant'
rule.3.match='''\\(([0-3]?[0-7]{1,2}))'''

# Pattern 4: constant (root).
rule.4.parent=-1
rule.4.group='constant'
rule.4.match='''\\x[0-9A-Fa-f]{1,2}'''

# Pattern 5: symbol.brackets (root).
rule.5.parent=-1
rule.5.group='symbol.brackets'
rule.5.match='[(){}]|\[|\]'

# Pattern 6: constant.number (root).
rule.6.parent=-1
rule.6.group='constant.number'
rule.6.match='(\b[0-9]+\b|\b0x[0-9A-Fa-f]+\b)'

# Region 7: constant.string (root).
rule.7.parent=-1
rule.7.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.7.start='"'
rule.7.end='"'
# Mask escaped text before matching delimiters.
rule.7.skip='\\.'

# Pattern 8: constant.specialChar (inside region 7).
rule.8.parent=7
rule.8.group='constant.specialChar'
rule.8.match='\\.'

# Region 9: constant.string (root).
rule.9.parent=-1
rule.9.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.9.start=''''
rule.9.end=''''
# Mask escaped text before matching delimiters.
rule.9.skip='\\.'

# Pattern 10: preproc (inside region 9).
rule.10.parent=9
rule.10.group='preproc'
rule.10.match='..+'

# Pattern 11: constant.specialChar (inside region 9).
rule.11.parent=9
rule.11.group='constant.specialChar'
rule.11.match='\\.'

# Region 12: comment (root).
rule.12.parent=-1
rule.12.group='comment'
# Start/end delimiters carry state between physical lines.
rule.12.start='//'
rule.12.end='$'

# Pattern 13: todo (inside region 12).
rule.13.parent=12
rule.13.group='todo'
rule.13.match='(TODO|XXX|FIXME):?'

# Region 14: comment (root).
rule.14.parent=-1
rule.14.group='comment'
# Start/end delimiters carry state between physical lines.
rule.14.start='/\*'
rule.14.end='\*/'

# Pattern 15: todo (inside region 14).
rule.15.parent=14
rule.15.group='todo'
rule.15.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=16
