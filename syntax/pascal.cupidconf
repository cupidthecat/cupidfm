# Syntax: pascal
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='pascal'

# Detection: filename first, then header and content signature.
detect.filename='\.pas$'

# Pattern 0: type (root).
rule.0.parent=-1
rule.0.group='type'
rule.0.match='\b(?i:(string|ansistring|widestring|shortstring|char|ansichar|widechar|boolean|byte|shortint|word|smallint|longword|cardinal|longint|integer|int64|single|currency|double|extended))\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(?i:(and|asm|array|begin|break|case|const|constructor|continue|destructor|div|do|downto|else|end|file|for|function|goto|if|implementation|in|inline|interface|label|mod|not|object|of|on|operator|or|packed|procedure|program|record|repeat|resourcestring|set|shl|shr|then|to|type|unit|until|uses|var|while|with|xor))\b'

# Pattern 2: statement (root).
rule.2.parent=-1
rule.2.group='statement'
rule.2.match='\b(?i:(as|class|dispose|except|exit|exports|finalization|finally|inherited|initialization|is|library|new|on|out|property|raise|self|threadvar|try))\b'

# Pattern 3: statement (root).
rule.3.parent=-1
rule.3.group='statement'
rule.3.match='\b(?i:(absolute|abstract|alias|assembler|cdecl|cppdecl|default|export|external|forward|generic|index|local|name|nostackframe|oldfpccall|override|pascal|private|protected|public|published|read|register|reintroduce|safecall|softfloat|specialize|stdcall|virtual|write))\b'

# Pattern 4: constant (root).
rule.4.parent=-1
rule.4.group='constant'
rule.4.match='\b(?i:(false|true|nil))\b'

# Region 5: special (root).
rule.5.parent=-1
rule.5.group='special'
# Start/end delimiters carry state between physical lines.
rule.5.start='asm'
rule.5.end='end'

# Pattern 6: constant.number (root).
rule.6.parent=-1
rule.6.group='constant.number'
rule.6.match='\$[0-9A-Fa-f]+'

# Pattern 7: constant.number (root).
rule.7.parent=-1
rule.7.group='constant.number'
rule.7.match='\b[+-]?[0-9]+([.]?[0-9]+)?(?i:e[+-]?[0-9]+)?'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start='#[0-9]{1,}'
rule.8.end='$'

# Pattern 9: constant.specialChar (inside region 8).
rule.9.parent=8
rule.9.group='constant.specialChar'
rule.9.match='\\.'

# Region 10: constant.string (root).
rule.10.parent=-1
rule.10.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.10.start=''''
rule.10.end=''''
# Mask escaped text before matching delimiters.
rule.10.skip='\\.'

# Pattern 11: constant.specialChar (inside region 10).
rule.11.parent=10
rule.11.group='constant.specialChar'
rule.11.match='\\.'

# Region 12: preproc (root).
rule.12.parent=-1
rule.12.group='preproc'
# Start/end delimiters carry state between physical lines.
rule.12.start='{\$'
rule.12.end='}'

# Region 13: comment (root).
rule.13.parent=-1
rule.13.group='comment'
# Start/end delimiters carry state between physical lines.
rule.13.start='//'
rule.13.end='$'

# Region 14: comment (root).
rule.14.parent=-1
rule.14.group='comment'
# Start/end delimiters carry state between physical lines.
rule.14.start='\(\*'
rule.14.end='\*\)'

# Region 15: comment (root).
rule.15.parent=-1
rule.15.group='comment'
# Start/end delimiters carry state between physical lines.
rule.15.start='({)(?:[^$])'
rule.15.end='}'

# Total flattened rules; update this when adding or removing rules.
rules=16
