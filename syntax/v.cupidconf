# Syntax: v
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='v'

# Detection: filename first, then header and content signature.

# Pattern 0: preproc (root).
rule.0.parent=-1
rule.0.group='preproc'
rule.0.match='\b(module|import)\b'

# Pattern 1: statement (root).
rule.1.parent=-1
rule.1.group='statement'
rule.1.match='\b(if|else|for|match|select|defer|or|unsafe)\b'

# Pattern 2: statement (root).
rule.2.parent=-1
rule.2.group='statement'
rule.2.match='\b(break|continue|goto|return)\b'

# Pattern 3: type.keyword (root).
rule.3.parent=-1
rule.3.group='type.keyword'
rule.3.match='\b(assert|const|enum|fn|struct|interface|type)\b'

# Pattern 4: type.keyword (root).
rule.4.parent=-1
rule.4.group='type.keyword'
rule.4.match='\b(pub|mut|__global)\b'

# Pattern 5: preproc (root).
rule.5.parent=-1
rule.5.group='preproc'
rule.5.match='\$\b(if|else)\b'

# Pattern 6: identifier.os (root).
rule.6.parent=-1
rule.6.group='identifier.os'
rule.6.match='\b(mac|macos|linux|windows|freebsd|openbsd|netbsd|dragonfly|android|solaris|haiku)\b'

# Pattern 7: identifier.compiler (root).
rule.7.parent=-1
rule.7.group='identifier.compiler'
rule.7.match='\b(gcc|tinyc|clang|mingw|msvc|cplusplus)\b'

# Pattern 8: identifier.platform (root).
rule.8.parent=-1
rule.8.group='identifier.platform'
rule.8.match='\b(amd64|aarch64|x64|x32|little_endian|big_endian)\b'

# Pattern 9: identifier.other (root).
rule.9.parent=-1
rule.9.group='identifier.other'
rule.9.match='\b(debug|test|js|glibc|prealloc|no_bounds_checking)\b'

# Pattern 10: identifier.class (root).
rule.10.parent=-1
rule.10.group='identifier.class'
rule.10.match='\b([A-Z][A-Za-z0-9_]*)\b'

# Pattern 11: identifier.function (root).
rule.11.parent=-1
rule.11.group='identifier.function'
rule.11.match='\b([a-z_]+\()'

# Pattern 12: symbol.operator (root).
rule.12.parent=-1
rule.12.group='symbol.operator'
rule.12.match='\b(i[ns])\b|[-+/*<>!=~*%&:|,.?]'

# Region 13: symbol.attribute (root).
rule.13.parent=-1
rule.13.group='symbol.attribute'
# Start/end delimiters carry state between physical lines.
rule.13.start='^\['
rule.13.end='\]$'

# Pattern 14: default (inside region 13).
rule.14.parent=13
rule.14.group='default'
rule.14.match='.*'

# Pattern 15: symbol (inside region 13).
rule.15.parent=13
rule.15.group='symbol'
rule.15.match='\b(deprecated|direct_array_access|if|inline|live|ref_only|typedef|windows_stdcall)\b'

# Pattern 16: type (root).
rule.16.parent=-1
rule.16.group='type'
rule.16.match='\b(byte|u(16|32|64|128)|i(nt|8|16|64|128)|f(32|64))\b'

# Pattern 17: type (root).
rule.17.parent=-1
rule.17.group='type'
rule.17.match='\b(bool|cha[nr]|map|rune|string)\b'

# Pattern 18: type (root).
rule.18.parent=-1
rule.18.group='type'
rule.18.match='\b(any(_int|_float)?|size_t|(uint|byte|char|void)ptr)\b'

# Pattern 19: constant.bool (root).
rule.19.parent=-1
rule.19.group='constant.bool'
rule.19.match='\b(true|false)\b'

# Pattern 20: constant.none (root).
rule.20.parent=-1
rule.20.group='constant.none'
rule.20.match='\b(none)\b'

# Pattern 21: symbol.brackets (root).
rule.21.parent=-1
rule.21.group='symbol.brackets'
rule.21.match='(\{|\})'

# Pattern 22: symbol.brackets (root).
rule.22.parent=-1
rule.22.group='symbol.brackets'
rule.22.match='(\(|\))'

# Pattern 23: symbol.brackets (root).
rule.23.parent=-1
rule.23.group='symbol.brackets'
rule.23.match='(\[|\])'

# Pattern 24: constant.number (root).
rule.24.parent=-1
rule.24.group='constant.number'
rule.24.match='\b(0b[01_]+)\b'

# Pattern 25: constant.number (root).
rule.25.parent=-1
rule.25.group='constant.number'
rule.25.match='\b(0o[0-7_]+)\b'

# Pattern 26: constant.number (root).
rule.26.parent=-1
rule.26.group='constant.number'
rule.26.match='\b(0x[0-9a-fA-F_]+)\b'

# Pattern 27: constant.number (root).
rule.27.parent=-1
rule.27.group='constant.number'
rule.27.match='\b([0-9_]+)\b'

# Region 28: constant.string (root).
rule.28.parent=-1
rule.28.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.28.start='"'
rule.28.end='"'
# Mask escaped text before matching delimiters.
rule.28.skip='\\.'

# Pattern 29: constant.specialChar (inside region 28).
rule.29.parent=28
rule.29.group='constant.specialChar'
rule.29.match='%.'

# Pattern 30: constant.specialChar (inside region 28).
rule.30.parent=28
rule.30.group='constant.specialChar'
rule.30.match='\\[abefnrtv''\"\\]'

# Pattern 31: constant.specialChar (inside region 28).
rule.31.parent=28
rule.31.group='constant.specialChar'
rule.31.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 32: constant.string (root).
rule.32.parent=-1
rule.32.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.32.start=''''
rule.32.end=''''
# Mask escaped text before matching delimiters.
rule.32.skip='\\.'

# Pattern 33: constant.specialChar (inside region 32).
rule.33.parent=32
rule.33.group='constant.specialChar'
rule.33.match='%.'

# Pattern 34: constant.specialChar (inside region 32).
rule.34.parent=32
rule.34.group='constant.specialChar'
rule.34.match='\\[abefnrtv''\"\\]'

# Pattern 35: constant.specialChar (inside region 32).
rule.35.parent=32
rule.35.group='constant.specialChar'
rule.35.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 36: constant.string (root).
rule.36.parent=-1
rule.36.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.36.start='`'
rule.36.end='`'

# Region 37: comment (root).
rule.37.parent=-1
rule.37.group='comment'
# Start/end delimiters carry state between physical lines.
rule.37.start='//'
rule.37.end='$'

# Pattern 38: todo (inside region 37).
rule.38.parent=37
rule.38.group='todo'
rule.38.match='(TODO|XXX|FIXME):?'

# Region 39: comment (root).
rule.39.parent=-1
rule.39.group='comment'
# Start/end delimiters carry state between physical lines.
rule.39.start='/\*'
rule.39.end='\*/'

# Pattern 40: todo (inside region 39).
rule.40.parent=39
rule.40.group='todo'
rule.40.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=41
