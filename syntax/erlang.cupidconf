# Syntax: erlang
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='erlang'

# Detection: filename first, then header and content signature.
detect.filename='\.erl$'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='\b[A-Z][0-9a-z_]*\b'

# Pattern 1: constant.number (root).
rule.1.parent=-1
rule.1.group='constant.number'
rule.1.match='\b[0-9]+(\.[0-9]+)?(e-?[0-9]+)?\b'

# Pattern 2: constant.number (root).
rule.2.parent=-1
rule.2.group='constant.number'
rule.2.match='\b[0-9]{1,2}\#[a-zA-Z0-9]+\b'

# Pattern 3: constant.bool (root).
rule.3.parent=-1
rule.3.group='constant.bool'
rule.3.match='\b(true|false)\b'

# Pattern 4: constant.number (root).
rule.4.parent=-1
rule.4.group='constant.number'
rule.4.match='\$\\?\S{1}'

# Pattern 5: statement (root).
rule.5.parent=-1
rule.5.group='statement'
rule.5.match='\b(after|and|andalso|band|begin|bnot|bor|bsl|bsr|bxor|case|catch|cond|div|end|fun|if|let|not|of|or|orelse|receive|rem|try|when|xor)\b'

# Pattern 6: preproc (root).
rule.6.parent=-1
rule.6.group='preproc'
rule.6.match='\-(module|export|record|include|include_lib|define|undef|ifdef|ifndef|else|endif|if|elif|error|warning)\b'

# Pattern 7: identifier.macro (root).
rule.7.parent=-1
rule.7.group='identifier.macro'
rule.7.match='\?[A-Z0-9_]+\b'

# Pattern 8: special (root).
rule.8.parent=-1
rule.8.group='special'
rule.8.match='\b(ext_binary|binary|iovec|message_queue_data|time(_unit|stamp)|abs|apply|atom(_to_binary|_to_list)|binary_(part|to_atom|to_existing_atom|to_float|to_integer|to_list|to_term)|bit(_size|string_to_list)|byte_size|ceil|check_(old_code|process_code)|date|delete_module|demonitor|disconnect_node|element|erase|error|exit|float(_to_binary|_to_list)?|floor|garbage_collect|get|group_leader|halt|integer(_to_binary|to_list)|iolist_(size|to_binary)|is_(alive|atom|binary|bitstring|boolean|float|function|integer|list|map|map_key|number|pid|port|process_alive|record|reference|tuple|length)|link|list_to_(atom|binary|bitstring|existing_atom|float|integer|pid|port|ref|tuple)|load_module|make_ref|map_(get|size)|max|min|module_loaded|monitor(_node)?|nodes?|now|open_port|pid_to_list|port(_close|command|connect|control|to_list)|pre_loaded|process(_flag|_info|es)|purge_module|put|register(ed)?|round|self|setelement|size|spawn(_link|_monitor|_opt|_binary)?|statistics|trunc|tuple_(size|to_list)|unlink|unregister|whereis)\b'

# Region 9: symbol (root).
rule.9.parent=-1
rule.9.group='symbol'
# Start/end delimiters carry state between physical lines.
rule.9.start=''''
rule.9.end=''''
# Mask escaped text before matching delimiters.
rule.9.skip='\\.'

# Region 10: constant.string (root).
rule.10.parent=-1
rule.10.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.10.start='"'
rule.10.end='"'
# Mask escaped text before matching delimiters.
rule.10.skip='\\.'

# Pattern 11: constant.specialChar (inside region 10).
rule.11.parent=10
rule.11.group='constant.specialChar'
rule.11.match='%.'

# Pattern 12: constant.specialChar (inside region 10).
rule.12.parent=10
rule.12.group='constant.specialChar'
rule.12.match='\\[abfnrtv''\"\\]'

# Pattern 13: constant.specialChar (inside region 10).
rule.13.parent=10
rule.13.group='constant.specialChar'
rule.13.match='\\([0-7]{3}|x[A-Fa-f0-9]{2}|u[A-Fa-f0-9]{4}|U[A-Fa-f0-9]{8})'

# Region 14: comment (root).
rule.14.parent=-1
rule.14.group='comment'
# Start/end delimiters carry state between physical lines.
rule.14.start='\(\*'
rule.14.end='\*\)'

# Pattern 15: todo (inside region 14).
rule.15.parent=14
rule.15.group='todo'
rule.15.match='(TODO|FIXME|WONTFIX|NOTE|HACK):?'

# Region 16: comment (root).
rule.16.parent=-1
rule.16.group='comment'
# Start/end delimiters carry state between physical lines.
rule.16.start='%'
rule.16.end='$'

# Total flattened rules; update this when adding or removing rules.
rules=17
