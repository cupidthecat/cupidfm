# Syntax: cuda
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='cuda'

# Detection: filename first, then header and content signature.
detect.filename='(\.cu[h]?$)'

# Pattern 0: identifier (root).
rule.0.parent=-1
rule.0.group='identifier'
rule.0.match='\b[A-Z_][0-9A-Z_]*\b'

# Pattern 1: type (root).
rule.1.parent=-1
rule.1.group='type'
rule.1.match='\b(float|double|bool|char|int|short|long|enum|void|struct|union|typedef|(un)?signed|inline)\b'

# Pattern 2: type (root).
rule.2.parent=-1
rule.2.group='type'
rule.2.match='\b(((s?size)|((u_?)?int(8|16|32|64|ptr))|char(8|16|32))_t|wchar_t)\b'

# Pattern 3: type (root).
rule.3.parent=-1
rule.3.group='type'
rule.3.match='\b[a-z_][0-9a-z_]+(_t|_T)\b'

# Pattern 4: type (root).
rule.4.parent=-1
rule.4.group='type'
rule.4.match='\b(final|override)\b'

# Pattern 5: type.keyword (root).
rule.5.parent=-1
rule.5.group='type.keyword'
rule.5.match='\b(auto|volatile|const(expr|eval|init)?|mutable|register|thread_local|static|extern|decltype|explicit|virtual)\b'

# Pattern 6: statement (root).
rule.6.parent=-1
rule.6.group='statement'
rule.6.match='\b(class|namespace|template|typename|this|friend|using|public|protected|private|noexcept)\b'

# Pattern 7: statement (root).
rule.7.parent=-1
rule.7.group='statement'
rule.7.match='\b(concept|requires)\b'

# Pattern 8: statement (root).
rule.8.parent=-1
rule.8.group='statement'
rule.8.match='\b(import|export|module)\b'

# Pattern 9: statement (root).
rule.9.parent=-1
rule.9.group='statement'
rule.9.match='\b(for|if|while|do|else|case|default|switch)\b'

# Pattern 10: statement (root).
rule.10.parent=-1
rule.10.group='statement'
rule.10.match='\b(try|throw|catch|operator|new|delete|static_assert)\b'

# Pattern 11: statement (root).
rule.11.parent=-1
rule.11.group='statement'
rule.11.match='\b(goto|continue|break|return)\b'

# Pattern 12: preproc (root).
rule.12.parent=-1
rule.12.group='preproc'
rule.12.match='^[[:space:]]*#[[:space:]]*(define|pragma|include|(un|ifn?)def|endif|el(if|se)|if|warning|error)|_Pragma'

# Pattern 13: statement (root).
rule.13.parent=-1
rule.13.group='statement'
rule.13.match='\b(asm|fortran)\b'

# Pattern 14: statement (root).
rule.14.parent=-1
rule.14.group='statement'
rule.14.match='(__attribute__[[:space:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__)'

# Pattern 15: statement (root).
rule.15.parent=-1
rule.15.group='statement'
rule.15.match='__(global|device|host|shared)__'

# Pattern 16: symbol.operator (root).
rule.16.parent=-1
rule.16.group='symbol.operator'
rule.16.match='[-+*/%=<>.:;,~&|^!?]|\b(sizeof|alignof|typeid|(and|or|xor|not)(_eq)?|bitor|compl|bitand|(const|dynamic|reinterpret|static)_cast)\b'

# Pattern 17: symbol.brackets (root).
rule.17.parent=-1
rule.17.group='symbol.brackets'
rule.17.match='[(){}]|\[|\]'

# Pattern 18: constant.number (root).
rule.18.parent=-1
rule.18.group='constant.number'
rule.18.match='(\b([1-9][0-9'']*|0[0-7'']*|0[Xx][0-9a-fA-F'']+|0[Bb][01]+)([Uu]?[Ll][Ll]?|[Ll][Ll]?[Uu]?)?\b)'

# Pattern 19: constant.number (root).
rule.19.parent=-1
rule.19.group='constant.number'
rule.19.match='(\b(([0-9'']*[.][0-9'']+|[0-9'']+[.][0-9'']*)([Ee][+-]?[0-9'']+)?|[0-9'']+[Ee][+-]?[0-9'']+)[FfLl]?\b)'

# Pattern 20: constant.number (root).
rule.20.parent=-1
rule.20.group='constant.number'
rule.20.match='(\b0[Xx]([0-9a-zA-Z'']*[.][0-9a-zA-Z'']+|[0-9a-zA-Z'']+[.][0-9a-zA-Z'']*)[Pp][+-]?[0-9'']+[FfLl]?\b)'

# Pattern 21: constant.bool (root).
rule.21.parent=-1
rule.21.group='constant.bool'
rule.21.match='(\b(true|false|NULL|nullptr)\b)'

# Region 22: constant.string (root).
rule.22.parent=-1
rule.22.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.22.start='"'
rule.22.end='"'
# Mask escaped text before matching delimiters.
rule.22.skip='\\.'

# Pattern 23: constant.specialChar (inside region 22).
rule.23.parent=22
rule.23.group='constant.specialChar'
rule.23.match='\\(["''abfnrtv\\]|[0-3]?[0-7]{1,2}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'

# Region 24: constant.string (root).
rule.24.parent=-1
rule.24.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.24.start=''''
rule.24.end=''''
# Mask escaped text before matching delimiters.
rule.24.skip='\\.'

# Pattern 25: error (inside region 24).
rule.25.parent=24
rule.25.group='error'
rule.25.match='..+'

# Pattern 26: constant.specialChar (inside region 24).
rule.26.parent=24
rule.26.group='constant.specialChar'
rule.26.match='\\(["''abfnrtv\\]|[0-3]?[0-7]{1,2}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'

# Region 27: comment (root).
rule.27.parent=-1
rule.27.group='comment'
# Start/end delimiters carry state between physical lines.
rule.27.start='//'
rule.27.end='$'

# Pattern 28: todo (inside region 27).
rule.28.parent=27
rule.28.group='todo'
rule.28.match='(TODO|XXX|FIXME):?'

# Region 29: comment (root).
rule.29.parent=-1
rule.29.group='comment'
# Start/end delimiters carry state between physical lines.
rule.29.start='/\*'
rule.29.end='\*/'

# Pattern 30: todo (inside region 29).
rule.30.parent=29
rule.30.group='todo'
rule.30.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=31
