# Syntax: kvlang
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='kvlang'

# Detection: filename first, then header and content signature.
detect.filename='\.kv$'

# Pattern 0: special (root).
rule.0.parent=-1
rule.0.group='special'
rule.0.match='\b[a-z].+'

# Pattern 1: identifier (root).
rule.1.parent=-1
rule.1.group='identifier'
rule.1.match='\b(self|app|root)\b'

# Pattern 2: type (root).
rule.2.parent=-1
rule.2.group='type'
rule.2.match='\b[A-Z].+'

# Pattern 3: type (root).
rule.3.parent=-1
rule.3.group='type'
rule.3.match='\b(AnchorLayout|BoxLayout|FloatLayout|RelativeLayout|GridLayout|PageLayout|StackLayout)\b'

# Pattern 4: type (root).
rule.4.parent=-1
rule.4.group='type'
rule.4.match='\b(canvas)\b'

# Pattern 5: identifier.function (root).
rule.5.parent=-1
rule.5.group='identifier.function'
rule.5.match='[a-zA-Z_0-9]+\('

# Pattern 6: type (root).
rule.6.parent=-1
rule.6.group='type'
rule.6.match='\b(abs|all|any|ascii|bin|bool|breakpoint|bytearray|bytes)\b'

# Pattern 7: type (root).
rule.7.parent=-1
rule.7.group='type'
rule.7.match='\b(callable|chr|classmethod|compile|copyright|credits|oct)\b'

# Pattern 8: type (root).
rule.8.parent=-1
rule.8.group='type'
rule.8.match='\b(delattr|dict|dir|display|divmod|enumerate|eval|filter)\b'

# Pattern 9: type (root).
rule.9.parent=-1
rule.9.group='type'
rule.9.match='\b(float|format|frozenset|get_ipython|getattr|globals|type)\b'

# Pattern 10: type (root).
rule.10.parent=-1
rule.10.group='type'
rule.10.match='\b(hash|help|hex|id|input|int|isinstance|issubclass|iter|len)\b'

# Pattern 11: type (root).
rule.11.parent=-1
rule.11.group='type'
rule.11.match='\b(license|list|locals|map|max|memoryview|min|next|object)\b'

# Pattern 12: type (root).
rule.12.parent=-1
rule.12.group='type'
rule.12.match='\b(open|ord|pow|print|property|range|repr|reversed|round|set)\b'

# Pattern 13: type (root).
rule.13.parent=-1
rule.13.group='type'
rule.13.match='\b(setattr|slice|sorted|staticmethod|hasattr|super|tuple|str)\b'

# Pattern 14: type (root).
rule.14.parent=-1
rule.14.group='type'
rule.14.match='\b(vars|zip|exec|sum|complex)\b'

# Pattern 15: statement.built_in (root).
rule.15.parent=-1
rule.15.group='statement.built_in'
rule.15.match='\b(and|as|assert|async|await|break|class|continue|def)\b'

# Pattern 16: statement.built_in (root).
rule.16.parent=-1
rule.16.group='statement.built_in'
rule.16.match='\b(del|elif|else|except|finally|for|from|global|if)\b'

# Pattern 17: statement.built_in (root).
rule.17.parent=-1
rule.17.group='statement.built_in'
rule.17.match='\b(import|in|is|lambda|nonlocal|not|or|pass|raise)\b'

# Pattern 18: statement.built_in (root).
rule.18.parent=-1
rule.18.group='statement.built_in'
rule.18.match='\b(return|try|while|with|yield|match|case)\b'

# Pattern 19: symbol.operator (root).
rule.19.parent=-1
rule.19.group='symbol.operator'
rule.19.match='([~^.:;,+*|=!\%]|<|>|/|-|&)'

# Pattern 20: symbol.brackets (root).
rule.20.parent=-1
rule.20.group='symbol.brackets'
rule.20.match='([(){}]|\[|\])'

# Pattern 21: constant.number (root).
rule.21.parent=-1
rule.21.group='constant.number'
rule.21.match='\b[0-9](_?[0-9])*(\.([0-9](_?[0-9])*)?)?(e[0-9](_?[0-9])*)?\b'

# Pattern 22: constant.number (root).
rule.22.parent=-1
rule.22.group='constant.number'
rule.22.match='\b0b(_?[01])+\b'

# Pattern 23: constant.number (root).
rule.23.parent=-1
rule.23.group='constant.number'
rule.23.match='\b0o(_?[0-7])+\b'

# Pattern 24: constant.number (root).
rule.24.parent=-1
rule.24.group='constant.number'
rule.24.match='\b0x(_?[0-9a-f])+\b'

# Pattern 25: constant.bool.none (root).
rule.25.parent=-1
rule.25.group='constant.bool.none'
rule.25.match='\b(None)\b'

# Pattern 26: constant.bool.true (root).
rule.26.parent=-1
rule.26.group='constant.bool.true'
rule.26.match='\b(True)\b'

# Pattern 27: constant.bool.false (root).
rule.27.parent=-1
rule.27.group='constant.bool.false'
rule.27.match='\b(False)\b'

# Region 28: constant.string (root).
rule.28.parent=-1
rule.28.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.28.start='"'
rule.28.end='("|$)'
# Mask escaped text before matching delimiters.
rule.28.skip='\\.'

# Region 29: constant.string (root).
rule.29.parent=-1
rule.29.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.29.start=''''
rule.29.end='(''|$)'
# Mask escaped text before matching delimiters.
rule.29.skip='\\.'

# Region 30: comment (root).
rule.30.parent=-1
rule.30.group='comment'
# Start/end delimiters carry state between physical lines.
rule.30.start='#'
rule.30.end='$'

# Total flattened rules; update this when adding or removing rules.
rules=31
