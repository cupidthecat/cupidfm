# Syntax: svelte
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='svelte'

# Detection: filename first, then header and content signature.
detect.filename='\.svelte$'

# Region 0: default (root).
rule.0.parent=-1
rule.0.group='default'
# Start/end delimiters carry state between physical lines.
rule.0.start='<script>'
rule.0.end='</script>'

# Included language: javascript. Local rules come first.

# Pattern 1: constant.number (inside region 0).
rule.1.parent=0
rule.1.group='constant.number'
rule.1.match='\b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b'

# Pattern 2: constant.number (inside region 0).
rule.2.parent=0
rule.2.group='constant.number'
rule.2.match='\b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?'

# Pattern 3: constant.number (inside region 0).
rule.3.parent=0
rule.3.group='constant.number'
rule.3.match='\b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?'

# Pattern 4: symbol.brackets (inside region 0).
rule.4.parent=0
rule.4.group='symbol.brackets'
rule.4.match='[(){}]|\[|\]'

# Pattern 5: symbol.operator (inside region 0).
rule.5.parent=0
rule.5.group='symbol.operator'
rule.5.match='([-+/*=<>!~%?:&|]|[.]{3})'

# Pattern 6: statement (inside region 0).
rule.6.parent=0
rule.6.group='statement'
rule.6.match='\b(async|await|break|case|catch|const|continue|debugger|default)\b'

# Pattern 7: statement (inside region 0).
rule.7.parent=0
rule.7.group='statement'
rule.7.match='\b(delete|do|else|export|finally|for|function\*?|class|extends)\b'

# Pattern 8: statement (inside region 0).
rule.8.parent=0
rule.8.group='statement'
rule.8.match='\b(get|if|import|from|in|of|instanceof|let|new|reject|resolve|return)\b'

# Pattern 9: statement (inside region 0).
rule.9.parent=0
rule.9.group='statement'
rule.9.match='\b(set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield)\b'

# Pattern 10: error (inside region 0).
rule.10.parent=0
rule.10.group='error'
rule.10.match='\b(enum|implements|interface|package|private|protected|public)\b'

# Pattern 11: constant (inside region 0).
rule.11.parent=0
rule.11.group='constant'
rule.11.match='\b(globalThis|Infinity|null|undefined|NaN)\b'

# Pattern 12: constant (inside region 0).
rule.12.parent=0
rule.12.group='constant'
rule.12.match='\b(null|undefined|NaN)\b'

# Pattern 13: constant (inside region 0).
rule.13.parent=0
rule.13.group='constant'
rule.13.match='\b(true|false)\b'

# Pattern 14: type (inside region 0).
rule.14.parent=0
rule.14.group='type'
rule.14.match='\b(Array|Boolean|Date|Enumerator|Error|Function|Generator|Map|Math)\b'

# Pattern 15: type (inside region 0).
rule.15.parent=0
rule.15.group='type'
rule.15.match='\b(Number|Object|Promise|Proxy|Reflect|RegExp|Set|String|Symbol|WeakMap|WeakSet)\b'

# Pattern 16: type (inside region 0).
rule.16.parent=0
rule.16.group='type'
rule.16.match='\b(BigInt64Array|BigUint64Array|Float32Array|Float64Array|Int16Array)\b'

# Pattern 17: constant (inside region 0).
rule.17.parent=0
rule.17.group='constant'
rule.17.match='\\[0-7][0-7]?[0-7]?|\\x[0-9a-fA-F]+|\\[bfnrt''"\?\\]'

# Pattern 18: comment (inside region 0).
rule.18.parent=0
rule.18.group='comment'
rule.18.match='^#!.*/(env +)?node( |$)'

# Pattern 19: identifier (inside region 0).
rule.19.parent=0
rule.19.group='identifier'
rule.19.match='\b(alert|decodeURI|decodeURIComponent|document|encodeURI|encodeURIComponent|escape|eval|isFinite|isNaN|parseFloat|parseInt|unescape|uneval|window)\b'

# Pattern 20: identifier (inside region 0).
rule.20.parent=0
rule.20.group='identifier'
rule.20.match='\b(Intl|WebAssembly)\b'

# Pattern 21: identifier (inside region 0).
rule.21.parent=0
rule.21.group='identifier'
rule.21.match='\b(Arguments)\b'

# Region 22: constant.string (inside region 0).
rule.22.parent=0
rule.22.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.22.start='"'
rule.22.end='"'
# Mask escaped text before matching delimiters.
rule.22.skip='\\.'

# Pattern 23: constant.specialChar (inside region 22).
rule.23.parent=22
rule.23.group='constant.specialChar'
rule.23.match='\\.'

# Region 24: constant.string (inside region 0).
rule.24.parent=0
rule.24.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.24.start=''''
rule.24.end=''''
# Mask escaped text before matching delimiters.
rule.24.skip='\\.'

# Pattern 25: constant.specialChar (inside region 24).
rule.25.parent=24
rule.25.group='constant.specialChar'
rule.25.match='\\.'

# Region 26: constant.string (inside region 0).
rule.26.parent=0
rule.26.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.26.start='`'
rule.26.end='`'

# Pattern 27: constant.specialChar (inside region 26).
rule.27.parent=26
rule.27.group='constant.specialChar'
rule.27.match='\\.'

# Pattern 28: identifier (inside region 26).
rule.28.parent=26
rule.28.group='identifier'
rule.28.match='\x24\{.*?\}'

# Pattern 29: constant.bool (inside region 0).
rule.29.parent=0
rule.29.group='constant.bool'
rule.29.match='\b(true|false)\b'

# Pattern 30: constant.bool.false (inside region 0).
rule.30.parent=0
rule.30.group='constant.bool.false'
rule.30.match='\b(false)\b'

# Pattern 31: constant.bool.true (inside region 0).
rule.31.parent=0
rule.31.group='constant.bool.true'
rule.31.match='\b(true)\b'

# Region 32: comment (inside region 0).
rule.32.parent=0
rule.32.group='comment'
# Start/end delimiters carry state between physical lines.
rule.32.start='//'
rule.32.end='$'

# Pattern 33: todo (inside region 32).
rule.33.parent=32
rule.33.group='todo'
rule.33.match='(TODO|XXX|FIXME)'

# Region 34: comment (inside region 0).
rule.34.parent=0
rule.34.group='comment'
# Start/end delimiters carry state between physical lines.
rule.34.start='/\*'
rule.34.end='\*/'
# Mask escaped text before matching delimiters.
rule.34.skip='\\.'

# Pattern 35: constant.specialChar (inside region 34).
rule.35.parent=34
