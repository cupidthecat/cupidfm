# Pattern 46: statement (inside region 38).
rule.46.parent=38
rule.46.group='statement'
rule.46.match='\b(new|of|package|private|protected|public|require|return|set|static|super|switch)\b'

# Pattern 47: statement (inside region 38).
rule.47.parent=38
