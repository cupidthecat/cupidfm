# Syntax: lisp
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='lisp'

# Detection: filename first, then header and content signature.
detect.filename='(emacs|zile)$|\.(el|li?sp|scm|ss|rkt)$'

# Pattern 0: default (root).
rule.0.parent=-1
rule.0.group='default'
rule.0.match='\([a-z-]+'

# Pattern 1: symbol (root).
rule.1.parent=-1
rule.1.group='symbol'
rule.1.match='\(([\-+*/<>]|<=|>=)|'''

# Pattern 2: constant.number (root).
rule.2.parent=-1
rule.2.group='constant.number'
rule.2.match='\b[0-9]+b>'

# Pattern 3: special (root).
rule.3.parent=-1
rule.3.group='special'
rule.3.match='\bnil\b'

# Pattern 4: preproc (root).
rule.4.parent=-1
rule.4.group='preproc'
rule.4.match='\b[tT]b>'

# Pattern 5: constant.string (root).
rule.5.parent=-1
rule.5.group='constant.string'
rule.5.match='\"(\\.|[^"])*\"'

# Pattern 6: constant.specialChar (root).
rule.6.parent=-1
rule.6.group='constant.specialChar'
rule.6.match='''[A-Za-z][A-Za-z0-9_-]+'

# Pattern 7: constant.specialChar (root).
rule.7.parent=-1
rule.7.group='constant.specialChar'
rule.7.match='\\.?'

# Pattern 8: comment (root).
rule.8.parent=-1
rule.8.group='comment'
rule.8.match='(^|[[:space:]]);.*'

# Pattern 9: indent-char.whitespace (root).
rule.9.parent=-1
rule.9.group='indent-char.whitespace'
rule.9.match='[[:space:]]+$'

# Pattern 10: indent-char (root).
rule.10.parent=-1
rule.10.group='indent-char'
rule.10.match='	+ +| +	+'

# Total flattened rules; update this when adding or removing rules.
rules=11
