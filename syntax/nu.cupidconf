# Pattern 59: statement (root).
rule.59.parent=-1
rule.59.group='statement'
rule.59.match='\b(str to-datetime|str to-decimal|str to-int|str trim|str upcase)\b'

# Pattern 60: statement (root).
rule.60.parent=-1
rule.60.group='statement'
rule.60.match='\b(str-lengths|str-slice|strftime|str|sum|sys|table)\b'

# Pattern 61: statement (root).
rule.61.parent=-1
rule.61.group='statement'
rule.61.match='\b(take until|take while|take|term size|to csv)\b'

# Pattern 62: statement (root).
rule.62.parent=-1
rule.62.group='statement'
rule.62.match='\b(to html|to json|to md|to nuon|to text|to toml|to tsv)\b'

# Pattern 63: statement (root).
rule.63.parent=-1
rule.63.group='statement'
rule.63.match='\b(to url|to xml|to yaml|to-csv|to-df|to-dummies|to-lazy)\b'

# Pattern 64: statement (root).
rule.64.parent=-1
rule.64.group='statement'
rule.64.match='\b(to-lowercase|to-nu|to-parquet|to-uppercase|touch|to)\b'

# Pattern 65: statement (root).
rule.65.parent=-1
rule.65.group='statement'
rule.65.match='\b(transpose|tutor|unalias|uniq|unique|update|update cells)\b'

# Pattern 66: statement (root).
rule.66.parent=-1
rule.66.group='statement'
rule.66.match='\b(upsert|url host|url path|url query|url scheme|url)\b'

# Pattern 67: statement (root).
rule.67.parent=-1
rule.67.group='statement'
rule.67.match='\b(use|value-counts|var|version|view-source|watch)\b'

# Pattern 68: statement (root).
rule.68.parent=-1
rule.68.group='statement'
rule.68.match='\b(when|where|which|window|with-column|with-env|wrap)\b'

# Pattern 69: constant (root).
rule.69.parent=-1
rule.69.group='constant'
rule.69.match='\b(false|true)\b'

# Pattern 70: constant.number (root).
rule.70.parent=-1
rule.70.group='constant.number'
rule.70.match='\b[-+]?([1-9][0-9])*\b'

# Pattern 71: constant.number (root).
rule.71.parent=-1
rule.71.group='constant.number'
rule.71.match='\b[-+]?(0(x|b|o)\[[0-9a-fA-F ]+\])'

# Pattern 72: constant.number (root).
rule.72.parent=-1
rule.72.group='constant.number'
rule.72.match='\b[-+]?([0-9]+[BbMmGgTtPp][i]?[Bb]?)?\b'

# Pattern 73: constant.number (root).
rule.73.parent=-1
rule.73.group='constant.number'
rule.73.match='\b[-+]?([0-9]+[num]?[s])?\b'

# Pattern 74: constant.number (root).
rule.74.parent=-1
rule.74.group='constant.number'
rule.74.match='\b[-+]?([0-9]+(sec|min|hr|day|wk))?\b'

# Pattern 75: constant.number (root).
rule.75.parent=-1
rule.75.group='constant.number'
rule.75.match='\b([0-9]+[-][0-9]+[-][0-9]+([T][0-9]+[:][0-9]+[:][0-9]+)?([\+][0-9]+[:][0-9]+)?)\b'

# Pattern 76: constant.number (root).
rule.76.parent=-1
rule.76.group='constant.number'
rule.76.match='([0-9]+(\.\.)[0-9]+)?'

# Pattern 77: constant.number (root).
rule.77.parent=-1
rule.77.group='constant.number'
rule.77.match='((\.\.)[0-9]+)?'

# Pattern 78: constant.number (root).
rule.78.parent=-1
rule.78.group='constant.number'
rule.78.match='([0-9]+(\.\.))?'

# Region 79: comment (root).
rule.79.parent=-1
rule.79.group='comment'
# Start/end delimiters carry state between physical lines.
rule.79.start='#'
rule.79.end='$'

# Pattern 80: todo (inside region 79).
rule.80.parent=79
rule.80.group='todo'
rule.80.match='(FIXME|TODO|NOTE):?'

# Region 81: constant.string (root).
rule.81.parent=-1
rule.81.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.81.start='"'
rule.81.end='"'
# Mask escaped text before matching delimiters.
rule.81.skip='\\.'

# Pattern 82: constant.specialChar (inside region 81).
rule.82.parent=81
rule.82.group='constant.specialChar'
rule.82.match='\\.'

# Region 83: constant.string (root).
rule.83.parent=-1
rule.83.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.83.start=''''
rule.83.end=''''
# Mask escaped text before matching delimiters.
rule.83.skip='\\.'

# Pattern 84: constant.specialChar (inside region 83).
rule.84.parent=83
rule.84.group='constant.specialChar'
rule.84.match='\\.'

# Total flattened rules; update this when adding or removing rules.
rules=85
