# Syntax: git-rebase-todo
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='git-rebase-todo'

# Detection: filename first, then header and content signature.
detect.filename='^(.*[\\/])?git\-rebase\-todo$'

# Pattern 0: statement (root).
rule.0.parent=-1
rule.0.group='statement'
rule.0.match='^(p(ick)?|r(eword)?|e(dit)?|s(quash)?|f(ixup)?|x|exec|b(reak)?|d(rop)?|l(abel)?|t|reset|m(erge)?)\b'

# Pattern 1: identifier (root).
rule.1.parent=-1
rule.1.group='identifier'
rule.1.match='\b([0-9a-fA-F]{7,40})\b'

# Pattern 2: type.keyword (root).
rule.2.parent=-1
rule.2.group='type.keyword'
rule.2.match='\b(?i)((fix(es|ed)?|close(s|d)?) #[0-9]+)\b'

# Region 3: comment.line (root).
rule.3.parent=-1
rule.3.group='comment.line'
# Start/end delimiters carry state between physical lines.
rule.3.start='^#'
rule.3.end='$'

# Total flattened rules; update this when adding or removing rules.
rules=4
