# Syntax: jsonnet
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='jsonnet'

# Detection: filename first, then header and content signature.
detect.filename='\.(jsonnet|libsonnet)$'

# Pattern 0: constant (root).
rule.0.parent=-1
rule.0.group='constant'
rule.0.match='\b(self|\$|super)\b'

# Pattern 1: constant.bool (root).
rule.1.parent=-1
rule.1.group='constant.bool'
rule.1.match='\b(null|true|false)\b'

# Pattern 2: identifier (root).
rule.2.parent=-1
rule.2.group='identifier'
rule.2.match='\bstd\.(extVar|thisFile|type|length|objectHas|objectFields|objectHasAll|objectFieldsAll|prune|mapWithKey|abs|sign|max|min|pow|exp|log|exponent|mantissa|floor|ceil|sqrt|sin|cos|tan|asin|acos|atan|mod|assertEqual|toString|codepoint|char|substr|findSubstr|startsWith|endsWith|split|splitLimit|strReplace|asciiUpper|asciiLower|stringChars|format|escapeStringDollars|escapeStringPython|parseInt|parseOctal|parseHex|parseJson|encodeUTF8|decodeUTF8|manifestIni|manifestPython|manifestPythonVars|manifestJsonEx|manifestYamlDoc|manifestYamlStream|manifestXmlJsonml|makeArray|count|find|map|mapWithIndex|filterMap|filter|foldl|foldr|range|join|lines|flattenArrays|sort|uniq|set|setInter|setUnion|setDiff|setMember|base64|base64DecodeBytes|base64Decode|md5|mergePatch|trace)\b'

# Pattern 3: type (root).
rule.3.parent=-1
rule.3.group='type'
rule.3.match='[_a-zA-Z][_a-zA-Z0-9]*\s*:'

# Pattern 4: statement (root).
rule.4.parent=-1
rule.4.group='statement'
rule.4.match=':'

# Pattern 5: statement (root).
rule.5.parent=-1
rule.5.group='statement'
rule.5.match='\b(assert|else|error|for|function|if|import|importstr|importbin|in|local|tailstrict|then)\b'

# Pattern 6: symbol.operator (root).
rule.6.parent=-1
rule.6.group='symbol.operator'
rule.6.match='([.;,+*|=!\%]|<|>|/|-|&)'

# Pattern 7: symbol.brackets (root).
rule.7.parent=-1
rule.7.group='symbol.brackets'
rule.7.match='([(){}]|\[|\])'

# Pattern 8: constant.number (root).
rule.8.parent=-1
rule.8.group='constant.number'
rule.8.match='\b(0|([1-9][0-9]*))(\.[0-9]+)?([eE][\+-]?[0-9]+)?\b'

# Region 9: constant.string (root).
rule.9.parent=-1
rule.9.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.9.start='"'
rule.9.end='"'
# Mask escaped text before matching delimiters.
rule.9.skip='\\"'

# Pattern 10: constant.specialChar (inside region 9).
rule.10.parent=9
rule.10.group='constant.specialChar'
rule.10.match='\\u[0-9a-fA-F]{4}|\\[bfnrt''"/\\]'

# Region 11: constant.string (root).
rule.11.parent=-1
rule.11.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.11.start=''''
rule.11.end=''''
# Mask escaped text before matching delimiters.
rule.11.skip='\\'''

# Pattern 12: constant.specialChar (inside region 11).
rule.12.parent=11
rule.12.group='constant.specialChar'
rule.12.match='\\u[0-9a-fA-F]{4}|\\[bfnrt''"/\\]'

# Region 13: constant.string (root).
rule.13.parent=-1
rule.13.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.13.start='@"'
rule.13.end='"'
# Mask escaped text before matching delimiters.
rule.13.skip='\\"'

# Pattern 14: constant.specialChar (inside region 13).
rule.14.parent=13
rule.14.group='constant.specialChar'
rule.14.match='\\"'

# Region 15: constant.string (root).
rule.15.parent=-1
rule.15.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.15.start='@'''
rule.15.end=''''
# Mask escaped text before matching delimiters.
rule.15.skip='\\'''

# Pattern 16: constant.specialChar (inside region 15).
rule.16.parent=15
rule.16.group='constant.specialChar'
rule.16.match='\\'''

# Region 17: constant.string (root).
rule.17.parent=-1
rule.17.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.17.start='\|\|\| *$'
rule.17.end='^ *\|\|\|'

# Region 18: comment (root).
rule.18.parent=-1
rule.18.group='comment'
# Start/end delimiters carry state between physical lines.
rule.18.start='/\*'
rule.18.end='\*/'

# Pattern 19: todo (inside region 18).
rule.19.parent=18
rule.19.group='todo'
rule.19.match='(TODO|XXX|FIXME):?'

# Region 20: comment (root).
rule.20.parent=-1
rule.20.group='comment'
# Start/end delimiters carry state between physical lines.
rule.20.start='#|(//)'
rule.20.end='$'

# Pattern 21: todo (inside region 20).
rule.21.parent=20
rule.21.group='todo'
rule.21.match='(TODO|XXX|FIXME):?'

# Total flattened rules; update this when adding or removing rules.
rules=22
