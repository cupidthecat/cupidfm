# Syntax: smalltalk
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='smalltalk'

# Detection: filename first, then header and content signature.
detect.filename='\.(st|sources|changes)$'

# Pattern 0: statement (root).
rule.0.parent=-1
rule.0.group='statement'
rule.0.match='\b(self|nil|true|false|ifTrue|ifFalse|whileTrue|whileFalse)\b'

# Pattern 1: constant (root).
rule.1.parent=-1
rule.1.group='constant'
rule.1.match='(\$|@|@@)?\b[A-Z]+[0-9A-Z_a-z]*'

# Pattern 2: constant.number (root).
rule.2.parent=-1
rule.2.group='constant.number'
rule.2.match='(?i)\b0x[0-9a-fA-F][0-9a-f_]*\b'

# Pattern 3: constant.number (root).
rule.3.parent=-1
rule.3.group='constant.number'
rule.3.match='(?i)\b0b[01][01_]*\b'

# Pattern 4: constant.number (root).
rule.4.parent=-1
rule.4.group='constant.number'
rule.4.match='(?i)\b[0-9][0-9_]*([''.''][0-9_]+)?(e[\-]?[0-9_]+)?\b'

# Pattern 5: constant (root).
rule.5.parent=-1
rule.5.group='constant'
rule.5.match='(i?)([ 	]|^):[0-9A-Z_]+\b'

# Pattern 6: constant (root).
rule.6.parent=-1
rule.6.group='constant'
rule.6.match='\b(__FILE__|__LINE__)\b'

# Pattern 7: constant (root).
rule.7.parent=-1
rule.7.group='constant'
rule.7.match='/([^/]|(\\/))*/[iomx]*|%r\{([^}]|(\\}))*\}[iomx]*'

# Region 8: constant.string (root).
rule.8.parent=-1
rule.8.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.8.start=''''
rule.8.end=''''
# Mask escaped text before matching delimiters.
rule.8.skip='\\.'

# Region 9: constant.string (root).
rule.9.parent=-1
rule.9.group='constant.string'
# Start/end delimiters carry state between physical lines.
rule.9.start='"'
rule.9.end='"'
# Mask escaped text before matching delimiters.
rule.9.skip='\\.'

# Region 10: symbol.brackets (inside region 9).
rule.10.parent=9
rule.10.group='symbol.brackets'
# Start/end delimiters carry state between physical lines.
rule.10.start='#\{'
rule.10.end='\}'

# Pattern 11: default (inside region 10).
rule.11.parent=10
rule.11.group='default'
rule.11.match='.*'

# Region 12: constant.string.exec (root).
rule.12.parent=-1
rule.12.group='constant.string.exec'
# Start/end delimiters carry state between physical lines.
rule.12.start='`'
rule.12.end='`'
# Mask escaped text before matching delimiters.
rule.12.skip='\\.'

# Region 13: symbol.brackets (inside region 12).
rule.13.parent=12
rule.13.group='symbol.brackets'
# Start/end delimiters carry state between physical lines.
rule.13.start='#\{'
rule.13.end='\}'

# Pattern 14: default (inside region 13).
rule.14.parent=13
rule.14.group='default'
rule.14.match='.*'

# Pattern 15: constant.string (root).
rule.15.parent=-1
rule.15.group='constant.string'
rule.15.match='%[QW]?\{[^}]*\}|%[QW]?\([^)]*\)|%[QW]?<[^>]*>|%[QW]?\[[^]]*\]|%[QW]?\$[^$]*\$|%[QW]?\^[^^]*\^|%[QW]?![^!]*!'

# Pattern 16: constant.string (root).
rule.16.parent=-1
rule.16.group='constant.string'
rule.16.match='%[qw]\{[^}]*\}|%[qw]\([^)]*\)|%[qw]<[^>]*>|%[qw]\[[^]]*\]|%[qw]\$[^$]*\$|%[qw]\^[^^]*\^|%[qw]![^!]*!'

# Pattern 17: constant.string.exec (root).
rule.17.parent=-1
rule.17.group='constant.string.exec'
rule.17.match='%[x]\{[^}]*\}|%[x]\([^)]*\)|%[x]<[^>]*>|%[x]\[[^]]*\]|%[x]\$[^$]*\$|%[x]\^[^^]*\^|%[x]![^!]*!'

# Pattern 18: symbol.operator (root).
rule.18.parent=-1
rule.18.group='symbol.operator'
rule.18.match='[-+/*=<>!~%&|^]|\b:'

# Pattern 19: symbol.brackets (root).
rule.19.parent=-1
rule.19.group='symbol.brackets'
rule.19.match='([(){}]|\[|\])'

# Region 20: constant.macro (root).
rule.20.parent=-1
rule.20.group='constant.macro'
# Start/end delimiters carry state between physical lines.
rule.20.start='<<-?''?EOT''?'
rule.20.end='^EOT'

# Pattern 21: preproc.shebang (root).
rule.21.parent=-1
rule.21.group='preproc.shebang'
rule.21.match='^#!.+?( |$)'

# Total flattened rules; update this when adding or removing rules.
rules=22
