# Syntax: nanorc
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='nanorc'

# Detection: filename first, then header and content signature.
detect.filename='\.?nanorc$'

# Pattern 0: default (root).
rule.0.parent=-1
rule.0.group='default'
rule.0.match='(?i)^[[:space:]]*((un)?set|include|syntax|i?color).*$'

# Pattern 1: type (root).
rule.1.parent=-1
rule.1.group='type'
rule.1.match='(?i)^[[:space:]]*(set|unset)[[:space:]]+(autoindent|backup|backupdir|backwards|boldtext|brackets|casesensitive|const|cut|fill|historylog|matchbrackets|morespace|mouse|multibuffer|noconvert|nofollow|nohelp|nonewlines|nowrap|operatingdir|preserve|punct)\>|^[[:space:]]*(set|unset)[[:space:]]+(quickblank|quotestr|rebinddelete|rebindkeypad|regexp|smarthome|smooth|speller|suspend|tabsize|tabstospaces|tempfile|undo|view|whitespace|wordbounds)\b'

# Pattern 2: preproc (root).
rule.2.parent=-1
rule.2.group='preproc'
rule.2.match='(?i)^[[:space:]]*(set|unset|include|syntax|header)\b'

# Pattern 3: constant.bool.true (root).
rule.3.parent=-1
rule.3.group='constant.bool.true'
rule.3.match='(?i)(set)\b'

# Pattern 4: constant.bool.false (root).
rule.4.parent=-1
rule.4.group='constant.bool.false'
rule.4.match='(?i)(unset)\b'

# Pattern 5: identifier (root).
rule.5.parent=-1
rule.5.group='identifier'
rule.5.match='(?i)^[[:space:]]*(i)?color[[:space:]]*(bright)?(white|black|red|blue|green|yellow|magenta|cyan)?(,(white|black|red|blue|green|yellow|magenta|cyan))?\b'

# Pattern 6: special (root).
rule.6.parent=-1
rule.6.group='special'
rule.6.match='(?i)^[[:space:]]*(i)?color\b|\b(start|end)='

# Pattern 7: constant.string (root).
rule.7.parent=-1
rule.7.group='constant.string'
rule.7.match='"(\\.|[^"])*"'

# Pattern 8: comment (root).
rule.8.parent=-1
rule.8.group='comment'
rule.8.match='^[[:space:]]*#.*$'

# Pattern 9: comment.bright (root).
rule.9.parent=-1
rule.9.group='comment.bright'
rule.9.match='^[[:space:]]*##.*$'

# Total flattened rules; update this when adding or removing rules.
rules=10
