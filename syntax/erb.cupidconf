# Syntax: erb
# Regex values are literal: backslashes, #, and ; are preserved.
# Double a single quote inside a quoted value to write one quote.
# Rule numbers preserve precedence; later patterns override earlier ones.

format=2
name='erb'

# Detection: filename first, then header and content signature.
detect.filename='\.erb$|\.rhtml$'

# Pattern 0: error (root).
rule.0.parent=-1
rule.0.group='error'
rule.0.match='<[^!].*?>'

# Pattern 1: symbol.tag (root).
rule.1.parent=-1
rule.1.group='symbol.tag'
rule.1.match='(?i)<[/]?(a(bbr|cronym|ddress|pplet|rea|rticle|side|udio)?|b(ase(font)?|d(i|o)|ig|lockquote|r)?|ca(nvas|ption)|center|cite|co(de|l|lgroup)|d(ata(list)?|d|el|etails|fn|ialog|ir|l|t)|em(bed)?|fieldset|fig(caption|ure)|font|form|(i)?frame|frameset|h[1-6]|hr|i|img|in(put|s)|kbd|keygen|label|legend|li(nk)?|ma(in|p|rk)|menu(item)?|met(a|er)|nav|no(frames|script)|o(l|pt(group|ion)|utput)|p(aram|icture|re|rogress)?|q|r(p|t|uby)|s(trike)?|samp|se(ction|lect)|small|source|span|strong|su(b|p|mmary)|textarea|time|track|u(l)?|var|video|wbr)( .*|>)*?>'

# Pattern 2: symbol.tag.extended (root).
rule.2.parent=-1
rule.2.group='symbol.tag.extended'
rule.2.match='(?i)<[/]?(body|div|html|head(er)?|footer|title|table|t(body|d|h(ead)?|r|foot))( .*|>)*?>'

# Pattern 3: preproc (root).
rule.3.parent=-1
rule.3.group='preproc'
rule.3.match='(?i)<[/]?(script|style)( .*|>)*?>'

# Pattern 4: special (root).
rule.4.parent=-1
rule.4.group='special'
rule.4.match='&[^;[[:space:]]]*;'

# Pattern 5: symbol (root).
rule.5.parent=-1
rule.5.group='symbol'
rule.5.match='[:=]'

# Pattern 6: identifier (root).
rule.6.parent=-1
rule.6.group='identifier'
rule.6.match='(alt|bgcolor|height|href|id|label|longdesc|name|onclick|onfocus|onload|onmouseover|size|span|src|style|target|type|value|width)='

# Pattern 7: constant.string (root).
rule.7.parent=-1
rule.7.group='constant.string'
rule.7.match='"[^"]*"'

# Pattern 8: constant.number (root).
rule.8.parent=-1
rule.8.group='constant.number'
rule.8.match='(?i)#[0-9a-fA-F]{6,6}'

# Pattern 9: constant.string.url (root).
rule.9.parent=-1
rule.9.group='constant.string.url'
rule.9.match='(ftp(s)?|http(s)?|git|chrome)://[^ 	]+'

# Pattern 10: comment (root).
rule.10.parent=-1
rule.10.group='comment'
rule.10.match='<!--.+?-->'

# Pattern 11: preproc (root).
rule.11.parent=-1
rule.11.group='preproc'
rule.11.match='<!DOCTYPE.+?>'

# Region 12: default (root).
rule.12.parent=-1
rule.12.group='default'
# Start/end delimiters carry state between physical lines.
rule.12.start='<%'
rule.12.end='%>'

# Pattern 13: preproc (root).
rule.13.parent=-1
rule.13.group='preproc'
rule.13.match='<%|%>'

# Pattern 14: red (root).
rule.14.parent=-1
rule.14.group='red'
rule.14.match='&[^;[[:space:]]]*;'

# Pattern 15: statement (root).
rule.15.parent=-1
rule.15.group='statement'
rule.15.match='\b(BEGIN|END|alias|and|begin|break|case|class|def|defined\?|do|else|elsif|end|ensure|false|for|if|in|module|next|nil|not|or|redo|rescue|retry|return|self|super|then|true|undef|unless|until|when|while|yield)\b'

# Pattern 16: identifier.var (root).
rule.16.parent=-1
rule.16.group='identifier.var'
rule.16.match='(\$|@|@@)?\b[A-Z]+[0-9A-Z_a-z]*'

# Pattern 17: magenta (root).
rule.17.parent=-1
rule.17.group='magenta'
rule.17.match='(?i)([  ]|^):[0-9A-Z_]+\b'

# Pattern 18: identifier.macro (root).
rule.18.parent=-1
rule.18.group='identifier.macro'
rule.18.match='\b(__FILE__|__LINE__)\b'

# Pattern 19: brightmagenta (root).
rule.19.parent=-1
rule.19.group='brightmagenta'
rule.19.match='!/([^/]|(\\/))*/[iomx]*|%r\{([^}]|(\\}))*\}[iomx]*'

# Pattern 20: brightblue (root).
rule.20.parent=-1
rule.20.group='brightblue'
rule.20.match='`[^`]*`|%x\{[^}]*\}'

# Pattern 21: constant.string (root).
rule.21.parent=-1
rule.21.group='constant.string'
rule.21.match='"([^"]|(\\"))*"|%[QW]?\{[^}]*\}|%[QW]?\([^)]*\)|%[QW]?<[^>]*>|%[QW]?\[[^]]*\]|%[QW]?\$[^$]*\$|%[QW]?\^[^^]*\^|%[QW]?![^!]*!'

# Pattern 22: brightgreen (root).
rule.22.parent=-1
rule.22.group='brightgreen'
rule.22.match='#\{[^}]*\}'

# Pattern 23: green (root).
rule.23.parent=-1
rule.23.group='green'
rule.23.match='''([^'']|(\\''))*''|%[qw]\{[^}]*\}|%[qw]\([^)]*\)|%[qw]<[^>]*>|%[qw]\[[^]]*\]|%[qw]\$[^$]*\$|%[qw]\^[^^]*\^|%[qw]![^!]*!'

# Pattern 24: comment (root).
rule.24.parent=-1
rule.24.group='comment'
rule.24.match='#[^{].*$|#$'

# Pattern 25: comment.bright (root).
rule.25.parent=-1
rule.25.group='comment.bright'
rule.25.match='##[^{].*$|##$'

# Region 26: identifier.macro (root).
rule.26.parent=-1
rule.26.group='identifier.macro'
# Start/end delimiters carry state between physical lines.
rule.26.start='<<-?''?EOT''?'
rule.26.end='^EOT'

# Pattern 27: todo (root).
rule.27.parent=-1
rule.27.group='todo'
rule.27.match='(XXX|TODO|FIXME|\?\?\?)'

# Total flattened rules; update this when adding or removing rules.
rules=28
